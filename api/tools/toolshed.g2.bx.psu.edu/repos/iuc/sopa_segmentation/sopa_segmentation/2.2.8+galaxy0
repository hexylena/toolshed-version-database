 "-1", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "mode", "argument": "--mode", "type": "select", "label": "Tissue segmentation mode", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "staining", "options": [["staining", "staining", false], ["saturation (for H&E images)", "saturation", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "expand_radius_ratio", "argument": "--expand-radius-ratio", "type": "float", "label": "The ratio of the radius of the polygons that will be expanded.", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.05", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "channel", "argument": "--channel", "type": "text", "label": "Channel", "help": "The channel to use for the staining mode. If None, the maximum value of all channels is used.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "clip_parameters", "argument": "--clip-parameters", "type": "text", "label": "Clip parameters", "help": "Parameters used to get the threshold used to clip the image before converting it to an 8-bit image (only used in 'staining' mode). The first parameter is the quantile, and the second is the divisor. By default, the threshold is the 90th quantile divided by 5.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "0.9,5", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "blur_kernel_size", "argument": "--blur-kernel-size", "type": "integer", "label": "The kernel size of the median blurring operation", "help": "", "