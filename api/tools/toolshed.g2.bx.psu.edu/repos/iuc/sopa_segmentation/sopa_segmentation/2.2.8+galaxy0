amic": false, "value": "cellpose", "options": [["Cellpose - This can be done on all patches directly, or on one individual patch.", "cellpose", true], ["Stardist - This can be done on all patches directly, or on one individual patch.", "stardist", false], ["Comseg - This can be done on all patches directly, or on one individual patch.", "comseg", false], ["Baysor - This can be done on all patches directly, or on one individual patch.", "baysor", false], ["Proseg - This needs to be done on a single patch as proseg is fast enough and doesn't require parallelization.", "proseg", false], ["Tissue - This can be done only on objects with H&E staining", "tissue", false]], "display": null, "multiple": false, "textable": false}}], "outputs": [{"model_class": "ToolOutput", "name": "output_sdata", "format": "spatialdata.zip", "label": "${tool.name} on ${on_string}: SpatialData", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "sdata_output.spatialdata.zip", "edam_format": "format_2333", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "single-cell", "panel_section_name": "Single-cell", "form_style": "regular"}