 "mask", "inputs": [{"model_class": "IntegerToolParameter", "name": "mask_window_size", "argument": "--mask_window_size", "type": "integer", "label": "Masking window size", "help": "The size of the sliding window used to evaluate the mean quality for N masking (5~1000000). Default is 50.", "help_format": "html", "refresh_on_change": false, "min": 5, "max": 1000000, "optional": false, "hidden": false, "is_dynamic": false, "value": "50", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "mask_mean_quality", "argument": "--mask_mean_quality", "type": "integer", "label": "Masking mean quality", "help": "The mean quality requirement for the sliding window used for N masking (5~30). Default is 10 (Q10).", "help_format": "html", "refresh_on_change": false, "min": 5, "max": 30, "optional": false, "hidden": false, "is_dynamic": false, "value": "10", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "break", "inputs": [{"model_class": "IntegerToolParameter", "name": "break_window_size", "argument": "--break_window_size", "type": "integer", "label": "Breaking window size", "help": "The size of the sliding window used to evaluate the mean quality for read breaking (5~1000000). Default is 100.", "help_format": "html", "refresh_on_change": false, "min": 5, "max": 1000000, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "break_mean_quality", "argument": "--break_mean_quality", "type": "integer", "label": "Breaking mean quality", "help": "The mean quality requirement for the sliding window used for read breaking (5~30). Default is 10 (Q10).", "help_format": "html", "refresh_on_change": false, "min": 5, "max": 30, "optional": false, "hidden": false, "is_dynamic": false, "value": "10", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "best_segment", "inputs": [{"model_class": "IntegerToolParameter", "name": "best_read_segment_window_size", "argument": "--best_read_segment_window_size", "type": "integer", "label": "Best segment window size", "help": "The size of the sliding window used by best-read-segment mode (5~1000000). Default is 100.", "help_format": "html", "refresh_on_change": false, "min": 5, "max": 1000000, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "best_read_segment_mean_quality", "argument": "--best_read_segment_mean_quality", "type": "integer", "label": "Best segment mean quality", "help": "The mean quality requirement for best-read-segment mode (5~30). Default is 10 (Q10).", "help_format": "html", "refresh_on_change": false, "min": 5, "max": 30, "optional": false, "hidden": false, "is_dynamic": false, "value": "10", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "mode", "argument": null, "type": "select", "label": "Low quality region handling", "help": "Three alternative strategies for dealing with internal low quality regions, detected with a sliding window. They are mutually exclusive.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["None", "none", true], ["Mask low quality regions with N", "mask", false], ["Break reads, discarding the low quality regions", "break", false], ["Keep only the best high quality segment of each read", "best_segment", false]], "display": null, "multiple": false, "textable": false}}]}]}, {"model_class": "Section", "name": "sampling_options", "type": "section", "title": "Read sampling and selection", "help": null, "expanded": false, "inputs": [{"model_class": "Conditional", "name": "select_mode", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "none", "inputs": []}, {"model_class": "ConditionalWhen", "value": "target_bases", "inputs": [{"model_class": "IntegerToolParameter", "name": "target_bases", "argument": "--target_bases", "type": "integer", "label": "Target bases", "help": "Approximately target this number of bases to output after filtering. The input is read twice.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1000000", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "sample_rate", "inputs": [{"model_class": "FloatToolParameter", "name": "sample_rate", "argument": "--sample_rate", "type": "float", "label": "Sample rate", "help": "Randomly keep this fraction of reads after filtering (0.0~1.0).", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "seed", "argument": "--seed", "type": "integer", "label": "Random seed", "help": "Seed for reproducible output sampling. Default is 1.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "best_reads", "inputs": [{"model_class": "IntegerToolParameter", "name": "best_reads", "argument": "--best_reads", "type": "integer", "label": "Number of best reads", "help": "Keep the best N reads by mean quality after filtering. The input is read twice.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1000", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "best_bases", "inputs": [{"model_class": "IntegerToolParameter", "name": "best_bases", "argument": "--best_bases", "type": "integer", "label": "Best bases", "help": "Keep the best reads by mean quality until this many bases are selected after filtering. The input is read twice.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1000000", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "mode", "argument": null, "type": "select", "label": "Sampling / selection mode", "help": "These modes are mutually exclusive and are applied after all filtering. Target bases, best reads and best bases all read the input twice.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["No sampling - keep all reads passing the filters", "none", true], ["Approximately target a number of output bases", "target_bases", false], ["Randomly keep a fraction of the reads", "sample_rate", false], ["Keep the best N reads by mean quality", "best_reads", false], ["Keep the best reads up to N bases", "best_bases", false]], "display": null, "multiple": false, "textable": false}}]}, {"model_class": "Section", "name": "output_options", "type": "section", "title": "Output Options", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "report_html", "argument": null, "type": "boolean", "label": "Output HTML report", "help": "Fastplong provides a QC report for the data before and after filtering within a single HTML page, which enables comparison of the quality statistics changed by the preprocessing step directly", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "True", "falsevalue": "False"}, {"model_class": "BooleanToolParameter", "name": "report_json", "argument": null, "type": "boolean", "label": "Output JSON report", "help": "The JSON report contains all the data visualized in the HTML report. The format of the JSON report is manually optimized to be easily readable by humans and is compatible with MultiQC", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "True", "falsevalue": "False"}, {"model_class": "BooleanToolParameter", "name": "failed_out", "argument": "--failed_out", "type": "boolean", "label": "Save failed reads?", "help": "Enable this to write failed reads to a separate FASTQ file.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--failed_out", "falsevalue": ""}, {"model_class": "IntegerToolParameter", "name": "compression", "argument": "--compression", "type": "integer", "label": "Compression level", "help": "Compression level for gzip output (1~9). 1 is fastest, 9 is smallest. Only applied when the input, and therefore the output, is gzipped. Default is 4.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 9, "optional": false, "hidden": false, "is_dynamic": false, "value": "4", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "out", "format": "data", "label": "${tool.name} on ${on_string}: Reads FASTQ output", "hidden": false, "output_type": "data", "format_source": "in", "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_1915", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "report_html", "format": "html", "label": "${tool.name} on ${on_string}: HTML report", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "fastplong.html", "edam_format": "format_2331", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "report_json", "format": "json", "label": "${tool.name} on ${on_string}: JSON report", "hidden": false, "output_t