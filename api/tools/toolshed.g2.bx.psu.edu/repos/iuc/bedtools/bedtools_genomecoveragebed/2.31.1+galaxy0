"Input type", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "bed", "options": [["BED/bedGraph/GFF/VCF/EncodePeak", "bed", false], ["BAM", "bam", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Conditional", "name": "report", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "bg", "inputs": [{"model_class": "BooleanToolParameter", "name": "zero_regions", "argument": "-bga", "type": "boolean", "label": "Report regions with zero coverage", "help": "If set, regions without any coverage will also be reported", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-bga", "falsevalue": ""}, {"model_class": "FloatToolParameter", "name": "scale", "argument": "-scale", "type": "float", "label": "Scale the coverage by a constant factor", "help": "Each bedGraph coverage value is multiplied by this factor before being reported. Useful for normalizing coverage by, e.g., reads per million (RPM).", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "hist", "inputs": [{"model_class": "IntegerToolParameter", "name": "max", "argument": "-max", "type": "integer", "label": "Specify max depth", "help": "Combine all positions with a depth >= max into a single bin in the histogram", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "report_select", "argument": null, "type": "select", "label": "Output type", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "bg", "options": [["BedGraph coverage file", "bg", true], ["Data suiteable for Histogram", "hist", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "split", "argument": "-split", "type": "boolean", "label": "Treat split/spliced BAM or BED12 entries as distinct BED intervals when computing coverage.", "help": "If set, the coverage will be calculated based the spliced intervals only. For BAM files, this inspects the CIGAR N operation to infer the blocks for computing coverage. For BED12 files, this inspects the BlockCount, BlockStarts, and BlockEnds fields (i.e., columns 10,11,12). If this option is not set, coverage will be calculated based on the interval's START/END coordinates, and would include introns in the case of RNAseq data.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-split", "falsevalue": ""}, {"model_class": "SelectToolParameter", "name": "strand", "argument": "-strand", "type": "select", "label": "Calculate coverage based on", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["both strands combined", "", false], ["positive strand only", "-strand +", false], ["negative strand only", "-strand -", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "d", "argument": "-d", "type": "boolean", "label": "Report the depth at each genome position with 1-based coordinates", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-d", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "dz", "argument": "-dz", "type": "boolean", "label": "Report the depth at each genome position with 0-based coordinatess", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-dz", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "five", "argument": "-5", "type": "boolean", "label": "Calculate coverage of 5\u2019 positions", "help": "Instead of entire interval", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-5", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "three", "argument": "-3", "type": "boolean", "label": "Calculate coverage of 3\u2019 positions", "help": "Instead of entire interval", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-3", "falsevalue": ""}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "bedgraph", "label": null, "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3583", "edam_data": "data_3002", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "bed", "panel_section_name": "BED", "form_style": "regular"}