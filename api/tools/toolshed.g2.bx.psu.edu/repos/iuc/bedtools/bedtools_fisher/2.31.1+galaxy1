, "sacCer3", false], ["Caenorhabditis elegans Feb. 2013 (WBcel235/ce11)", "ce11", false], ["Zebrafish May 2017 (GRCz11/danRer11) (danRer11)", "danRer11", false], ["Dog Oct. 2020 (Dog10K_Boxer_Tasha/canFam6) (canFam6)", "canFam6", false], ["Human CHM13 2.0 (T2T Consortium) Jan. 2022", "CHM13_T2T_v2.0", false], ["bosTau9", "bosTau9", false], ["Cat Nov. 2017 (Felis catus, domestic cat): felCat9", "felCat9", false], ["Rattus norvegicus Nov. 2020 (mRatBN7.2/rn7)", "rn7", false], ["Chicken (Gallus gallus): galGal6", "galGal6", false], ["Human (Homo sapiens): hg38 Canonical", "hg38canon", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "hist", "inputs": [{"model_class": "DataToolParameter", "name": "genome", "argument": null, "type": "data", "label": "Genome file", "help": "The expected format of the genome file is first column with chromosome names and second column with chromosome lengths. This genome file determines the chromosome list and their order.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "genome_file_opts_selector", "argument": null, "type": "select", "label": "Genome file", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "loc", "options": [["Locally installed Genome file", "loc", true], ["Genome file from your history", "hist", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "strand", "argument": null, "type": "select", "label": "Calculation based on strandedness?", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["Overlaps on either strand", "", true], ["Only overlaps occurring on the **same** strand.", "-s", false], ["Only overlaps occurring on the **opposite** strand.", "-S", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "split", "argument": "-split", "type": "boolean", "label": "Treat split/spliced BAM or BED12 entries as distinct BED intervals when computing coverage.", "help": "If set, the coverage will be calculated based the spliced intervals only. For BAM files, this inspects the CIGAR N operation to infer the blocks for computing coverage. For BED12 files, this inspects the BlockCount, BlockStarts, and BlockEnds fields (i.e., columns 10,11,12). If this option is not set, coverage will be calculated based on the interval's START/END coordinates, and would include introns in the case of RNAseq data.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-split", "falsevalue": ""}, {"model_class": "FloatToolParameter", "name": "overlap", "argument": "-f", "type": "float", "label": "Minimum overlap required as a fraction of A", "help": "Default is 1E-9, i.e. 1bp.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "reciprocal", "argument": "-r", "type": "select", "label": "Require that the fraction of overlap be reciprocal for A and B", "help": "In other words, if -f is 0.90 and -r is used, this requires that B overlap at least 90% of A and that A also overlaps at least 90% of B.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["No", "", true], ["Yes", "-r", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "m", "argument": "-m", "type": "boolean", "label": "Merge overlapping intervals before looking at overlap", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-m", "falsevalue": ""}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "data", "label": "Fisher Test on ${inputA.name} and ${inputB.name}", "hidden": false, "output_type": "data", "format_source": "inputA", "default_identifier_source": "None", "metadata_source": "inputA", "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_1915", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "bed", "panel_section_name": "BED", "form_style": "regular"}