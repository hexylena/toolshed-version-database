{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/bedtools/bedtools_intersectbed/2.31.1+galaxy1", "name": "bedtools Intersect intervals", "version": "2.31.1+galaxy1", "description": "find overlapping intervals in various ways", "labels": [], "icon": null, "edam_operations": ["operation_2429"], "edam_topics": ["topic_0622"], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "bedtools", "type": "bio.tools"}], "versions": ["2.19.0", "2.22.0", "2.24.0", "2.26.0.0", "2.27.0.1", "2.27.0.2", "2.27.1", "2.27.1+galaxy1", "2.29.0", "2.29.2", "2.30.0", "2.30.0+galaxy1", "2.31.1+galaxy0", "2.31.1+galaxy1"], "hidden_versions": [], "tool_shed_repository": {"name": "bedtools", "owner": "iuc", "changeset_revision": "d57471728f7b", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "inputA", "argument": null, "type": "data", "label": "File A to intersect with B", "help": "BAM/BED/bedGraph/GFF/VCF/EncodePeak format", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["bam", "bed", "bedgraph", "gff", "vcf", "encodepeak"], "edam": {"edam_formats": ["format_2572", "format_3003", "format_3583", "format_2305", "format_3016", "format_3612"], "edam_data": ["data_0863", "data_3002", "data_3002", "data_1255", "data_0006", "data_3002"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Conditional", "name": "reduce_or_iterate", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "iterate", "inputs": [{"model_class": "DataToolParameter", "name": "inputB", "argument": "-b", "type": "data", "label": "File B to intersect with A", "help": "BAM/BED/bedGraph/GFF/VCF/EncodePeak format", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["bam", "bed", "bedgraph", "gff", "vcf", "encodepeak"], "edam": {"edam_formats": ["format_2572", "format_3003", "format_3583", "format_2305", "format_3016", "format_3612"], "edam_data": ["data_0863", "data_3002", "data_3002", "data_1255", "data_0006", "data_3002"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}, {"model_class": "ConditionalWhen", "value": "reduce", "inputs": [{"model_class": "DataToolParameter", "name": "inputB", "argument": "-b", "type": "data", "label": "File(s) B to intersect with A", "help": "BAM/BED/bedGraph/GFF/VCF/EncodePeak format", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["bam", "bed", "bedgraph", "gff", "vcf", "encodepeak"], "edam": {"edam_formats": ["format_2572", "format_3003", "format_3583", "format_2305", "format_3016", "format_3612"], "edam_data": ["data_0863", "data_3002", "data_3002", "data_1255", "data_0006", "data_3002"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "BooleanToolParameter", "name": "names", "argument": "-names", "type": "boolean", "label": "Add data set names instead of indices", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "yes", "falsevalue": "no"}]}], "test_param": {"model_class": "SelectToolParameter", "name": "reduce_or_iterate_selector", "argument": null, "type": "select", "label": "Combined or separate output files", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "iterate", "options": [["One output file per 'input B' file", "iterate", true], ["Single output containing intersections of any 'input B' lines with A", "reduce", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "strand", "argument": null, "type": "select", "label": "Calculation based on strandedness?", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["Overlaps on either strand", "", true], ["Only overlaps occurring on the **same** strand.", "-s", false], ["Only overlaps occurring on the **opposite** strand.", "-S", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "overlap_mode", "argument": null, "type": "select", "label": "What should be written to the output file?", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["Write the original entry in A for each overlap (-wa)", "-wa", false], ["Write the original entry in B for each overlap. Useful for knowing what A overlaps. Restricted by the fraction- and reciprocal option (-wb)", "-wb", false], ["Write the original A and B entries plus the number of base pairs of overlap between the two features. Only A features with overlap are reported. Restricted by the fraction- and reciprocal option (-wo)", "-wo", false], ["Write the original A and B entries plus the number of base pairs of overlap between the two features. However, A features w/o overlap are also reported with a NULL B feature and overlap = 0. Restricted by the fraction- and reciprocal option (-wao)", "-wao", false], ["Perform a \"left outer join\". That is, for each feature in A report each overlap with B.  If no overlaps are found, report a NULL feature for B (-loj)", "-loj", false]], "display": null, "multiple": true, "textable": false}, {"model_class": "BooleanToolParameter", "name": "split", "argument": "-split", "type": "boolean", "label": "Treat split/spliced BAM or BED12 entries as distinct BED intervals when computing coverage.", "help": "If set, the coverage will be calculated based the spliced intervals only. For BAM files, this inspects the CIGAR N operation to infer the blocks for computing coverage. For BED12 files, this inspects the BlockCount, BlockStarts, and BlockEnds fields (i.e., columns 10,11,12). If this option is not set, coverage will be calculated based on the interval's START/END coordinates, and would include introns in the case of RNAseq data.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-split", "falsevalue": ""}, {"model_class": "Conditional", "name": "fraction_cond", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "default", "inputs": []}, {"model_class": "ConditionalWhen", "value": "specify", "inputs": [{"model_class": "FloatToolParameter", "name": "overlap", "argument": "-f", "type": "float", "label": "Minimum overlap required as a fraction of A", "help": "Default is 1E-9, i.e. 1bp.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "Conditional", "name": "reciprocal_cond", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "-r", "inputs": []}, {"model_class": "ConditionalWhen", "value": "", "inputs": [{"model_class": "FloatToolParameter", "name": "overlapB", "argument": "-F", "type": "float", "label": "Minimum overlap required as a fraction of B", "help": "Default is 1E-9, i.e. 1bp.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "disjoint", "argument": "-e", "type": "boolean", "label": "Require that the fraction of overlap is fulfilled for A OR B.", "help": "If enabled, then for -f 0.90 and -F 0.10 this requires that either 90% of A is covered OR 10% of B is covered, otherwise, both fractions would have to be satisfied.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-e", "falsevalue": ""}]}], "test_param": {"model_class": "SelectToolParameter", "name": "reciprocal", "argument": "-r", "type": "select", "label": "Require that the fraction of overlap be reciprocal for A and B", "help": "In other words, if -f is 0.90 and -r is used, this requires that B overlap at least 90% of A and that A also overlaps at least 90% of B.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["No", "", true], ["Yes", "-r", false]], "display": null, "multiple": false, "textable": false}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "fraction_select", "argument": null, "type": "select", "label": "Required overlap", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "default", "options": [["Default: 1bp", "default", true], ["Specify minimum overlap(s)", "specify", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "invert", "argument": "-v", "type": "boolean", "label": "Report only those alignments that **do not** overlap with file(s) B", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-v", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "once", "argument": "-u", "type": "boolean", "label": "Write the original A entry _once_ if _any_ overlaps found in B.", "help": "Just report the fact >=1 hit was found", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-u", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "count", "argument": "-c", "type": "boolean", "label": "For each entry in A, report the number of overlaps with B.", "help": "Reports 0 for A entries that have no overlap with B", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-c", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "bed", "argument": "-bed", "type": "boolean", "label": "When using BAM input, write output as BED instead of BAM.", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-bed", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "sorted", "argument": "-sorted", "type": "boolean", "label": "For coordinate sorted input file the more efficient sweeping algorithm is enabled.", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-sorted", "falsevalue": ""}, {"model_class": "Conditional", "name": "genome_file_opts", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "loc", "inputs": [{"model_class": "SelectToolParameter", "name": "genome", "argument": null, "type": "select", "label": "Genome file", "help": "This genome file determines the chromosome list and their order.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": true, "value": null, "options": [["Human (Homo sapiens): hg19", "hg19", false], ["Human (Homo sapiens): hg18 Full (alias for hg18)", "hg18full", false], ["Human (Homo sapiens): hg18", "hg18", false], ["Mouse (Mus musculus): mm10 Full (alias for mm10)", "mm10full", false], ["Mouse (Mus musculus): mm10", "mm10", false], ["Mouse (Mus musculus): mm9 Full (alias for mm9)", "mm9full", false], ["Mouse (Mus musculus): mm9", "mm9", false], ["Fly (Drosophila melanogaster): dm3 Full (alias for dm3)", "dm3full", false], ["Fly (Drosophila melanogaster): dm3", "dm3", false], ["Fly (Drosophila melanogaster): dm6 Full (alias for dm6)", "dm6full", false], ["Fly (Drosophila melanogaster): dm6", "dm6", false], ["Mouse (Mus Musculus): mm39 Full", "mm39", false], ["A. mellifera genome (apiMel3.1 NCBI Amel_HAv3.1)", "apiMel3_1", false], ["Zebrafish Jul. 2010 (Zv9/danRer7) (danRer7)", "danRer7", false], ["Zebrafish Sep. 2014 (GRCz10/danRer10) (danRer10)", "danRer10", false], ["Arabidopsis thaliana (TAIR10)", "TAIR10", false], ["Mouse (Mus musculus): mm9 with ERCC spike-in", "mm9_ERCC", false], ["Human Dec. 2013 (GRCh38/hg38) (hg38)", "hg38", false], ["Human (Homo sapiens): hg19 Canonical", "hg19canon", false], ["Human (Homo sapiens): hg19 Full", "hg19full", false], ["Mouse (Mus musculus): mm9 Canonical", "mm9canon", false], ["S. cerevisiae Apr. 2011 (SacCer_Apr2011/sacCer3) (sacCer3)", "sacCer3", false], ["Caenorhabditis elegans Feb. 2013 (WBcel235/ce11)", "ce11", false], ["Zebrafish May 2017 (GRCz11/danRer11) (danRer11)", "danRer11", false], ["Dog Oct. 2020 (Dog10K_Boxer_Tasha/canFam6) (canFam6)", "canFam6", false], ["Human CHM13 2.0 (T2T Consortium) Jan. 2022", "CHM13_T2T_v2.0", false], ["bosTau9", "bosTau9", false], ["Cat Nov. 2017 (Felis catus, domestic cat): felCat9", "felCat9", false], ["Rattus norvegicus Nov. 2020 (mRatBN7.2/rn7)", "rn7", false], ["Chicken (Gallus gallus): galGal6", "galGal6", false], ["Human (Homo sapiens): hg38 Canonical", "hg38canon", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "hist", "inputs": [{"model_class": "DataToolParameter", "name": "genome", "argument": null, "type": "data", "label": "Genome file", "help": "The expected format of the genome file is first column with chromosome names and second column with chromosome lengths. This genome file determines the chromosome list and their order.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "genome_file_opts_selector", "argument": null, "type": "select", "label": "Genome file", "help": "Only applies when used with -sorted option.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "loc", "options": [["Locally installed Genome file", "loc", true], ["Genome file from your history", "hist", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "header", "argument": "-header", "type": "boolean", "label": "Print the header from the A file prior to results", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-header", "falsevalue": ""}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "data", "label": null, "hidden": false, "output_type": "data", "format_source": "inputA", "default_identifier_source": "None", "metadata_source": "inputA", "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_1915", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "bed", "panel_section_name": "BED", "form_style": "regular"}