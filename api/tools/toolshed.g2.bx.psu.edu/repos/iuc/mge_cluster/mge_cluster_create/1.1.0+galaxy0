{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/mge_cluster/mge_cluster_create/1.1.0+galaxy0", "name": "mge-cluster create", "version": "1.1.0+galaxy0", "description": "cluster mobile genetic elements and build a reusable model", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "mge-cluster", "type": "bio.tools"}], "versions": ["1.1.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "mge_cluster", "owner": "iuc", "changeset_revision": "93c3bc34e261", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "fasta_files", "argument": null, "type": "data", "label": "FASTA datasets or list collection", "help": "Select multiple datasets or a list collection. Each input should contain one plasmid or other mobile genetic element.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz"], "edam": {"edam_formats": ["format_1929", "format_1929"], "edam_data": ["data_2044", "data_2044"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "BooleanToolParameter", "name": "save_model_files", "argument": null, "type": "boolean", "label": "Save model files", "help": "Return the unitig FASTA, embedding model, and cluster model needed to apply this model to new sequences with mge-cluster.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "save_intermediate_files", "argument": null, "type": "boolean", "label": "Save intermediate files", "help": "Return variance-filtered unitigs, raw and sorted unitig presence/absence matrices, and training-sample embedding sanity-check coordinates.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "Section", "name": "advanced", "type": "section", "title": "Advanced options", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "kmer", "argument": "--kmer", "type": "integer", "label": "K-mer size", "help": "K-mer size used to build and query the Bifrost unitig graph. The packaged Bifrost build supports values up to 31.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 31, "optional": false, "hidden": false, "is_dynamic": false, "value": "31", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "min_cluster", "argument": "--min_cluster", "type": "integer", "label": "Minimum cluster size", "help": "Minimum number of samples used by HDBSCAN when forming clusters. This value must not exceed the number of input samples. For small datasets, reduce it accordingly.", "help_format": "html", "refresh_on_change": false, "min": 2, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "10", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "variance", "argument": "--variance", "type": "float", "label": "Unitig variance threshold", "help": "Discard unitig presence/absence features with variance below this threshold. The features are binary, so their variance cannot exceed 0.25; high thresholds can remove most or all unitigs.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.01", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "perplexity", "argument": "--perplexity", "type": "integer", "label": "Perplexity", "help": "Perplexity used by openTSNE. I