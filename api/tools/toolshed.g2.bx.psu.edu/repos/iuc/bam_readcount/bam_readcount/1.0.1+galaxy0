ict counting to", "help": "By default every position covered by at least one read is reported.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "all", "options": [["All covered positions", "all", true], ["A single region typed in below", "region", false], ["Regions listed in a file", "site_list", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Section", "name": "advanced", "type": "section", "title": "Advanced Options", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "min_mapping_quality", "argument": "--min-mapping-quality", "type": "integer", "label": "Minimum mapping quality", "help": "Reads with a lower MAPQ are not counted.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "min_base_quality", "argument": "--min-base-quality", "type": "integer", "label": "Minimum base quality", "help": "Bases with a lower quality are not counted.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_count", "argument": "--max-count", "type": "integer", "label": "Maximum depth", "help": "Pileup depth at which counting stops, to keep memory usage bounded.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "10000000", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "per_library", "argument": "--per-library", "type": "boolean", "label": "Report per library", "help": "Report one block of counts per read group library instead of one block per position.", "help_format": "