{"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Section", "name": "settings", "type": "section", "title": "Curation settings", "help": "The defaults are the same as in mumu and in the LULU R package.", "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "minimum_match", "argument": "--minimum_match", "type": "float", "label": "Minimum similarity (%)", "help": "A potential parent with a lower similarity to the OTU or ASV is rejected. With the LULU strategy (legacy), a parent with a similarity equal to this value is also rejected.", "help_format": "html", "refresh_on_change": false, "min": 50.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "84.0", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "minimum_ratio_type", "argument": "--minimum_ratio_type", "type": "select", "label": "Abundance ratio type", "help": "Use the smallest (min) or the average (avg) of the per-sample ratios: parent reads divided by OTU or ASV reads, in samples that have both.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "min", "options": [["Minimum (min)", "min", true], ["Average (avg)", "avg", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "minimum_ratio", "argument": "--minimum_ratio", "type": "float", "label": "Minimum abundance ratio", "help": "A potential parent is rejected if its abundance ratio to the OTU or ASV (minimum or average, as set in Abundance ratio type) is less than or equal to this value. Must be greater than 0.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "minimum_relative_cooccurrence", "argument": "--minimum_relative_cooccurrence", "type": "float", "label": "Minimum relative co-occurrence", "help": "Number of samples with both the OTU or ASV and the potential parent, divided by the number of samples with the OTU or ASV. A potential parent with a smaller value is rejected. Greater than 0, up to 1.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.95", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "legacy", "argument": "--legacy", "type": "boolean", "label": "Use LULU merging strategy (legacy)", "help": "Yes: use the LULU strategy, which should give the same results as the LULU R package with the minimum (min) ratio type. No: use the mumu strategy, which also accepts a parent that is absent from some samples of the OTU or ASV. The differences are listed in the help below the form.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--legacy", "falsevalue": ""}]}], "outputs": [{"model_class": "ToolOutput", "name": "new_otu_table", "format": "tabular", "label": "${tool.name} on ${on_string}: curated table", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "log", "format": "tabular", "label": "${tool.name} on ${on_string}: log", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "metagenomic_analysis", "panel_section_name": "Metagenomic Analysis", "form_style": "regular"}