{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/stanza_nlp/stanza_nlp/1.14.0+galaxy0", "name": "Stanza NLP Annotators", "version": "1.14.0+galaxy0", "description": "", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.12.0+galaxy0", "1.14.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "stanza_nlp", "owner": "iuc", "changeset_revision": "391fad845ca8", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input", "argument": null, "type": "data", "label": "Text", "help": "Plain text file (UTF-8) to annotate. The text may be in any of Stanza's supported languages; choose the matching model below.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "language_model", "argument": null, "type": "select", "label": "Language Model", "help": "Which installed Stanza language model to use. Models are installed by an administrator via the Stanza Language Models data manager (Admin > Local Data); the selected language must match the language of the input text.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "annotators", "argument": null, "type": "select", "label": "Annotation types", "help": "Which Stanza processors to run. Stanza pipelines are cumulative: each selection includes the processors it depends on (for example part-of-speech also runs tokenization and multi-word expansion). NER and sentiment are only available for languages that ship those models. Constituency parsing additionally requires a language model installed with the default or default_accurate package (it is absent from default_fast); selecting it with a default_fast model fails with an explanatory error.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "tokenize", "options": [["Tokenization and sentence segmentation", "tokenize", true], ["Part of speech, lemmas, and morphological features", "pos", false], ["Named entity recognition", "ner", false], ["Dependency parsing", "parse", false], ["Sentiment analysis", "sentiment", false], ["Constituency parsing", "constituency", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "format", "argument": null, "type": "select", "label": "Output format", "help": "JSON gives the full structured annotation and is best for downstream tools. CoNLL/CoNLL-U are tab-separated Universal Dependencies formats. Text is a human-readable summary with statistics.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "json", "options": [["JSON", "json", true], ["CoNLL", "conll", false], ["CoNLL-U", "conllu", false], ["Text", "text", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "HiddenToolParameter", "name": "download_models", "argument": null, "type": "hidden", "label": "", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": true, "is_dynamic": false, "value": "false"}], "outputs": [{"model_class": "ToolOutput", "name": "output_file", "format": "txt", "label": "${tool.name} (${annotators}) on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": 