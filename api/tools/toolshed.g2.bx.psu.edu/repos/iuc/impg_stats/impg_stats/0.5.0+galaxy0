{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/impg_stats/impg_stats/0.5.0+galaxy0", "name": "impg stats", "version": "0.5.0+galaxy0", "description": "summarize pairwise alignments", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.5.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "impg_stats", "owner": "iuc", "changeset_revision": "72524ab96810", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "alignment", "argument": null, "type": "data", "label": "Alignment file(s)", "help": "One or more pairwise alignment files in PAF format (use 'minimap2 --eqx' or 'wfmash' output). May be bgzipped (.paf.gz). impg builds a reusable '.impg' index next to the input.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["paf", "paf.gz"], "edam": {"edam_formats": ["format_2330", "format_2330"], "edam_data": ["data_0006", "data_0006"]}, "multiple": true, "min": 1, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "BooleanToolParameter", "name": "list_sequences", "argument": "--list-sequences", "type": "boolean", "label": "List sequence names and lengths", "help": "Skip overlap statistics and instead print one line per sequence with its name and length.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--list-sequences", "falsevalue": ""}, {"model_class": "Section", "name": "index_opts", "type": "section", "title": "Index options", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "unidirectional", "argument": "--unidirectional", "type": "boolean", "label": "Unidirectional interpretation", "help": "Disable bidirectional alignment interpretation. By default every A->B alignment creates an implicit B->A reverse mapping.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--unidirectional", "falsevalue": ""}, {"model_class": "IntegerToolParameter", "name": "trace_spacing", "argument": "--trace-spacing", "type": "integer", "label": "Trace spacing", "help": "Trace spacing for .1aln/.tpa alignment files (used when converting tracepoints to CIGAR). Ignored for plain PAF.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "txt", "label": "${tool.name} on ${on_string}: statistics", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_2330", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "annotation", "panel_section_name": "Annotation", "form_style": "regular"}