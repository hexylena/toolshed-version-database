ptional": false, "hidden": false, "is_dynamic": false, "value": "30", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "all", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "selection_mode", "argument": null, "type": "select", "label": "Number of modules to display", "help": "Choose whether to show only the top-ranked functional modules or all modules from the pathway completeness table.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "top", "options": [["Show top modules", "top", true], ["Show all modules", "all", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "mode", "argument": "--mode", "type": "select", "label": "Module ranking mode", "help": "Select how modules are ranked before plotting: 'mean' highlights core modules with high average completeness across MAGs, while 'variance' highlights modules that differ most between MAGs.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "mean", "options": [["mean (core modules)", "mean", true], ["variance (differential modules)", "variance", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "module_label", "argument": "--module_label", "type": "select", "label": "Module label style", "help": "Choose how KEGG modules are labeled in the heatmap: module accession only, module name only, or both accession and name.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "id", "options": [["Module ID (e.g. M00001)", "id", true], ["Module name", "name", false], ["Module ID and name", "both", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "row_fontsize", "argument": "--row_fontsize", "type": "integer", "label": "Row label font size (MAG labels)", "help": "Font size for MAG labels on the heatmap rows. Increase this value for readability when plotting fewer MAGs; decrease it when many MAGs are displayed.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 20, "optional": false, "hidden": false, "is_dynamic": false, "value": "8", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "format", "argument": "--format", "type": "select", "label": "Output format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "png", "options": [["PNG", "png", true], ["PDF", "pdf", false], ["SVG", "svg", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "Section", "name": "representatives", "type": "section", "title": "Representative MAG selection (optional)", "help": "Restrict the heatmap to representative MAGs from dRep clusters, matching the row order and selection of the drep-cluster-func plot for direct comparison.", "expanded": false, "inputs": [{"model_class": "DataToolParameter", "name": "drep", "argument": null, "type": "data", "label": "dRep cluster table", "help": "Provides the cluster assignments (which MAG belongs to which dRep cluster). Required to identify representatives.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["csv", "tabular"], "edam": {"edam_formats": ["format_3475", "format_3475"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "gtdb", "argument": null, "type": "data", "label": "GTDB annotation table", "help": "Used together with the cluster table to pick exactly the same representative per cluster as the drep-cluster-func plot, so both heatmaps show identical MAGs in the same order.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "IntegerToolParameter", "name": "top_representatives", "argument": null, "type": "integer", "label": "Top representative MAGs", "help": "Number of largest dRep clusters to include in the heatmap. If left empty, all MAGs from the pathway table are shown alphabetically. Requires both dRep and GTDB tables.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 1000, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "Section", "name": "fig_size", "type": "section", "title": "Figure size", "help": null, "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "width", "argument": null, "type": "float", "label": "Figure width (cm)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1.0, "max": 100.0, "optional": true, "hidden": false, "is_dynamic": false, "value": "25.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "height", "argument": null, "type": "float", "label": "Figure height (cm)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1.0, "max": 100.0, "optional": true, "hidden": false, "is_dynamic": false, "value": "20.0", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "plot", "format": "png", "label": "${tool.name} heatmap on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": nu