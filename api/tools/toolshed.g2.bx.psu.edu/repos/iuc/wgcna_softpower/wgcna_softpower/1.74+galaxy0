or", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "RsquaredCut", "argument": null, "type": "float", "label": "Rsquared threshold to select the power", "help": "The lowest power for which the scale free topology fit exceeds this value will be selected", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.85", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "log_transform", "argument": null, "type": "boolean", "label": "Apply log2(count + 1) transformation?", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}, {"model_class": "BooleanToolParameter", "name": "filter_by_variance", "argument": null, "type": "boolean", "label": "Filter low-variance genes?", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}, {"model_class": "FloatToolParameter", "name": "variance_quantile", "argument": null, "type": "float", "label": "Variance filter quantile", "help": "Genes below this variance percentile are removed (default 0.4, bottom 40%). Used only when filtering is enabled.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.4", "area": false, "datalist": []}], "outputs": [{"model_class": "ToolOutput", "name": "softpower_config", "format": "txt", "label": "${tool.name} on ${on_string} - Soft-thresholding config", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "softpower_config.txt", "edam_format": "format_2330", "edam_data": "data_