{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/topanat/topanat/2.38.1+galaxy0", "name": "TopAnat", "version": "2.38.1+galaxy0", "description": "GO-like enrichment of anatomical terms and cell types mapped to genes by expression patterns", "labels": [], "icon": null, "edam_operations": ["operation_2436", "operation_0314"], "edam_topics": ["topic_0085", "topic_3308"], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "BgeeDB", "type": "bioconductor"}], "versions": ["2.38.1+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "topanat", "owner": "iuc", "changeset_revision": "32bf3e7d0dd7", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "SelectToolParameter", "name": "species", "argument": "--species", "type": "select", "label": "Species", "help": "Species for which the enrichment analysis will be performed. Species and expression data are provided by the Bgee database.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "Homo_sapiens", "options": [["Homo sapiens (human)", "Homo_sapiens", true], ["Mus musculus (mouse)", "Mus_musculus", false], ["Danio rerio (zebrafish)", "Danio_rerio", false], ["Drosophila melanogaster (fly)", "Drosophila_melanogaster", false], ["Caenorhabditis elegans (nematode)", "Caenorhabditis_elegans", false], ["Canis lupus familiaris (dog)", "Canis_lupus_familiaris", false], ["Felis catus (cat)", "Felis_catus", false], ["Equus caballus (horse)", "Equus_caballus", false], ["Sus scrofa (pig)", "Sus_scrofa", false], ["Bos taurus (cattle)", "Bos_taurus", false], ["Capra hircus (goat)", "Capra_hircus", false], ["Ovis aries (sheep)", "Ovis_aries", false], ["Oryctolagus cuniculus (rabbit)", "Oryctolagus_cuniculus", false], ["Cavia porcellus (guinea pig)", "Cavia_porcellus", false], ["Gallus gallus (chicken)", "Gallus_gallus", false], ["Meleagris gallopavo (wild turkey)", "Meleagris_gallopavo", false], ["Ornithorhynchus anatinus (platypus)", "Ornithorhynchus_anatinus", false], ["Callithrix jacchus (white-tufted-ear marmoset)", "Callithrix_jacchus", false], ["Cercocebus atys (sooty mangabey)", "Cercocebus_atys", false], ["Macaca fascicularis (crab-eating macaque)", "Macaca_fascicularis", false], ["Macaca mulatta (macaque)", "Macaca_mulatta", false], ["Macaca nemestrina (pig-tailed macaque)", "Macaca_nemestrina", false], ["Papio anubis (olive baboon)", "Papio_anubis", false], ["Gorilla gorilla (gorilla)", "Gorilla_gorilla", false], ["Pan paniscus (bonobo)", "Pan_paniscus", false], ["Pan troglodytes (chimpanzee)", "Pan_troglodytes", false], ["Microcebus murinus (gray mouse lemur)", "Microcebus_murinus", false], ["Chlorocebus sabaeus (green monkey)", "Chlorocebus_sabaeus", false], ["Manis javanica (Malayan pangolin)", "Manis_javanica", false], ["Rattus norvegicus (rat)", "Rattus_norvegicus", false], ["Heterocephalus glaber (naked mole rat)", "Heterocephalus_glaber", false], ["Monodelphis domestica (opossum)", "Monodelphis_domestica", false], ["Xenopus laevis (African clawed frog)", "Xenopus_laevis", false], ["Xenopus tropicalis (western clawed frog)", "Xenopus_tropicalis", false], ["Anolis carolinensis (green anole)", "Anolis_carolinensis", false], ["Lepisosteus oculatus (spotted gar)", "Lepisosteus_oculatus", false], ["Anguilla anguilla (European freshwater eel)", "Anguilla_anguilla", false], ["Astyanax mexicanus (blind cave fish)", "Astyanax_mexicanus", false], ["Esox lucius (northern pike)", "Esox_lucius", false], ["Salmo salar (Atlantic salmon)", "Salmo_salar", false], ["Gadus morhua (Atlantic cod)", "Gadus_morhua", false], ["Poecilia reticulata (guppy)", "Poecilia_reticulata", false], ["Oryzias latipes (Japanese rice fish)", "Oryzias_latipes", false], ["Astatotilapia calliptera (eastern happy)", "Astatotilapia_calliptera", false], ["Neolamprologus brichardi (fairy cichlid)", "Neolamprologus_brichardi", false], ["Scophthalmus maximus (turbot)", "Scophthalmus_maximus", false], ["Gaster