name": "stageId", "argument": "--stageId", "type": "text", "label": "Ontology term ID", "help": "Enter any ontology term ID (e.g. UBERON:0000092 for post-embryonic stage, UBERON:0000068 for embryo stage).", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "stage_source", "argument": null, "type": "select", "label": "Developmental stage filter", "help": "Optionally restrict expression data to a specific developmental stage. Leave as 'No filter' to include all stages.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["No filter (all stages)", "none", true], ["Predefined stage", "select", false], ["Custom ontology term", "custom", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Conditional", "name": "fg", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "text", "inputs": [{"model_class": "TextToolParameter", "name": "fg_genes_text", "argument": null, "type": "text", "label": "Foreground gene IDs", "help": "Enter one gene ID per line. Gene IDs must be Ensembl gene IDs (e.g. ENSG00000244734) or species-specific gene IDs as used in Bgee, not gene names (e.g. HBB). See complete documentation for versions used.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "area": true, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "file", "inputs": [{"model_class": "DataToolParameter", "name": "fg_file", "argument": "--fgFile", "type": "data", "label": "Foreground genes file", "help": "One-column file with no header, containing one gene ID per line.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "fg_source", "argument": null, "type": "select", "label": "Foreground genes input format", "help": "The foreground is the gene set of interest for which anatomical enrichment will be computed. Gene IDs must be Ensembl IDs (e.g. ENSG00000244734) or species-specific IDs as used in Bgee. See complete documentation for versions used.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "text", "options": [["Paste gene IDs (one per line)", "text", true], ["Upload a file (one gene ID per line, no header)", "file", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Conditional", "name": "bg", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "all", "inputs": []}, {"model_class": "ConditionalWhen", "value": "text", "inputs": [{"model_class": "TextToolParameter", "name": "bg_genes_text", "argument": null, "type": "text", "label": "Background gene IDs", "help": "Enter one gene ID per line. All foreground genes must be included. Gene IDs must be Ensembl IDs or species-specific IDs as used in Bgee, not gene names. See complete documentation for versions used.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "area": true, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "file", "inputs": [{"model_class": "DataToolParameter", "name": "bg_file", "argument": "--bgFile", "type": "data", "label": "Background genes file", "help": "One-column file with no header, containing one gene ID per line. All foreground genes must be included.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "bg_source", "argument": null, "type": "select", "label": "Background genes (universe)", "help": "The background defines the gene universe for the enrichment test. All foreground genes must be present in the background.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "all", "options": [["Use all genes with expression data in Bgee (recommended default)", "all", true], ["Paste gene IDs (one per line)", "text", false], ["Upload a file (one gene ID per line, no header)", "file", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Section", "name": "adv", "type": "section", "title": "Advanced Options", "help": null, "expanded": false, "inputs": [{"model_class": "SelectToolParameter", "name": "algorithm", "argument": "--algorithm", "type": "select", "label": "Decorrelation algorithm", "help": "Algorithm used to account for the topology of the anatomical ontology when computing enrichment. 'classic' ignores topology. See topGO documentation for details on each algorithm.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "classic", "options": [["classic (independent testing, no decorrelation)", "classic", true], ["elim", "elim", false], ["weight", "weight", false], ["weight01", "weight01", false], ["lea", "lea", false], ["parentchild", "parentchild", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "statistics", "argument": "--statistics", "type": "select", "label": "Test statistic", "help": "Statistical test used to compute enrichment p-values. Fisher's exact test is most commonly used. See topGO documentation for details.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "fisher", "options": [["Fisher's exact test", "fisher", true], ["Kolmogorov-Smirnov test", "ks", false], ["t-test", "t", false], ["globaltest", "globaltest", false], ["sum", "sum", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "nodeSize", "argument": "--nodeSize", "type": "integer", "label": "Minimum node size", "help": "Minimum number of genes that must be annotated to an anatomical entity for that entity to be tested. Entities with fewer annotated genes are pruned. Default: 10.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "10", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "confidence", "argument": "--confidence", "type": "select", "label": "Expression call quality", "help": "Minimum quality level for expression calls to be included in the analysis. 'silver' and 'gold' apply to Bgee release 14 and above; 'all' and 'high_quality' apply to older releases.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "silver", "options": [["silver (default, Bgee \u2265 14)", "silver", true], ["gold (Bgee \u2265 14)", "gold", false], ["all (Bgee < 14)", "all", false], ["high_quality (Bgee < 14)", "high_quality", false]], "display": null, "multiple": false, "textable": false}]}], "outputs": [{"model_class": "ToolOutput", "name": "result", "format": "tabular", "label": "${tool.name} on ${on_string}: enrichment results", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_