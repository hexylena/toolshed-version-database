{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/smoothxg/smoothxg/0.8.2+galaxy0", "name": "smoothxg", "version": "0.8.2+galaxy0", "description": "POA-aware graph smoother for pangenome graphs", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.8.2+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "smoothxg", "owner": "iuc", "changeset_revision": "56a0c2b39699", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "gfa_in", "argument": "--gfa-in", "type": "data", "label": "Input graph (GFA1)", "help": "Typically from seqwish.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["gfa1"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "IntegerToolParameter", "name": "n_haps", "argument": "--n-haps", "type": "integer", "label": "Number of haplotypes (-r)", "help": "Set to match the number of haplotypes in the source FASTA.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "8", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "block_id_min", "argument": "--block-id-min", "type": "float", "label": "Min block identity (-I)", "help": "Minimum edit-based identity to cluster sequences into a block. pggb default 0.9.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.9", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "path_jump_max", "argument": "--path-jump-max", "type": "i