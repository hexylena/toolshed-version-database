{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/flavotyper/flavotyper/0.5.1+galaxy0", "name": "FlavoTyper", "version": "0.5.1+galaxy0", "description": "in silico serotyping of Flavobacterium psychrophilum", "labels": [], "icon": null, "edam_operations": ["operation_0346"], "edam_topics": ["topic_3673", "topic_0625", "topic_3301", "topic_3397"], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "flavotyper", "type": "bio.tools"}], "versions": ["0.5.1+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "flavotyper", "owner": "iuc", "changeset_revision": "ef06acb676b4", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "genomes", "argument": null, "type": "data", "label": "Genome assembly FASTA(s)", "help": "Please provide one or multiple Flavobacterium psychrophilum genome assemblies.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz"], "edam": {"edam_formats": ["format_1929", "format_1929"], "edam_data": ["data_2044", "data_2044"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "BooleanToolParameter", "name": "species_check", "argument": null, "type": "boolean", "label": "Run species verification (ANI computation against reference strain NCIMB 1947T)", "help": "This is a highly recommended step. It computes the average nucleotide identity (fastANI) of each genome against the built-in Flavobacterium psychrophilum NCIMB 1947T reference and requires it to pass before typing. Disable only for already-verified assemblies.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "", "falsevalue": "--no-species-check"}, {"model_class": "BooleanToolParameter", "name": "locus_analysis", "argument": null, "type": "boolean", "label": "Run locus analysis", "help": "Enabling locus analysis allows the extraction of the locus sequence involved in the biosynthesis of O-Ag in F. psychrophilum, produce a pairwise alignment file against a set of reference loci, and a locus map image.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--locus-analysis", "falsevalue": ""}, {"model_class": "Section", "name": "adv", "type": "section", "title": "Advanced parameters", "help": null, "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "min_identity", "argument": "--min-identity", "type": "float", "label": "Minimum BLASTN percent identity for a marker hit to be accepted", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "97.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_coverage", "argument": "--min-coverage", "type": "float", "label": "Minimum marker coverage as aligned length / marker length * 100", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "94.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "ani_threshold", "argument": "--ani-threshold", "type": "float", "label": "Minimum fastANI value to pass species verification", "help": "Only applied when species verification is enabled.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "95.0", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "expected_genome_size_min", "argument": "--expected-genome-size-min", "type": "integer", "label": "Expected minimum genome size (bp)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "2619202", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "expected_genome_size_max", "argument": "--expected-genome-size-max", "type": "integer", "label": "Expected maximum genome size (bp)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "3122663", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "warn_contigs_over", "argument": "--warn-contigs-over", "type": "integer", "label": "Contig-count warning threshold", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "300", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "high_warn_contigs_over", "argument": "--high-warn-contigs-over", "type": "integer", "label": "High contig-count warning threshold", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "500", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "allow_duplicate_sample_names", "argument": "--allow-duplicate-sample-names", "type": "boolean", "label": "Allow duplicate sample IDs derived from input dataset names", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--allow-duplicate-sample-names", "falsevalue": ""}]}], "outputs": [{"model_class": "ToolOutputCollection", "name": "locus_maps", "format": null, "label": "${tool.name} on ${on_string}: locus analysis results", "hidden": false, "output_type": "collection", "default_format": "data", "default_format_source": nul