2", "argument": "--min-r2", "type": "float", "label": "Min wave alignment R\u00b2", "help": "Minimum dynamic wave alignment R\u00b2 threshold for confirmed sweeps", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.35", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "tau_peak", "argument": "--tau-peak", "type": "float", "label": "Stage 1 peak energy floor", "help": "Stage 1 peak selection intensity energy floor", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0001", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "time_points", "argument": "--time-points", "type": "integer", "label": "Temporal grid points", "help": "Number of continuous temporal grid points for the regression", "help_format": "html", "refresh_on_change": false, "min": 10, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "250", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "plot", "argument": "--plot", "type": "boolean", "label": "Generate publication figures", "help": "Generate 4-panel PDF and PNG figures showing temporal selection dynamics", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--plot", "falsevalue": ""}, {"model_class": "FloatToolParameter", "name": "tau_auc", "argument": "--tau-auc", "type": "float", "label": "Stage 1 AUC energy floor (optional)", "help": "Stage 1 cumulative area under curve energy floor (default: auto)", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "time_units", "argument": "--time-units",