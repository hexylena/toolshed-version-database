{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/pyeuk_eukaryotyping/pyeuk_eukaryotyping/0.8.1+galaxy0", "name": "PyEuk distance", "version": "0.8.1+galaxy0", "description": "compute a pairwise genetic-distance matrix from a haplotype sheet", "labels": [], "icon": null, "edam_operations": [], "edam_topics": ["topic_0637", "topic_3305", "topic_3168"], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.8.1+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "pyeuk_eukaryotyping", "owner": "iuc", "changeset_revision": "f0bab694bc93", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "sheet", "argument": null, "type": "data", "label": "Haplotype sheet", "help": "Specimen x haplotype presence/absence sheet, e.g. from the Build haplotype sheet tool.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "metric", "argument": "--metric", "type": "select", "label": "Distance metric", "help": "Distance metric. wibs for presence/absence sheets; snp-wibs needs a reference FASTA.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "wibs", "options": [["wibs -- weighted identity-by-state (presence/absence)", "wibs", true], ["ensemble -- Barratt eukaryotyping ensemble", "ensemble", false], ["snp-wibs -- sequence-weighted (needs a reference FASTA)", "snp-wibs", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "weight_mode", "argument": "--weight-mode", "type": "select", "label": "Allele weighting", "help": "How each haplotype column is weighted. heterozygosity 2p(1-p) suits presence/absence sheets.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "heterozygosity", "options": [["heterozygosity -- 2p(1-p) (default)", "heterozygosity", true], ["inverted-king -- sqrt(p(1-p))", "inverted-king", false], ["king -- 1/sqrt(p(1-p))", "king", false], ["uniform -- 1.0", "uniform", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "ploidy", "argument": "--ploidy", "type": "integer", "label": "Organism base ploidy", "help": "Organism base ploidy. 1 for haploid, 2 for diploid. Blank uses the engine default.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "DataToolParameter", "name": "fasta", "argument": "--fasta", "type": "data", "label": "Reference / learned FASTA (snp-wibs only)", "help": "Reference or learned FASTA, required only for the snp-wibs metric.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta"], "edam": {"edam_formats": ["format_1929"], "edam_data": ["data_2044"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "FloatToolParameter", "name": "epsilon", "argument": "--epsilon", "type": "float", "label": "Bayesian error rate epsilon", "help": "Bayesian error rate.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.3072", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_completeness", "argument": "--min-completeness", "type": "float", "label": "Minimum locus completeness", "help": "Minimum fraction of loci a specimen must have called to enter the matrix.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.1", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_maf", "argument": "--min-maf", "type": "float", "label": "Minimum minor-allele frequency", "help": "Drop a column unless the fraction of called specimens carrying it is between this value and 1 minus it. 0 disables.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 0.5, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "project_psd", "argument": null, "type": "boolean", "label": "Project onto the PSD cone", "help": "Project the distance matrix onto the PSD cone. Off by default; leave off with a count cut, turn on with a distance cut.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": ""}], "outputs": [{"model_class": "ToolOutput", "name": "matrix", "format": "tabular", "label": "${tool.name} on ${on_string}: distance matrix", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "annotation", "panel_section_name": "Annotation", "form_style": "regular"}