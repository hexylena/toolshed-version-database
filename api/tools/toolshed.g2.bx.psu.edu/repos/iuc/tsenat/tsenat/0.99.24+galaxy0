{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/tsenat/tsenat/0.99.24+galaxy0", "name": "TSENAT", "version": "0.99.24+galaxy0", "description": "Tsallis Entropy Analysis Toolbox", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "tsenat", "type": "bio.tools"}], "versions": ["0.99.0+galaxy0", "0.99.24+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "tsenat", "owner": "iuc", "changeset_revision": "2ead6d1194e6", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "Conditional", "name": "salmon_input", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "individual", "inputs": [{"model_class": "DataToolParameter", "name": "salmon_files", "argument": null, "type": "data", "label": "Salmon quantification files (.sf)", "help": "Select individual Salmon .sf quantification files. File names must match sample IDs in the sample sheet. Format: tab-delimited with columns: Name, Length, EffectiveLength, TPM, NumReads.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}, {"model_class": "ConditionalWhen", "value": "collection", "inputs": [{"model_class": "DataCollectionToolParameter", "name": "salmon_collection", "argument": null, "type": "data_collection", "label": "Salmon dataset collection", "help": "Select a dataset collection containing Salmon .sf files. Element names must match sample IDs in the sample sheet.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "collection_types": ["list"], "fields": null, "column_definitions": null, "extensions": ["data"], "multiple": false, "tag": null, "options": {"hda": [], "hdca": [], "dce": []}, "pinned": {"hda": [], "hdca": [], "dce": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "input_type", "argument": null, "type": "select", "label": "Salmon input format", "help": "Choose how to provide Salmon quantification files: individual files or a dataset collection", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "individual", "options": [["Individual files", "individual", true], ["Dataset collection", "collection", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "DataToolParameter", "name": "sample_sheet", "argument": null, "type": "data", "label": "Sample sheet (metadata file)", "help": "Tab-separated file with sample information. Must contain columns for sample IDs, experimental conditions, and optionally subject/pairing information. See help section for format details.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular", "tsv"], "edam": {"edam_formats": ["format_3475", "format_3475"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "annotation", "argument": null, "type": "data", "label": "Transcript annotation", "help": "GFF3 annotation file with transcript ID to gene ID mapping (e.g., GENCODE GFF3). Used to group transcripts by gene and map annotation information.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["gff3", "gff", "gff3.gz"], "edam": {"edam_formats": ["format_1975", "format_2305", "format_1975"], "edam_data": ["data_1255", "data_1255", "data_1255"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "ColumnListParameter", "name": "sample_col", "argument": null, "type": "data_column", "label": "Sample ID column", "help": "Select column containing sample identifiers. Values must match Salmon file names (element identifiers if using collection).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false, "data_ref": "sample_sheet", "numerical": false}, {"model_class": "ColumnListParameter", "name": "condition_col", "argument": null, "type": "data_column", "label": "Condition column", "help": "Select column containing experimental conditions/treatment groups (e.g., normal, tumor, control, treatment).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false, "data_ref": "sample_sheet", "numerical": false}, {"model_class": "TextToolParameter", "name": "control", "argument": null, "type": "text", "label": "Reference condition", "help": "Reference/control condition value for contrast specification. Must match a value in the condition column. Typically the untreated or normal condition.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "Conditional", "name": "paired_design", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "ColumnListParameter", "name": "subject_col", "argument": null, "type": "data_column", "label": "Subject/pairing column", "help": "Select column grouping paired or repeated samples (e.g., patient ID, animal ID). Each unique value represents one subject with multiple samples.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false, "data_ref": "sample_sheet", "numerical": false}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "paired", "argument": null, "type": "select", "label": "Study design", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["Unpaired samples", "no", false], ["Paired/repeated measures design", "yes", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Section", "name": "data_filtering", "type": "section", "title": "Data Filtering & Preprocessing", "help": null, "expanded": true, "inputs": [{"model_class": "SelectToolParameter", "name": "filter_stringency", "argument": null, "type": "select", "label": "Low-abundance filter stringency", "help": "Filter strategy for low-abundance transcripts. Soft: \u226525% presence in samples (preserve isoform diversity). Medium: \u226550% presence with TPM above median (balances noise reduction and diversity, recommended). Severe: \u226575% presence with high TPM (focus on abundant isoforms only). Choice affects entropy estimates: severe reduces noise but may miss rare isoforms and reduce diversity signal.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "medium", "options": [["Soft (keep more transcripts)", "soft", false], ["Medium (balanced)", "medium", true], ["Severe (keep high-abundance only)", "severe", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "min_tpm", "argument": null, "type": "float", "label": "Minimum TPM threshold", "help": "(Optional) Minimum TPM value for transcript filtering (default: 1.0 if not specified). Transcripts with TPM < threshold in samples below min_samples are excluded. Leave empty to use default.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_isoform_abundance", "argument": null, "type": "float", "label": "Minimum isoform abundance within gene", "help": "(Optional) Relative abundance threshold for isoforms within each gene (0-1 scale). Default: 0.05 (5%). Set to 0 to skip per-isoform filtering. For example, 0.05 means retain isoforms comprising >5% of the gene's total expression.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "Section", "name": "normalization_options", "type": "section", "title": "Data Normalization & Preprocessing", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "norm", "argument": null, "type": "boolean", "label": "Enable normalization", "help": "Normalize entropy estimates to [0,1] range for comparable cross-q assessment. Recommended (default: enabled) for comparing entropy across different q-values and between genes. Disable only if raw unnormalized entropy is needed.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}, {"model_class": "SelectToolParameter", "name": "norm_method", "argument": null, "type": "select", "label": "Normalization method", "help": "Method for normalization. Default (automatic): chooses algorithm based on data. Range: [0,1] scaling. Z-score: centered and scaled. Quantile: quantile normalization for cross-sample comparison.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["Default (automatic)", "none", true], ["Range scaling [0-1]", "range", false], ["Z-score normalization", "zscore", false], ["Quantile normalization", "quantile", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "pseudocount", "argument": null, "type": "float", "label": "Pseudocount", "help": "Add pseudocount to break ties and handle zeros in sparse RNA-seq data. Leave blank (default) for no regularization (pseudocount=0), or specify a numeric value between 0-10 for fixed pseudocount. Typical values: 0.5, 1.0. To use automatic estimation based on library size, set to a very small value like 0.001. Critical for rank-based non-parametric tests (e.g., Scheirer-Ray-Hare) which require unique orderings.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 10.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "shrinkage", "argument": null, "type": "select", "label": "Shrinkage method", "help": "Shrinkage estimation for robust variance estimation. None: direct estimation. James-Stein: empirical Bayes shrinkage toward grand mean. Use James-Stein for small sample sizes or high-variance data.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["No shrinkage", "none", true], ["James-Stein shrinkage", "james-stein", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "min_valid_frac", "argument": null, "type": "float", "label": "Minimum valid fraction", "help": "Minimum fraction of valid (non-missing) values required to retain a transcript or gene (default: 0.75 = 75%). Transcripts with <75% valid samples are excluded due to insufficient data quality. Increase for stringent filtering; decrease to retain more transcripts.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.75", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "reference_group", "argument": null, "type": "text", "label": "Reference group for normalization", "help": "(Optional) Reference group identifier for 'relative_reference' normalization method. Entropy values will be normalized relative to this group's mean. If empty, uses first condition group.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "what_output", "argument": null, "type": "select", "label": "Diversity output type (advanced)", "help": "Output type for diversity calculation: 'S' = entropy (default) or 'D' = diversity (Hill numbers). Most users should use default entropy ('S'). Choose 'D' only if you specifically need diversity measures.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "S", "options": [["Entropy (S) - default", "S", true], ["Diversity (D) - Hill numbers", "D", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "Section", "name": "bootstrap_options", "type": "section", "title": "Bootstrap Confidence Intervals", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "bootstrap", "argument": null, "type": "boolean", "label": "Enable bootstrap", "help": "Enable bootstrap resampling to compute robust confidence intervals for entropy estimates. Adds computational cost but provides non-parametric uncertainty quantification. Recommended for small sample sizes or non-normal data.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "IntegerToolParameter", "name": "nboot", "argument": null, "type": "integer", "label": "Bootstrap replicates", "help": "Number of bootstrap resampling iterations (default: 1000). Larger values (e.g., 5000) improve CI precision but increase runtime. Use \u22651000 for final analyses; 100-500 for exploratory work.", "help_format": "html", "refresh_on_change": false, "min": 100, "max": 10000, "optional": false, "hidden": false, "is_dynamic": false, "value": "1000", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "bootstrap_method", "argument": null, "type": "select", "label": "Bootstrap method", "help": "Bootstrap CI method. Percentile: simple, fast, less accurate for skewed distributions. BCa: bias-corrected & accelerated, more accurate and recommended for entropy estimates which may be skewed.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "percentile", "options": [["Percentile (faster)", "percentile", true], ["BCa (bias-corrected and accelerated, recommended)", "bca", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "bootstrap_ci", "argument": null, "type": "float", "label": "Bootstrap CI level", "help": "Confidence level for CIs (0.95 = 95% CI). Narrower intervals (e.g., 0.90) are easier to achieve; wider intervals (e.g., 0.99) provide stronger confidence.", "help_format": "html", "refresh_on_change": false, "min": 0.8, "max": 0.99, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.95", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "bootstrap_include_diagnostics", "argument": null, "type": "boolean", "label": "Include bootstrap diagnostics", "help": "Save bootstrap diagnostics including convergence checks, variance ratios, and CI coverage validations. Useful for assessing bootstrap stability and data quality.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}]}, {"model_class": "Section", "name": "sait_testing", "type": "section", "title": "SAIT (Parametric Interaction Testing)", "help": null, "expanded": false, "inputs": [{"model_class": "SelectToolParameter", "name": "sait_method", "argument": null, "type": "select", "label": "SAIT fitting method", "help": "Statistical method for Scale-Adaptive Interaction Testing (SAIT) of q \u00d7 condition effects. GAM (recommended): Semi-parametric model with flexible smooth functions; best for non-linear q-curves. LMM: Linear mixed model with AR(1) correlation; good for repeated measures. FPCA: Functional PCA; reduces dimensionality for high q-resolution. GEE: Generalized estimating equations; robust to misspecified correlation structure.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "gam", "options": [["GAM (Generalized Additive Model, recommended)", "gam", true], ["LMM (Linear Mixed Model)", "lmm", false], ["FPCA (Functional Principal Component Analysis)", "fpca", false], ["GEE (Generalized Estimating Equations)", "gee", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "sait_pcorr", "argument": null, "type": "select", "label": "SAIT p-value correction", "help": "Multiple testing correction for q \u00d7 condition interaction tests (corrects for ~3089 transcripts). Hochberg: Step-up method, more powerful than Bonferroni, recommended. Benjamini-Hochberg: Controls FDR, most powerful for many tests. Bonferroni: Strict, very conservative. Holm: Step-down, better rejection power.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "hochberg", "options": [["Hochberg (step-up, recommended - matches vignette)", "hochberg", true], ["Benjamini-Hochberg (FDR)", "BH", false], ["Bonferroni (stricter)", "bonferroni", false], ["Holm (step-down)", "holm", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "multicorr_method", "argument": null, "type": "select", "label": "Advanced multiple correction for SAIT", "help": "Advanced multiple comparison correction methods for SAIT interaction tests. Default uses primary p-value correction. Hochberg: More powerful than Bonferroni. Westfall-Young: Bootstrap-based, controls family-wise error rate. Benjamini-Yekutieli: Robust FDR control under dependence.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "default", "options": [["Default (use primary correction)", "default", true], ["Hochberg", "hochberg", false], ["Westfall-Young (parametric)", "westfall-young", false], ["Benjamini-Yekutieli", "benjamini-yekutieli", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "Conditional", "name": "gee_conditional", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "SelectToolParameter", "name": "gee_corstr", "argument": null, "type": "select", "label": "GEE correlation structure", "help": "Correlation structure for Generalized Estimating Equations (only applicable if SAIT method is GEE). AR(1): Auto-regressive order 1 (good for q-spectrum). Exchangeable: treats all q-values as equally correlated. Independence: assumes independence (less rigid).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "ar1", "options": [["AR(1) (auto-regressive, recommended)", "ar1", true], ["Exchangeable", "exchangeable", false], ["Independence", "independence", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "show_gee", "argument": null, "type": "select", "label": "GEE Method Options", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["Hide", "no", true], ["Show (only for GEE method)", "yes", false]], "display": "radio", "multiple": false, "textable": false}}]}, {"model_class": "Section", "name": "scheirer_ray_hare", "type": "section", "title": "Scheirer-Ray-Hare (Non-Parametric Testing)", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "srh_advanced", "argument": null, "type": "boolean", "label": "Enable Scheirer-Ray-Hare advanced options", "help": "Enable advanced tuning for Scheirer-Ray-Hare rank-based test (Westfall-Young permutations, effect size thresholds, permutation bounds).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "Conditional", "name": "srh_options", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "IntegerToolParameter", "name": "wy_randomizations", "argument": null, "type": "integer", "label": "Westfall-Young randomizations", "help": "Number of permutations for Westfall-Young multiple testing correction (default: 500). Higher values improve statistical accuracy but increase computation time. Use 'auto' mode to estimate from data.", "help_format": "html", "refresh_on_change": false, "min": 100, "max": 10000, "optional": false, "hidden": false, "is_dynamic": false, "value": "500", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "eta2_threshold_moderate", "argument": null, "type": "float", "label": "Moderate effect size threshold", "help": "Effect size (eta-squared) threshold for moderate effects (default: 0.01). Used to classify interaction strength: <0.01 = small, 0.01-0.1 = moderate, >0.1 = strong.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.01", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "eta2_threshold_strong", "argument": null, "type": "float", "label": "Strong effect size threshold", "help": "Effect size (eta-squared) threshold for strong effects (default: 0.1). Classification: <0.01 = small, 0.01-0.1 = moderate, >0.1 = strong effects.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.1", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "min_nperm", "argument": null, "type": "integer", "label": "Minimum permutations", "help": "Minimum number of permutations for rank-based test (default: 100). Lower bound for adaptive permutation testing.", "help_format": "html", "refresh_on_change": false, "min": 10, "max": 1000, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_nperm", "argument": null, "type": "integer", "label": "Maximum permutations", "help": "Maximum number of permutations for rank-based test (default: 10000). Upper bound for adaptive permutation testing.", "help_format": "html", "refresh_on_change": false, "min": 100, "max": 100000, "optional": false, "hidden": false, "is_dynamic": false, "value": "10000", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "configure_srh", "argument": null, "type": "select", "label": "SRH tuning", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["Use defaults", "no", true], ["Customize parameters", "yes", false]], "display": "radio", "multiple": false, "textable": false}}]}, {"model_class": "Section", "name": "jackknife_switching", "type": "section", "title": "Jackknife Isoform Switching (JIS) Detection", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "jis_use_sait_fdr", "argument": null, "type": "boolean", "label": "Use SAIT FDR for jackknife switching detection", "help": "Use SAIT FDR threshold to filter genes before jackknife isoform switching analysis. Enables two-stage approach: (1) identify genes with significant q \u00d7 condition interaction, (2) detect transcripts with robust switching patterns within those genes. Recommended for specificity.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "jis_advanced", "argument": null, "type": "boolean", "label": "Enable JIS advanced options", "help": "Enable advanced tuning for Jackknife Isoform Switching analysis (p-value thresholds, outlier percentiles).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "Conditional", "name": "jis_options", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "FloatToolParameter", "name": "jis_sait_p_threshold", "argument": null, "type": "float", "label": "JIS SAIT p-value threshold", "help": "P-value threshold for filtering genes in JIS analysis via SAIT results (default: 0.05). Genes with uncorrected p-values below this threshold are included in jackknife switching detection. Lower values (e.g., 0.01) increase stringency.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.05", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "jis_threshold", "argument": null, "type": "integer", "label": "JIS outlier percentile threshold", "help": "Percentile threshold for outlier detection on isoform relative influences (default: 90). Isoforms with influence above this percentile are considered influential for switching detection. Higher values (e.g., 95) focus on strongly influential isoforms.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": 100, "optional": false, "hidden": false, "is_dynamic": false, "value": "90", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "configure_jis", "argument": null, "type": "select", "label": "JIS tuning", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["Use defaults", "no", true], ["Customize parameters", "yes", false]], "display": "radio", "multiple": false, "textable": false}}]}, {"model_class": "Section", "name": "statistical_thresholds", "type": "section", "title": "Statistical Significance Thresholds", "help": null, "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "p_threshold", "argument": null, "type": "float", "label": "P-value threshold", "help": "Uncorrected p-value threshold for statistical tests. Typical: 0.05. Note: Used before multiple testing correction in parametric (SAIT) and rank-based (Scheirer-Ray-Hare) analyses.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.05", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "fdr_threshold", "argument": null, "type": "float", "label": "FDR threshold", "help": "False Discovery Rate (FDR) adjusted p-value threshold for controlling Type I error across multiple tests. Benjamini-Hochberg correction recommended. Typical: 0.05. Genes with adjusted p < FDR threshold are considered significant at specified false discovery rate.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.05", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "significance_threshold", "argument": null, "type": "float", "label": "General significance threshold", "help": "General significance level applied across all statistical tests when no specific correction is specified. Typical: 0.05 (5% Type I error rate). May also apply to interaction tests (q \u00d7 condition effects).", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.05", "area": false, "datalist": []}]}, {"model_class": "Section", "name": "divergence_testing", "type": "section", "title": "Divergence Analysis", "help": null, "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "divergence_ci", "argument": null, "type": "float", "label": "Divergence CI level", "help": "Confidence level for Tsallis divergence estimates measuring information-theoretic distance between conditions (default: 0.95 = 95% CI). Divergence measures scale-dependent differences in isoform complexity between groups.", "help_format": "html", "refresh_on_change": false, "min": 0.8, "max": 0.99, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.95", "area": false, "datalist": []}]}, {"model_class": "Section", "name": "quality_control", "type": "section", "title": "Quality Control & Sample Assessment", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "enable_m_estimator", "argument": null, "type": "boolean", "label": "Enable M-estimator robust sample QC", "help": "Enable M-estimator based sample quality assessment to detect influential outlier samples that may skew analyses. M-estimation provides robust quality metrics independent of distributional assumptions.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}]}, {"model_class": "Conditional", "name": "advanced_options", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "Section", "name": "q_parameters", "type": "section", "title": "Tsallis Entropy q-spectrum Parameters", "help": null, "expanded": true, "inputs": [{"model_class": "FloatToolParameter", "name": "q_min", "argument": null, "type": "float", "label": "Minimum q value", "help": "Minimum entropic index q. q=0 emphasizes rare isoforms (richness); q=1 gives Shannon entropy (balanced diversity); q\u21920 detects if diversity is maintained or collapsed across rare variants.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 3.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "q_max", "argument": null, "type": "float", "label": "Maximum q value", "help": "Maximum entropic index q. q=2 emphasizes dominant isoforms (Simpson index); high q is robust to rare variants and detects dominance shifts. Examine q-curves showing how results change across scales.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 3.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "2.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "q_step", "argument": null, "type": "float", "label": "q step size", "help": "Resolution of q-spectrum (smaller = more q-values, higher resolution curves, slower). Default 0.05 creates 41 q-values from 0 to 2. Smaller steps (e.g., 0.02) provide smoother q-curves for visualizing scale-dependent patterns.", "help_format": "html", "refresh_on_change": false, "min": 0.01, "max": 0.5, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.05", "area": false, "datalist": []}]}, {"model_class": "BooleanToolParameter", "name": "save_intermediates", "argument": null, "type": "boolean", "label": "Save analysis object", "help": "Save the TSENATAnalysis object as RDS for downstream R analysis", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "skip_unmapped", "argument": null, "type": "boolean", "label": "Skip unmapped transcripts", "help": "Skip transcripts not found in the annotation file (recommended: enabled). If disabled, analysis will fail if unmapped transcripts are present in Salmon files.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "enabled", "argument": null, "type": "select", "label": "Tsallis entropy calculation advanced options", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["No", "no", true], ["Yes", "yes", false]], "display": "radio", "multiple": false, "textable": false}}], "outputs": [{"model_class": "ToolOutput", "name": "diversity_results", "format": "tabular", "label": "TSENAT on ${on_string}: Diversity q-spectrum", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "diversity_results.tsv", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "diversity_spectrum", "format": "tabular", "label": "TSENAT on ${on_string}: Diversity q-spectrum summary", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "diversity_results_spectrum.tsv", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "sait_results", "format": "tabular", "label": "TSENAT on ${on_string}: SAIT results", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "sait_interaction_results.tsv", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "srh_results", "format": "tabular", "label": "TSENAT on ${on_string}: Scheirer-Ray-Hare test", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "srh_results.tsv", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "concordance_results", "format": "txt", "label": "TSENAT on ${on_string}: Concordance (LM vs rank-based)", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "concordance_results.tsv.txt", "edam_format": "format_2330", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "effect_sizes", "format": "tabular", "label": "TSENAT on ${on_string}: Effect sizes", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "