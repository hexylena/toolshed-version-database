{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/dada2_dada/dada2_dada/1.38.0+galaxy1", "name": "dada2: dada", "version": "1.38.0+galaxy1", "description": "Remove sequencing errors", "labels": [], "icon": null, "edam_operations": ["operation_3227", "operation_3200"], "edam_topics": ["topic_3174", "topic_3697", "topic_3168", "topic_0199"], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "dada2", "type": "bio.tools"}, {"value": "dada2", "type": "bioconductor"}], "versions": ["1.12+galaxy0", "1.12+galaxy1", "1.14+galaxy0", "1.18+galaxy0", "1.20+galaxy0", "1.20+galaxy1", "1.28+galaxy0", "1.30.0+galaxy0", "1.34.0+galaxy0", "1.34.0+galaxy1", "1.38.0+galaxy0", "1.38.0+galaxy1"], "hidden_versions": [], "tool_shed_repository": {"name": "dada2_dada", "owner": "iuc", "changeset_revision": "9010b9e13dec", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "Conditional", "name": "batch_cond", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "DataToolParameter", "name": "derep", "argument": "derep", "type": "data", "label": "Reads", "help": "despite the parameter name the sequences don't need to be dereplicated ", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fastq", "fastq.gz"], "edam": {"edam_formats": ["format_1930", "format_1930"], "edam_data": ["data_2044", "data_2044"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": [{"model_class": "DataToolParameter", "name": "derep", "argument": "derep", "type": "data", "label": "Reads", "help": "despite the parameter name the sequences don't need to be dereplicated ", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fastq", "fastq.gz"], "edam": {"edam_formats": ["format_1930", "format_1930"], "edam_data": ["data_2044", "data_2044"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "pool", "argument": "pool", "type": "select", "label": "Pool samples", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "FALSE", "options": [["process samples individually", "FALSE", false], ["pool samples", "TRUE", false], ["pseudo pooling between individually processed samples", "pseudo", false]], "display": null, "multiple": false, "textable": false}]}], "test_param": {"model_class": "SelectToolParameter", "name": "batch_select", "argument": null, "type": "select", "label": "Process samples in batches", "help": "process samples jointly (default) or in independent jobs (see also below)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["no", "no", false], ["yes", "yes", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "DataToolParameter", "name": "err", "argument": "err", "type": "data", "label": "Error rates", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["dada2_errorrates"], "edam": {"edam_formats": ["format_2333"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Conditional", "name": "advanced", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "DataToolParameter", "name": "priors", "argument": "priors", "type": "data", "label": "Priors", "help": "The priors argument provides a set of sequences for which there is prior information suggesting they may truly exist, i.e. are not errors. The abundance p-value of dereplicated sequences that exactly match one of the priors are calculated without conditioning on presence, allowing singletons to be detected, and are compared to a reduced threshold \u2018OMEGA_P\u2018 when forming new partitions.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fastq", "fastq.gz", "dada2_dada", "dada2_mergepairs", "tabular", "dada2_sequencetable", "dada2_uniques"], "edam": {"edam_formats": ["format_1929", "format_1930", "format_1930", "format_2333", "format_2333", "format_3475", "format_3475", "format_3475"], "edam_data": ["data_2044", "data_2044", "data_2044", "data_0006", "data_0006", "data_0006", "data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Section", "name": "sensitivity", "type": "section", "title": "Sensitivity", "help": null, "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "OMEGA_A", "argument": "OMEGA_A", "type": "float", "label": "Omega A", "help": "Threshold for calling unique sequences significantly overabundant, and therefore creating a new partition with that sequence as the center. Default is 1e-40, which is a conservative setting to avoid making false positive inferences, but which comes at the cost of reducing the ability to identify some rare variants.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "1e-40", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "OMEGA_P", "argument": "OMEGA_P", "type": "float", "label": "Omega P", "help": "Threshold for unique sequences with prior evidence of existence (see \u2018priors\u2018 argument)", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0001", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "OMEGA_C", "argument": "OMEGA_C", "type": "float", "label": "Omega C", "help": "Threshold at which unique sequences inferred to contain errors are corrected in the final output. The probability that each unique sequence is generated at its observed abundance from the center of its final partition is evaluated, and compared to OMEGA_C. If that probability is >= OMEGA_C, it is 'corrected', i.e. replaced by the partition center sequence. The special value of 0 corresponds to correcting all input sequences, and any value > 1 corresponds to performing no correction on sequences found to contain error", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "1e-40", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "DETECT_SINGLETONS", "argument": "DETECT_SINGLETONS", "type": "boolean", "label": "Detect singletons", "help": "et to TRUE, this removes the requirement for at least two reads with the same sequences to exist in order for a new ASV to be detected. It also somewhat increases sensitivity to other low abundance sequences as well, e.g. those present in just 2/3/4/... reads. Note, this applies to all unique sequences, not just those supported by prior evidence (see \u2018priors\u2018 argument), and so it does make false-positive detections more likely.When enabled, singleton sequences are retained in the output", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "TRUE", "falsevalue": "FALSE"}]}, {"model_class": "Section", "name": "alignment", "type": "section", "title": "Alignment", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "MATCH", "argument": "MATCH", "type": "integer", "label": "Match score", "help": "Score of a match in the Needleman-Wunsch alignment", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "4", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "MISMATCH", "argument": "MISMATCH", "type": "integer", "label": "Mismatch penalty", "help": "Cost of a mismatch in the Needleman-Wunsch alignmenmt", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "-5", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "GAP_PENALTY", "argument": "GAP_PENALTY", "type": "integer", "label": "Gap penalty", "help": "Cost of gaps in the Needleman-Wunsch alignment", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "-8", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "HOMOPOLYMER_GAP_PENALTY", "argument": "HOMOPOLYMER_GAP_PENALTY", "type": "text", "label": "Homopolymer gap penalty", "help": "e cost of gaps in homopolymer regions (>=3 repeated bases). If not specified homopolymer gaps are treated as normal gaps.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "BAND_SIZE", "argument": "BAND_SIZE", "type": "integer", "label": "Band size", "help": "When set, banded Needleman-Wunsch alignments are performed. Banding restricts the net cumulative number of insertion of one sequence relative to the other. The default value of BAND_SIZE is 16. If DADA is applied to sequencing technologies with high rates of indels, such as 454 sequencing, the BAND_SIZE parameter should be increased. Setting BAND_SIZE to a negative number turns off banding (i.e. full Needleman-Wunsch", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": "16", "area": false, "datalist": []}]}, {"model_class": "Section", "name": "comparison_heuristics", "type": "section", "title": "Sequence comparison heuristics", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "USE_KMERS", "argument": "USE_KMERS", "type": "boolean", "label": "K\u2011mers", "help": "If enabled, a 5-mer distance screen is performed prior to performing each pairwise alignment, and if the 5mer-distance is greater than KDIST_CUTOFF, no alignment is performed", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}, {"model_class": "FloatToolParameter", "name": "KDIST_CUTOFF", "argument": "KDIST_CUTOFF", "type": "float", "label": "K\u2011dist cutoff", "help": "The default value of 0.42 was chosen to screen pairs of sequences that differ by >10%, and was calibrated on Illumina sequenced 16S amplicon data. The assumption is that sequences that differ by such a large amount cannot be linked by amplicon errors (i.e. if you sequence one, you won\u2019t get a read of other) and so careful (and costly) alignment is unnecessary", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.42", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "GAPLESS", "argument": "GAPLESS", "type": "boolean", "label": "Perform gapless alignment", "help": "If enabled, the ordered kmer identity between pairs of sequences is compared to their unordered overlap. If equal, the optimal alignment is assumed to be gapless. Only relevant if USE_KMERS is enabled", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}, {"model_class": "BooleanToolParameter", "name": "GREEDY", "argument": "GREEDY", "type": "boolean", "label": "Enable greedy partitioning", "help": "The DADA2 algorithm is not greedy, but a very restricted form of greediness can be turned on via this option. If TRUE, unique sequences with reads less than those expected to be generated by resequencing just the central unique in their partition are 'locked' to that partition. Modest (~30%) speedup, and almost no impact on output", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}]}, {"model_class": "Section", "name": "new_partition", "type": "section", "title": "New partition conditions", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "MIN_FOLD", "argument": "MIN_FOLD", "type": "integer", "label": "Min fold-overabundance", "help": "Minimum fold-overabundance for sequences to form new partitions. ", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "MIN_HAMMING", "argument": "MIN_HAMMING", "type": "integer", "label": "Minimum hamming separation", "help": "Minimum hamming-separation for sequences to form new partitions. Default value is 1, which means this criteria is ignored", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "MIN_ABUNDANCE", "argument": "MIN_ABUNDANCE", "type": "integer", "label": "Minimum abundance", "help": "Minimum abundance for unique sequences form new partition", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "MAX_CLUST", "argument": "MAX_CLUST", "type": "integer", "label": "Maximum number of partitions", "help": "Once this many partitions have been created, the algorithm terminates regardless of whether the statistical model suggests more real sequence variants exist. If set to 0 this argument is ignored. Default value is 0", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0", "area": false, "datalist": []}]}, {"model_class": "Section", "name": "pseudo", "type": "section", "title": "pseudo-pooling behavior", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "PSEUDO_PREVALENCE", "argument": "PSEUDO_PREVALENCE", "type": "integer", "label": "Pseudo pooling prevalence", "help": "All sequence variants found in at least this many samples are used as priors for a subsequent round of sample inference", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "2", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "PSEUDO_ABUNDANCE", "argument": "PSEUDO_ABUNDANCE", "type": "float", "label": "Pseudo pooling abundance", "help": "All denoised sequence variants with total abundance (over all samples) greater than this are used as priors for a subsequent round of sample inference. Default is to ignore abundance for this purpose.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "enable", "argument": null, "type": "select", "label": "Set advanced options", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["Yes", "yes", false], ["No", "no", true]], "display": null, "multiple": false, "textable": false}}], "outputs": [{"model_class": "ToolOutputCollection", "name": "data_collection", "format": null, "label": "${tool.name} on ${on_string}: outputs", "hidden": false, "output_type": "collection", "default_format": "data", "format_source": null, "metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "dada2_dada", "visible": false, "assign_primary_output": false, "directory": "output", "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<name>.+)\\.dada2_dada"}]}}, {"model_class": "ToolOutput", "name": "dada", "format": "dada2_dada", "label": "${tool.name} on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_2333", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "metagenomic_analysis", "panel_section_name": "Metagenomic Analysis", "form_style": "regular"}