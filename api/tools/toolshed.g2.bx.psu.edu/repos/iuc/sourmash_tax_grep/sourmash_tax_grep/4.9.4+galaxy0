{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/sourmash_tax_grep/sourmash_tax_grep/4.9.4+galaxy0", "name": "sourmash tax grep", "version": "4.9.4+galaxy0", "description": "searches taxonomies for matching strings", "labels": [], "icon": null, "edam_operations": ["operation_0289", "operation_0346"], "edam_topics": ["topic_3307"], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "sourmash", "type": "bio.tools"}], "versions": ["4.9.4+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "sourmash_tax_grep", "owner": "iuc", "changeset_revision": "2478c4098f51", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "taxonomy_files", "argument": "--taxonomy", "type": "data", "label": "taxonomy CSV Files or SQLite database", "help": "One or more properly formatted taxonomy files (CSV or SQLite). sourmash also supports LIN and ICTV lineage information in compatible taxonomy files.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["csv", "sqlite"], "edam": {"edam_formats": ["format_3475", "format_3621"], "edam_data": ["data_0006", "data_0006"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "TextToolParameter", "name": "pattern", "argument": null, "type": "text", "label": "Pattern", "help": "Pattern is a regular expression. Note: tax grep only searches taxonomic ranks, not identifier strings.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "rank", "argument": null, "type": "select", "label": "Rank", "help": "Restrict query to this rank. Note that the taxonomy CSV must contain lineage in