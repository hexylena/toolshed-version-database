{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/hyphaeon_meme/hyphaeon_meme/0.1.1+galaxy0", "name": "HyphAeon-MEME", "version": "0.1.1+galaxy0", "description": "Episodic positive selection inference (HyphAeon Transformer)", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.1.1+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "hyphaeon_meme", "owner": "iuc", "changeset_revision": "5c223e491b89", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_file", "argument": null, "type": "data", "label": "Input codon alignment", "help": "An in-frame codon alignment in FASTA or NEXUS format", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz", "nex"], "edam": {"edam_formats": ["format_1929", "format_1929", "format_1912"], "edam_data": ["data_2044", "data_2044", "data_0872"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "input_tree", "argument": null, "type": "data", "label": "Phylogenetic tree (optional)", "help": "Newick or NEXUS tree. If omitted, HyphAeon will extract a tree from the alignment if embedded, or estimate one.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["newick", "nhx", "nex"], "edam": {"edam_formats": ["format_1910", "format_1910", "format_1912"], "edam_data": ["data_0872", "data_0872", "data_0872"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "BooleanToolParameter", "name": "no_tree", "argument": null, "type": "boolean", "label": "Skip tree (use TN93 pairwise distances)", "help": "Skip phylogenetic tree usage and estimate pairwise evolutionary distances directly from the alignment using TN93. Overrides any provided tree.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--no-tree", "falsevalue": ""}, {"model_class": "Conditional", "name": "model_source", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "hub", "inputs": [{"model_class": "TextToolParameter", "name": "model_variant", "argument": "--model-variant", "type": "text", "label": "Model variant", "help": "Which model variant to download from Hugging Face Hub (datamonkey/hyphaeon). To see all available variants, run the 'HyphAeon List Models' tool first, then copy the variant name here.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "general", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "local", "inputs": [{"model_class": "DataToolParameter", "name": "weights", "argument": "--weights", "type": "data", "label": "Local model weights file (.pt)", "help": "A PyTorch .pt checkpoint file containing model weights and architecture config.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["binary"], "edam": {"edam_formats": ["format_2333"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "source_type", "argument": null, "type": "select", "label": "Model weights source", "help": "Download a model variant from Hugging Face Hub, or provide a local weights file.", "help_format": "