{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/hyphaeon_splits/hyphaeon_splits/0.1.1+galaxy0", "name": "HyphAeon-Splits", "version": "0.1.1+galaxy0", "description": "Phylogenetic split inference via spectral graph bisection of cross-taxa attention", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.1.1+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "hyphaeon_splits", "owner": "iuc", "changeset_revision": "a9e2ba068e99", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_file", "argument": null, "type": "data", "label": "Input codon alignment", "help": "An in-frame codon alignment in FASTA or NEXUS format", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz", "nex"], "edam": {"edam_formats": ["format_1929", "format_1929", "format_1912"], "edam_data": ["data_2044", "data_2044", "data_0872"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "input_tree", "argument": null, "type": "data", "label": "Phylogenetic tree (optional)", "help": "Newick or NEXUS tree. If omitted, HyphAeon will extract a tree from the alignment if embedded, or estimate one.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["newick", "nhx", "nex"], "edam": {"edam_formats": ["format_1910", "format_1910", "format_1912"], "edam_data": ["data_0872", "data_0872", "data_0872"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Boolean