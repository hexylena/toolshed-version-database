{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/fixed2tab/fixed2tab/0.1.0+galaxy0", "name": "fixed2tab", "version": "0.1.0+galaxy0", "description": "convert fixed-width text to tabular", "labels": [], "icon": null, "edam_operations": ["operation_0335"], "edam_topics": ["topic_3365"], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.1.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "fixed2tab", "owner": "iuc", "changeset_revision": "ca5bea00e80a", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input", "argument": "--input", "type": "data", "label": "Fixed-width text file", "help": "Do not upload it with 'convert spaces to tabs': that destroys the column positions.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Conditional", "name": "geometry", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "auto", "inputs": []}, {"model_class": "ConditionalWhen", "value": "columns", "inputs": [{"model_class": "TextToolParameter", "name": "columns", "argument": "--columns", "type": "text", "label": "Column ranges", "help": "START-END[:NAME] separated by commas, for example 1-12:DATE,18-27:BEST_TIME. Positions start at 1, and both ends are included. The report of an earlier run prints this string: copy the part between the quotes.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "widths", "inputs": [{"model_class": "TextToolParameter", "name": "widths", "argument": "--widths", "type": "text", "label": "Column widths", "help": "Read from position 1: N takes the next N positions as a column, N:NAME does the same and names it, and Nx skips N positions. For example 12:DATE,5x,10:BEST_TIME. A FORTRAN FORMAT such as 2X,I5,2X,F8.3 transcribes directly to 2x,5,2x,8.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "mode", "argument": null, "type": "select", "label": "Column boundaries", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "auto", "options": [["Detect automatically", "auto", true], ["Give the column ranges (--columns)", "columns", false], ["Give the column widths (--widths)", "widths", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Section", "name": "detection", "type": "section", "title": "Detection", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "min_gutter", "argument": "--min-gutter", "type": "integer", "label": "Blank positions that separate two columns", "help": "Lower values give more columns, because a smaller blank run separates two columns. Higher values merge narrow columns.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "2", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "record_width", "argument": "--record-width", "type": "integer", "label": "Record width", "help": "Leave empty to detect it. Set it for a file whose trailing blanks were stripped.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "header_line", "argument": "--header-line", "type": "integer", "label": "Line with the column headings", "help": "Leave empty to detect it. Lines 1 to N are preamble and are not converted. 0 means that the file has no preamble. Required when short lines are padded.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "Section", "name": "reading", "type": "section", "title": "Reading", "help": null, "expanded": false, "inputs": [{"model_class": "SelectToolParameter", "name": "encoding", "argument": "--encoding", "type": "select", "label": "Input encoding", "help": "Try latin-1 for byte-padded legacy output.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "utf-8", "options": [["UTF-8", "utf-8", true], ["Latin-1 (ISO-8859-1)", "latin-1", false], ["Windows-1252", "cp1252", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "short_lines", "argument": "--short-lines", "type": "select", "label": "Lines shorter than the record width", "help": "Padding can make page numbers and footers into data rows, so rejecting is the default.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "reject", "options": [["Reject them", "reject", true], ["Pad them with spaces", "pad", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "Section", "name": "output_shape", "type": "section", "title": "Output shape", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "collapse_spaces", "argument": "--collapse-spaces", "type": "boolean", "label": "Reduce runs of spaces inside each cell to one space", "help": "Applies to every cell.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--collapse-spaces", "falsevalue": ""}, {"model_class": "SelectToolParameter", "name": "header", "argument": "--header", "type": "select", "label": "Header row in the table", "help": "The column names are always in the report. A header row shifts the row positions by one for later steps.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["No header row", "none", true], ["Column names as the first row", "plain", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "Conditional", "name": "strictness", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "off", "inputs": []}, {"model_class": "ConditionalWhen", "value": "strict", "inputs": [{"model_class": "SelectToolParameter", "name": "allow_rejects", "argument": "--allow-rejects", "type": "select", "label": "Rejection reasons to tolerate", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["length", "length", false], ["control-char", "control-char", false], ["preamble-identity", "preamble-identity", false], ["rule-line", "rule-line", false]], "display": null, "multiple": true, "textable": false}]}], "test_param": {"model_class": "SelectToolParameter", "name": "mode", "argument": null, "type": "select", "label": "Fail the job when lines are rejected?", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "off", "options": [["No", "off", true], ["Yes (--strict)", "strict", false]], "display": null, "multiple": false, "textable": false}}], "outputs": [{"model_class": "ToolOutput", "name": "table", "format": "tabular", "label": "${tool.name} on ${on_string}: table", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "report", "format": "txt", "label": "${tool.name} on ${on_string}: report", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_2330", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "rejected", "format": "tabular", "label": "${tool.name} on ${on_string}: rejected lines", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "text_manipulation", "panel_section_name": "Text Manipulation", "form_style": "regular"}