{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/clipkit/clipkit/2.14.0+galaxy0", "name": "ClipKIT", "version": "2.14.0+galaxy0", "description": "trim multiple sequence alignments while retaining phylogenetically informative sites", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "clipkit", "type": "bio.tools"}], "versions": ["2.13.2+galaxy0", "2.14.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "clipkit", "owner": "iuc", "changeset_revision": "9bdf73d60011", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input", "argument": "--input", "type": "data", "label": "Multiple sequence alignment", "help": "Input alignment file. ClipKIT auto-detects the format if no input format is specified below.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "clustal", "phylip", "stockholm", "maf", "xmfa"], "edam": {"edam_formats": ["format_1929", "format_2330", "format_1997", "format_1961", "format_3008", "format_2330"], "edam_data": ["data_2044", "data_0006", "data_0863", "data_0863", "data_0863", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "mode", "argument": "--mode", "type": "select", "label": "Trimming mode", "help": "Algorithm used to identify sites to trim. Leave unset to use ClipKIT's default (smart-gap).", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["ClipKIT default (smart-gap)", "", false], ["smart-gap (dynamic gap threshold)", "smart-gap", false], ["gappy (trim sites above gap threshold)", "gappy", false], ["block-gappy (trim contiguous gappy regions)", "block-gappy", false], ["gappyout (gap-distribution-inferred threshold)", "gappyout", false], ["entropy (trim by Shannon entropy)", "entropy", false], ["composition-bias", "composition-bias", false], ["heterotachy", "heterotachy", false], ["kpic (keep parsimony informative + constant)", "kpic", false], ["kpic-smart-gap", "kpic-smart-gap", false], ["kpic-gappy", "kpic-gappy", false], ["kpi (keep parsimony informative only)", "kpi", false], ["kpi-smart-gap", "kpi-smart-gap", false], ["kpi-gappy", "kpi-gappy", false], ["cst (custom sites; requires auxiliary file)", "cst", false], ["c3 (remove every third codon position)", "c3", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "gaps", "argument": "--gaps", "type": "float", "label": "Threshold value (-g)", "help": "For gappy/block-gappy/kpi-gappy/kpic-gappy this is the gap fraction (default 0.9). For entropy/composition-bias/heterotachy this is reinterpreted as that score's threshold (default 0.8). Ignored by smart-gap, kpi-smart-gap, kpic-smart-gap, gappyout, kpi, kpic, cst, and c3.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "sequence_type", "argument": "--sequence_type", "type": "select", "label": "Sequence type", "help": "Leave unset to auto-detect.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["Auto-detect", "", false], ["Amino acid", "aa", false], ["Nucleotide", "nt", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "ambiguity_handling", "argument": "--ambiguity_handling", "type": "select", "label": "IUPAC ambiguity handling", "help": "How recognized IUPAC ambiguity symbols contribute to trimming statistics. Configured gap characters take precedence, and alignment symbols are never rewritten in the output.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "missing", "options": [["missing - exclude from entropy, composition and KPI/KPIC state counts; count toward the unavailable fraction in gap-based modes (ClipKIT default)", "missing", true], ["fractional - distribute each symbol equally among its possible states for entropy and composition, but exclude it from KPI/KPIC classification", "fractional", false], ["literal - treat each ambiguity code as its own state (legacy behaviour, pre-2.14.0)", "literal", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "input_file_format", "argument": "--input_file_format", "type": "select", "label": "Input file format", "help": "Leave unset to auto-detect.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["Auto-detect", "", false], ["fasta", "fasta", false], ["clustal", "clustal", false], ["maf", "maf", false], ["mauve", "mauve", false], ["phylip", "phylip", false], ["phylip_sequential", "phylip_sequential", false], ["phylip_relaxed", "phylip_relaxed", false], ["stockholm", "stockholm", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "output_file_format", "argument": "--output_file_format", "type": "select", "label": "Output file format", "help": "Leave unset to match the input format.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["Same as input", "", false], ["fasta", "fasta", false], ["clustal", "clustal", false], ["maf", "maf", false], ["mauve", "mauve", false], ["phylip", "phylip", false], ["phylip_sequential", "phylip_sequential", false], ["phylip_relaxed", "phylip_relaxed", false], ["stockholm", "stockholm", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "TextToolParameter", "name": "gap_characters", "argument": "--gap_characters", "type": "text", "label": "Gap characters", "help": "Characters to treat as gaps (e.g. 'NnXx-?'). The first character cannot be '-'. Leave empty to use defaults (aa: Xx-?*, nt: XxNn-?*).", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "DataToolParameter", "name": "auxiliary_file", "argument": "--auxiliary_file", "type": "data", "label": "Auxiliary file (cst mode)", "help": "Tab-delimited file with '<position>\\ttrim|keep' per line. Required when mode is set to 'cst'.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt", "tabular"], "edam": {"edam_formats": ["format_2330", "format_3475"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "BooleanToolParameter", "name": "codon", "argument": "--codon", "type": "boolean", "label": "Codon-aware trimming (-co)", "help": "If any of the three positions in a codon would be trimmed, trim the whole codon.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-co", "falsevalue": ""}, {"model_class": "SelectToolParameter", "name": "remove_stop_codons", "argument": "--remove_stop_codons", "type": "select", "label": "Mask in-frame stop codons", "help": "Masks selected in-frame stop codons as '---' before gap statistics and trimming. Requires nucleotide input, 'Codon-aware trimming' enabled above, and an alignment length divisible by three - the job fails otherwise.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "options": [["Do not mask stop codons", "", true], ["terminal - only the stop at the final complete non-gap codon of each sequence", "terminal", false], ["internal - all other in-frame stop codons", "internal", false], ["all - terminal and internal", "all", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "ends_only", "argument": "--ends_only", "type": "boolean", "label": "Trim only from the alignment ends (-eo)", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-eo", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "complementary", "argument": "--complementary", "type": "boolean", "label": "Also output complementary alignment (-c)", "help": "Writes a second alignment containing the trimmed-out sites.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-c", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "log_out", "argument": null, "type": "boolean", "label": "Output per-site log file (-l)", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "report_json_out", "argument": null, "type": "boolean", "label": "Output run summary as JSON (--report_json)", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "plot_report_out", "argument": null, "type": "boolean", "label": "Output interactive HTML trim report (--plot_trim_report)", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "data", "label": "${tool.name} on ${on_string}: trimmed alignment", "hidden": false, "output_type": "data", "format_source": "input", "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_1915", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "log", "format": "tabular", "label": "${tool.name} on ${on_string}: log", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "complement", "format": "data", "label": "${tool.name} on ${on_string}: complementary alignment", "hidden": false, "output_type": "data", "format_source": "input", "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_1915", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "report_json", "format": "json", "label": "${tool.name} on ${on_string}: report (JSON)", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3464", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "plot_report", "format": "html", "label": "${tool.name} on ${on_string}: trim report (HTML)", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_2331", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "annotation", "panel_section_name": "Annotation", "form_style": "regular"}