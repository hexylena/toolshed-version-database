ormat": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "log", "options": [["linear", "linear", false], ["log", "log", true]], "display": null, "multiple": false, "textable": false}, {"model_class": "TextToolParameter", "name": "pe_label", "argument": "--pe-label", "type": "text", "label": "PE analysis (label)", "help": "PE label used to select posterior samples and metadata. If omitted and --waveform-engine is provided, the tool selects the closest PE label by substring match in the PE label. If both are omitted: the Mixed label for the posteriors, and for the strain overlay the IMRPhenomXPHM label when the Mixed one has no PSD.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "waveform_engine", "argument": "--waveform-engine", "type": "text", "label": "Waveform model of the overlay", "help": "Waveform engine used to generate a time-domain waveform for strain overlay. If omitted, a sensible default engine is used for overlays.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "no_skymap_3d", "argument": "--no-skymap-3d", "type": "boolean", "label": "Skip the 3D sky map", "help": "Skip the 3D sky map (FITS map of the Zenodo skymap archive: credible volume, distance by direction, host-galaxy candidates).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--no-skymap-3d", "falsevalue": ""}, {"model_class": "Conditional", "name": "galaxies", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "glade", "inputs": []}, {"model_class": "ConditionalWhen", "value": "none", "inputs": []}, {"model_class": "Condition