{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/lemur/lemur/1.8.0+galaxy0", "name": "LEMUR", "version": "1.8.0+galaxy0", "description": "Multi-condition single-cell latent modeling analysis", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.8.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "lemur", "owner": "iuc", "changeset_revision": "ea4378e0b5ff", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "sce", "argument": null, "type": "data", "label": "SingleCellExperiment object (RDS)", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["rds"], "edam": {"edam_formats": ["format_2333"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "meta_table", "argument": null, "type": "data", "label": "Sample metadata table (TSV)", "help": "Tabular file with one row per sample/cell. Must contain columns for condition and optionally for batch or covariates.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "ColumnListParameter", "name": "cell_id_column", "argument": null, "type": "data_column", "label": "Cell ID column", "help": "Column in metadata that contains the cell IDs matching colnames of SCE", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false, "data_ref": "meta_table", "numerical": false}, {"model_class": "ColumnListParameter", "name": "condition_column", "argument": null, "type": "data_column", "label": "Condition column", "help": "Any metadata column with two or more levels (e.g. treatment, batch, timepoint, genotype), not only a treatment variable. The comparison is built from the two values you enter in 'Condition for contrast' and 'Reference condition' below.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false, "data_ref": "meta_table", "numerical": false}, {"model_class": "ColumnListParameter", "name": "covariate_columns", "argument": null, "type": "data_column", "label": "Covariate columns (optional)", "help": "Optional covariate variables to add to the LEMUR design formula, in addition to the condition (e.g. batch, sex, age). These affect the model fit only; the replication unit used for the differential expression test is set separately below.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": true, "textable": false, "data_ref": "meta_table", "numerical": false}, {"model_class": "ColumnListParameter", "name": "group_by_columns", "argument": null, "type": "data_column", "label": "Group-by column(s) for differential expression", "help": "Metadata column(s) defining the replication unit that find_de_neighborhoods uses to form pseudobulk samples (e.g. patient or sample ID). Required. The condition and any design covariates are added automatically, so select only the replication variable(s) here.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": true, "textable": false, "data_ref": "meta_table", "numerical": false}, {"model_class": "TextToolParameter", "name": "contrast_condition", "argument": null, "type": "text", "label": "Condition for contrast (e.g. treatment)", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "treatment", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "reference_condition", "argument": null, "type": "text", "label": "Reference condition (e.g. control)", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "ctrl", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "n_embedding", "argument": null, "type": "integer", "label": "Number of latent dimensions (embedding)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "15", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "test_fraction", "argument": null, "type": "float", "label": "The fraction of cells that are split off before the model fit to keep an independent set of test observations", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0.01, "max": 0.9, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.2", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "linear_coefficient_estimator", "argument": null, "type": "select", "label": "Linear coefficient estimator", "help": "Estimator used to center the conditions in the linear model fit.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "linear", "options": [["linear", "linear", true], ["mean", "mean", false], ["cluster_median", "cluster_median", false], ["zero", "zero", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "TextToolParameter", "name": "use_assay", "argument": null, "type": "text", "label": "Assay to use for model fitting", "help": "Name of the SCE assay used for LEMUR model fitting (also used as the continuous assay by the 'limma' DE method). The 'glmGamPoi' and 'edgeR' DE methods instead read the raw 'counts' assay, so a counts assay is required unless the DE test method is set to 'limma'.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "logcounts", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "consider", "argument": null, "type": "select", "label": "Model parts considered for the DE test", "help": "Which part of the model is considered for the differential expression test. Note: 'linear' can fail in find_de_neighborhoods with the default direction-selection setting, because the DE assay then has no embedding-dependent variation, making the correlation against random directions undefined.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "embedding+linear", "options": [["embedding+linear", "embedding+linear", true], ["embedding", "embedding", false], ["linear", "linear", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "test_method", "argument": null, "type": "select", "label": "Pseudobulk DE test method", "help": "Statistical method for the pseudobulk differential expression test in find_de_neighborhoods. 'glmGamPoi' and 'edgeR' operate on the raw 'counts' assay; 'limma' operates on the continuous assay (see 'Assay to use for model fitting'). 'none' skips this test entirely: the exported DE table then has no lfc/pval/adj_pval columns, and the volcano plot is not produced.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "glmGamPoi", "options": [["glmGamPoi", "glmGamPoi", true], ["edgeR", "edgeR", false], ["limma", "limma", false], ["none", "none", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "use_harmony", "argument": null, "type": "boolean", "label": "Apply Harmony alignment?", "help": "Enforces additional alignment of cell clusters beyond the direct differential embedding.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "yes", "falsevalue": "no"}, {"model_class": "TextToolParameter", "name": "sel_gene", "argument": null, "type": "text", "label": "Gene ID for gene-specific plots (optional)", "help": "Must match a gene ID in the rownames of the SCE object.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "plot_format", "argument": null, "type": "select", "label": "Plot format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "pdf", "options": [["PDF", "pdf", true], ["PNG", "png", false], ["JPG", "jpg", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "plot_width", "argument": null, "type": "float", "label": "Plot width (in cm)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "15.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "plot_height", "argument": null, "type": "float", "label": "Plot height (in cm)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "12.0", "area": false, "datalist": []}, {"model_class": "Conditional", "name": "tumor_analysis_cond", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "TextToolParameter", "name": "tumor_annotation_column", "argument": null, "type": "text", "label": "Gene annotation column (in rowData)", "help": "Name of the gene-level (rowData) annotation column that assigns each gene to a chromosome, used to compute per-chromosome expression for tumor classification. Default is 'chromosome'. Override if your SCE uses a different rowData column name.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "chromosome", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "chrom1_name", "argument": null, "type": "text", "label": "Chromosome expected to be gained in tumor cells", "help": "Name/ID of the chromosome expected to show increased expression ('gain') in tumor cells, as it appears in the gene annotation column above. This whole-chromosome gain/loss classification applies to any condition with known chromosome-arm-level copy number alterations (for example glioblastoma, where chromosome 7 is typically gained \u2014 the default) \u2014 confirm this pattern applies to your dataset before using it.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "7", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "chrom2_name", "argument": null, "type": "text", "label": "Chromosome expected to be lost in tumor cells", "help": "Name/ID of the chromosome expected to show decreased expression ('loss') in tumor cells, as it appears in the gene annotation column above (default: chromosome 10, matching the glioblastoma example of chromosome 10 loss). This applies to any condition with known chromosome-arm-level copy number alterations; as with the gained chromosome, confirm this pattern applies to your dataset.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "10", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "chrom1_thresh", "argument": null, "type": "float", "label": "Minimum expression threshold for the gained chromosome", "help": "Minimum mean expression of the gained chromosome (above) required to classify a cell as tumor.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.8", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "chrom2_thresh", "argument": null, "type": "float", "label": "Maximum expression threshold for the lost chromosome", "help": "Maximum mean expression of the lost chromosome (above) required to classify a cell as tumor.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "2.5", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "no", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "run_tumor_analysis", "argument": null, "type": "select", "label": "Run tumor-specific classification (chromosome-based)", "help": "Optional: classifies cells as tumor/non-tumor based on chromosome gain/loss (as in the glioblastoma example). Not applicable to all datasets \u2014 enable only if relevant to your data.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["No", "no", true], ["Yes", "yes", false]], "display": null, "multiple": false, "textable": false}}], "outputs": [{"model_class": "ToolOutput", "name": "umap_plot", "format": "pdf", "label": "${tool.name} on ${on_string}: UMAP plot", "hidden": false, "output_type": "data", "format_source": null, "default_i