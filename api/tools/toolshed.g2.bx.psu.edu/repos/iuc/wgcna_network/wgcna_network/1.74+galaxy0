{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/wgcna_network/wgcna_network/1.74+galaxy0", "name": "WGCNA", "version": "1.74+galaxy0", "description": "Weighted Gene Co-expression Network Analysis", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.74+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "wgcna_network", "owner": "iuc", "changeset_revision": "3df546341aab", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "counts_file", "argument": null, "type": "data", "label": "Counts matrix", "help": "Genes as rows, samples as columns. First column must be gene IDs.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "metadata_file", "argument": null, "type": "data", "label": "Sample metadata", "help": "First column should be sample name. Trait columns can be numeric or categorical.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "softpower_config", "argument": null, "type": "data", "label": "Soft-thresholding config", "help": "Config file output from the 'WGCNA: Soft-Thresholding Power' tool. If provided, soft power is read automatically and the manual value below is ignored.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "IntegerToolParameter", "name": "soft_power", "argument": null, "type": "integer", "label": "Soft-thresholding power (used only if no config file is provided)", "help": "Ignored when a soft-thresholding config file is supplied above.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 30, "optional": false, "hidden": false, "is_dynamic": false, "value": "6", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "network_type", "argument": null, "type": "select", "label": "Network type", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "unsigned", "options": [["Unsigned", "unsigned", true], ["Signed", "signed", false], ["Signed hybrid", "signed hybrid", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "tom_type", "argument": null, "type": "select", "label": "TOM type", "help": "Should match the network type. Signed TOM is recommended when using a signed network.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "signed", "options": [["Signed (recommended)", "signed", true], ["Unsigned", "unsigned", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "cor_type", "argument": null, "type": "select", "label": "Correlation type", "help": "Pearson correlation is the standard choice. Biweight midcorrelation (bicor) is a robust alternative that is less sensitive to outlier samples.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "pearson", "options": [["Pearson", "pearson", true], ["Biweight midcorrelation (bicor)", "bicor", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "min_module_size", "argument": null, "type": "integer", "label": "Minimum module size", "help": "Minimum number of genes required to form a module.", "help_format": "html", "refresh_on_change": false, "min": 5, "max": 500, "optional": false, "hidden": false, "is_dynamic": false, "value": "30", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "merge_cut_height", "argument": null, "type": "float", "label": "Module merge cut height", "help": "Modules with eigengene correlation above (1 - this value) will be merged.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.25", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "me_cor_threshold", "argument": null, "type": "float", "label": "Module eigengene network correlation threshold", "help": "Minimum |correlation| between module eigengenes required to draw an edge in the module eigengene network (Step 10). If no module pairs pass this threshold, the tool automatically retries at half this value.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "log_transform", "argument": null, "type": "boolean", "label": "Apply log2(count + 1) transformation?", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}, {"model_class": "BooleanToolParameter", "name": "filter_by_variance", "argument": null, "type": "boolean", "label": "Filter low-variance genes?", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}, {"model_class": "FloatToolParameter", "name": "variance_quantile", "argument": null, "type": "float", "label": "Variance filter quantile", "help": "Genes below this variance percentile are removed (default 0.4, bottom 40%). Used only when filtering is enabled.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.4", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "run_sample_gene_qc", "argument": null, "type": "boolean", "label": "Run WGCNA sample/gene QC filtering", "help": "Use goodSamplesGenes to remove samples or genes that fail WGCNA checks.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "TRUE", "falsevalue": "FALSE"}, {"model_class": "ColumnListParameter", "name": "trait_columns", "argument": null, "type": "data_column", "label": "Metadata trait columns", "help": "Select one or more trait columns from the metadata file. Numeric columns are used as-is; categorical columns are one-hot encoded. Gene significance, module membership, and hub-gene analysis are run for every selected trait (and each one-hot level of categorical traits).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": true, "textable": false, "data_ref": "metadata_file", "numerical": false}, {"model_class": "IntegerToolParameter", "name": "plot_resolution", "argument": null, "type": "integer", "label": "Plot resolution (DPI)", "help": "Resolution, in dots per inch, used when rendering the PNG plots.", "help_format": "html", "refresh_on_change": false, "min": 72, "max": 600, "optional": false, "hidden": false, "is_dynamic": false, "value": "300", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "save_rscript", "argument": null, "type": "boolean", "label": "Save the R script used for this run", "help": "Useful for debugging. If enabled, the exact R script executed by this tool is provided as an additional output.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}], "outputs": [{"model_class": "ToolOutputCollection", "name": "wgcna_plots", "format": null, "label": "${tool.name} on ${on_string} - WGCNA plots", "hidden": false, "output_type": "collection", "default_format": "data", "default_format_source": null, "default_metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "png", "visible": false, "assign_primary_output": false, "directory": "plots", "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<name>.+)\\.png"}]}}, {"model_class": "ToolOutputCollection", "name": "gene_tables", "format": null, "label": "${tool.name} on ${on_string} - Module and hub gene tables", "hidden": false, "output_type": "collection", "default_format": "data", "default_format_source": null, "default_metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "tabular", "visible": false, "a