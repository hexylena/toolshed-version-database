, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "5.0", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "use_metadata", "argument": null, "type": "select", "label": "Add metadata annotation?", "help": "Add sample metadata as annotation bars above the heatmap. Metadata sample IDs must match the CoverM sample columns.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["No", "no", true], ["Yes", "yes", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "tax_level", "argument": "--tax_level", "type": "select", "label": "Taxonomic level", "help": "Taxonomic rank used to group and label MAGs in the heatmap. The rank is extracted from the GTDB-Tk classification column.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "phylum", "options": [["domain", "domain", false], ["phylum", "phylum", true], ["class", "class", false], ["order", "order", false], ["family", "family", false], ["genus", "genus", false], ["species", "species", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "format", "argument": "--format", "type": "select", "label": "Output format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "png", "options": [["PNG", "png", true], ["PDF", "pdf", false], ["SVG", "svg", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "max_col", "argument": "--max_col", "type": "integer", "label": "Maximum number of taxonomy labels", "help": "Maximum number of taxonomic labels to show. If more groups are present, only the most abundant labels are displayed to keep the heatmap readable.", 