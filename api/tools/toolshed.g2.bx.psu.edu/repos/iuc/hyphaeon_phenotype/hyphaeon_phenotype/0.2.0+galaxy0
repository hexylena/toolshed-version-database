olean", "label": "Continuous trait", "help": "Treat trait values as continuous phylogenetic contrasts rather than binary foreground/background", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--continuous", "falsevalue": ""}]}], "test_param": {"model_class": "SelectToolParameter", "name": "source_type", "argument": null, "type": "select", "label": "Phenotype definition", "help": "How to define the foreground (trait-positive) and background (trait-negative) taxa", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "preset", "options": [["Use a curated preset", "preset", true], ["Specify foreground/background taxa manually", "manual", false], ["Upload a phenotype metadata file", "file", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "IntegerToolParameter", "name": "permulations", "argument": "--permulations", "type": "integer", "label": "Number of permulations", "help": "Number of Brownian motion phylogenetic permulations for empirical p-values (RERconverge null model). 0 = parametric p-values only.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "min_taxa", "argument": "--min-taxa", "type": "integer", "label": "Minimum taxa per site", "help": "Minimum number of sequenced taxa required per site to include in the association test", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "4", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "alpha", "argument": "--alpha", "type": "float", "label": "FDR significance threshold", "help": "Benjamini-Hochberg FDR threshold for declaring significant as