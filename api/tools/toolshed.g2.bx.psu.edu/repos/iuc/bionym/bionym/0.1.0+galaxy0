{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/bionym/bionym/0.1.0+galaxy0", "name": "BioNym resolve", "version": "0.1.0+galaxy0", "description": "resolve a gene identifier into a confidence-scored knowledge graph", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.1.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "bionym", "owner": "iuc", "changeset_revision": "3d3ef2fc2bd0", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "TextToolParameter", "name": "identifier", "argument": null, "type": "text", "label": "Gene identifier", "help": "NCBI GeneID, symbol, VEuPathDB locus tag, UniProt accession, Ensembl ID \u2014 any species", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "depth", "argument": null, "type": "select", "label": "Pipeline depth", "help": "How far the JEV-judged evidence pipeline runs. Depth 6 adds cross-assembly presence: which related assemblies NCBI annotates the gene in, plus JEV-judged presence where unannotated. All stages use JEV + public APIs only \u2014 the LLM is only used by the proposal/summary passes below.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "6", "options": [["0 \u2014 classify only", "0", false], ["1 \u2014 + entity resolution", "1", false], ["2 \u2014 + related assemblies", "2", false], ["3 \u2014 + orthologs (OMA)", "3", false], ["4 \u2014 + annotation (UniProt/GO/KEGG)", "4", false], ["5 \u2014 + expression", "5", false], ["6 \u2014 + cross-assembly presence (full)", "6", true]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "min_confidence", "argument": null, "type": "float", "label": "Minimum edge confidence", "help": "Drop edges (and orphan nodes) below this confidence after resolution", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "propose", "argument": null, "type": "boolean", "label": "LLM proposal passes", "help": "One post-pipeline pass: JEV triages dataset/publication nodes, the LLM proposes claims on the top candidates, JEV verifies each. Requires LLM credentials; without them this is a no-op.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "--propose", "falsevalue": "--no-propose"}, {"model_class": "BooleanToolParameter", "name": "summarize", "argument": null, "type": "boolean", "label": "Write gene summary", "help": "Also produce a JEV-verified summary into graph metadata (needs LLM + JEV)", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "report_output", "argument": null, "type": "boolean", "label": "HTML report", "help": "Also emit a self-contained HTML report", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": ""}, {"model_class": "Section", "name": "adv", "type": "section", "title": "Advanced", "help": null, "expanded": false, "inputs": [{"model_class": "SelectToolParameter", "name": "llm_model", "argument": null, "type": "select", "label": "LLM model", "help": "Model for proposal/summary passes \u2014 from the same genai_models table as the LLM Hub tool. Only populated on servers that maintain that table; otherwise set the model via the LLM endpoint credential set.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": true, "value": null, "options": [["Most capable for complex tasks, deep reasoning, and detailed outputs (GPT-OSS-120B) [uni-freiburg]", "gpt-oss-120b-llmlb-freiburg", false], ["Most capable for complex tasks, deep reasoning, and detailed outputs (GPT-OSS-120B) [e-INFRA CZ]", "gpt-oss-120b-e-infra.cz", false], ["GLM-5, text only [e-INFRA CZ]", "glm-5-e-infra.cz", false], ["GLM-5.3, text only [e-INFRA CZ]", "glm-5.3-e-infra.cz", false], ["NRP, text only [e-INFRA CZ]", "nrp-e-infra.cz", false], ["Compact fast default model [e-INFRA CZ]", "mini-e-infra.cz", false], ["Coding-focused model [e-INFRA CZ]", "coder-e-infra.cz", false], ["GLM, large context [e-INFRA CZ]", "glm-e-infra.cz", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "proposal_min_score", "argument": null, "type": "float", "label": "Proposal triage score", "help": "JEV score a dataset/publication needs before the LLM spends a call on it", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "proposal_concurrency", "argument": null, "type": "integer", "label": "Proposal concurrency", "help": "Max simultaneous LLM calls", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 64, "optional": false, "hidden": false, "is_dynamic": false, "value": "8", "area": false, "datalist": []}]}, {"model_class": "HiddenToolParameter", "name": "test_mode", "argument": null, "type": "hidden", "label": "", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": true, "is_dynamic": false, "value": "false"}], "outputs": [{"model_class": "ToolOutput", "name": "graph", "format": "json", "label": "${tool.name} on ${on_string}: graph", "hidden": false, "output_type": "data", "format_source": 