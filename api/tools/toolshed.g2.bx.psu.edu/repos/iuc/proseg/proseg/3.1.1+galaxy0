se, "hidden": false, "is_dynamic": false, "value": "standard", "options": [["Standard", "standard", true], ["Custom", "custom", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "FloatToolParameter", "name": "voxel_size", "argument": "--voxel-size", "type": "float", "label": "Voxel size (microns)", "help": "X/Y voxel size for final sampling. Smaller = finer resolution but more memory. Default (1.0) matches proseg's own CLI default for most platforms.", "help_format": "html", "refresh_on_change": false, "min": 0.01, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "burnin_voxel_size", "argument": "--burnin-voxel-size", "type": "float", "label": "Burn-in voxel size (microns)", "help": "Must be an integer multiple of voxel size (e.g. if voxel size is 1.0, use 2.0, 3.0, 4.0 etc.). Default (2.0) matches proseg's own CLI default.", "help_format": "html", "refresh_on_change": false, "min": 0.01, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "2.0", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "voxel_layers", "argument": "--voxel-layers", "type": "integer", "label": "Voxel layers (z-axis)", "help": "Number of voxel layers along the z-axis for 3D segmentation.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "4", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "samples", "argument": "--samples", "type": "integer", "label": "Sampling iterations", "help": "Number of Markov Chain Monte Carlo (MCMC) sampling iterations after burn-in. Default (200) matches proseg's own CLI default.", "help_format": "html", "refresh_on_change": false, "min": 10, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "200", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "burnin_samples", "argument": "--burnin-samples", "type": "integer", "label": "Burn-in iterations", "help": "Number of preliminary Markov Chain Monte Carlo (MCMC) iterations at lower resolution, used to reach a good starting configuration before the main sampling phase.", "help_format": "html", "refresh_on_change": false, "min": 10, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "200", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "ignore_z", "argument": "--ignore-z-coord", "type": "boolean", "label": "Treat as 2D", "help": "Ignore z-coordinates and segment in 2D. Unchecked (proseg default) matches proseg's own default of 3D segmentation (voxel-layers defaults to 4); this is an opt-in override for data without reliable z-coordinates.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--ignore-z-coord", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "use_cell_init", "argument": "--use-cell-initialization", "type": "boolean", "label": "Use cell initialization", "help": "Initialize with cell assignments rather than nucleus assignments. Unchecked (proseg default) matches proseg's documented default of nucleus-stain-based initialization; this is an opt-in override for prior segmentations based on full cell boundaries rather than nuclei.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--use-cell-initialization", "falsevalue": ""}, {"model_class": "Section", "name": "advanced", "type": "section", "title": "Advanced model parameters", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "morph_steps", "argument": null, "type": "integer", "label": "Morphology steps per iteration", "help": "", "help_format": "html"