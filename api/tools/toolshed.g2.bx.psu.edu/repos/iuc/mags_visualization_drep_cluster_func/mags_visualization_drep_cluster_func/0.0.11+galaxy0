 [["Module ID (e.g. M00001)", "id", true], ["Module name", "name", false], ["Module ID and name", "both", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "top_n", "argument": "--top_n", "type": "integer", "label": "Top N clusters", "help": "Number of largest dRep species-level clusters to display, ranked by the number of member MAGs. Each selected cluster is shown as a horizontal bar.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 1000, "optional": false, "hidden": false, "is_dynamic": false, "value": "30", "area": false, "datalist": []}, {"model_class": "Conditional", "name": "module_selection", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "top", "inputs": [{"model_class": "IntegerToolParameter", "name": "top_modules", "argument": null, "type": "integer", "label": "Number of top modules", "help": "Number of functional modules to display after ranking by the selected mode: highest mean completeness for core modules, or highest variance for differential modules.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 500, "optional": false, "hidden": false, "is_dynamic": false, "value": "35", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "all", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "selection_mode", "argument": null, "type": "select", "label": "Module selection", "help": "Choose whether to show only the top-ranked functional modules or all modules from the pathway completeness table.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "top", "options": [["Show top modules", "top", true], ["Show all modules", "all", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "FloatToolParameter", "name": "tax_levels_space", "argument": "--tax_levels_space", "type": "float", "label": "Spacing between taxonomy columns (cm))", "help": "Horizontal spacing between the taxonomy annotation columns in cm. Increase this value if taxonomy labels overlap.", "help_format": "html", "refresh_on_change": false, "min": 0.1, "max": 13.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.8", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "mode", "argument": "--mode", "type": "select", "label": "Functional module selection mode", "help": "Select which functional module plot(s) to create: 'mean' highlights core modules with high average completeness across clusters, 'variance' highlights modules that differ most between clusters, and 'both' creates both outputs.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "mean", "options": [["mean (core modules)", "mean", true], ["variance (differential modules)", "variance", false], ["both", "both", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "format", "argument": "--format", "type": "select", "label": "Output format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "png", "options": [["PNG", "png", true], ["PDF", "pdf", false], ["SVG", "svg", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "Section", "name": "fig_size", "type": "section", "title": "Figure size", "help": null, "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "width", "argument": null, "type": "float", "label": "Figure width (cm)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1.0, "max": 100.0, "optional": true, "hidden": false, "is_dynamic": false, "value": "25.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "height", "argument": null, "type": "float", "label": "Figure hei