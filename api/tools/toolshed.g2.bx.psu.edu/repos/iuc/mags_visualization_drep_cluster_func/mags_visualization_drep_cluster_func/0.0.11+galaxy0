{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/mags_visualization_drep_cluster_func/mags_visualization_drep_cluster_func/0.0.11+galaxy0", "name": "MAGs-visualization drep-cluster-func", "version": "0.0.11+galaxy0", "description": "Create a dRep cluster plot with functional annotation", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.0.11+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "mags_visualization_drep_cluster_func", "owner": "iuc", "changeset_revision": "a70de587c7da", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "drep", "argument": "--drep", "type": "data", "label": "dRep cluster table", "help": "Use the unmodified dRep cluster table, typically the Cdb.csv output. The table must contain 'genome' and 'secondary_cluster'; each row assigns one genome to one dRep cluster.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["csv", "tabular"], "edam": {"edam_formats": ["format_3475", "format_3475"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "gtdb", "argument": "--gtdb", "type": "data", "label": "GTDB annotation table", "help": "Use the unmodified GTDB-Tk summary/annotation table containing 'user_genome' and 'classification'. The representative genome taxonomy is shown next to each cluster bar.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": []