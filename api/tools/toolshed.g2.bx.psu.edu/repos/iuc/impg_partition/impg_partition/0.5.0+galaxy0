{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/impg_partition/impg_partition/0.5.0+galaxy0", "name": "impg partition", "version": "0.5.0+galaxy0", "description": "splits a cohort into windowed homologous loci", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.5.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "impg_partition", "owner": "iuc", "changeset_revision": "98cd3868ead9", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "alignment", "argument": null, "type": "data", "label": "Alignment file(s)", "help": "One or more pairwise alignment files in PAF format (use 'minimap2 --eqx' or 'wfmash' output). May be bgzipped (.paf.gz). impg builds a reusable '.impg' index next to the input.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["paf", "paf.gz"], "edam": {"edam_formats": ["format_2330", "format_2330"], "edam_data": ["data_0006", "data_0006"]}, "multiple": true, "min": 1, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "IntegerToolParameter", "name": "window_size", "argument": "--window-size", "type": "integer", "label": "Window size (bp)", "help": "Window size for partitioning. impg greedily covers each sequence with windows of this size and groups homologous regions across the cohort.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1000000", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "merge_distance", "argument": "--merge-distance", "type": "text", "label": "Merge distance", "help": "Merge query-gathered ranges separated by at most this many bp. Also the largest internal gap/SV a single query hop can absorb. Accepts k/m/g suffixes (e.g. 50k, 1m). Use 0 to merge only overlapping/touching ranges.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "1000", "area": false, "datalist": []}, {"model_class": "Conditional", "name": "out", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "bed", "inputs": [{"model_class": "SelectToolParameter", "name": "bed_mode", "argument": null, "type": "select", "label": "Output mode", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "single", "options": [["Single BED file (all partitions)", "single", true], ["One BED file per partition", "separate", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "fasta", "inputs": [{"model_class": "DataToolParameter", "name": "sequence_files", "argument": null, "type": "data", "label": "Sequence files", "help": "Source FASTA(s) (optionally gzipped) for the sequences referenced in the alignment. Required for fasta / gfa / maf / vcf output.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz"], "edam": {"edam_formats": ["format_1929", "format_1929"], "edam_data": ["data_2044", "data_2044"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "BooleanToolParameter", "name": "reverse_complement", "argument": "--reverse-complement", "type": "boolean", "label": "Reverse-complement reverse-strand sequences", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--reverse-complement", "falsevalue": ""}]}], "test_param": {"model_class": "SelectToolParameter", "name": "format", "argument": null, "type": "select", "label": "Output format", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "bed", "options": [["bed \u2014 partition table", "bed", true], ["fasta \u2014 one sequence file per partition", "fasta", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "selection_mode", "argument": "--selection-mode", "type": "select", "label": "Selection mode", "help": "Strategy for picking the next starting sequence when partitioning.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "longest", "options": [["longest \u2014 sequence with the longest single missing region", "longest", true], ["total \u2014 sequence with the highest total missing regions", "total", false], ["sample \u2014 PanSN sample with the highest total missing regions", "sample", false], ["haplotype \u2014 PanSN haplotype with the highest total missing regions", "haplotype", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "Section", "name": "partition_opts", "type": "section", "title": "Partition options", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "min_missing_size", "argument": "--min-missing-size", "type": "integer", "label": "Min missing region size", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "3000", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "min_boundary_distance", "argument": "--min-boundary-distance", "type": "integer", "label": "Min boundary distance", "help": "Regions closer than this to a sequence start/end are extended to