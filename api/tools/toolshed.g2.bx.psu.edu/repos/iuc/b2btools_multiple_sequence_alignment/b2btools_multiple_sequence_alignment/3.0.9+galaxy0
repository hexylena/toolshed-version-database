{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/b2btools_multiple_sequence_alignment/b2btools_multiple_sequence_alignment/3.0.9+galaxy0", "name": "b2bTools: Biophysical predictors for multiple sequence alignments", "version": "3.0.9+galaxy0", "description": "from an aligned set of amino-acid sequences", "labels": [], "icon": null, "edam_operations": ["operation_0267", "operation_2415", "operation_3092", "operation_0448"], "edam_topics": ["topic_0082", "topic_0078", "topic_0080"], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "b2btools", "type": "bio.tools"}], "versions": ["3.0.9+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "b2btools_multiple_sequence_alignment", "owner": "iuc", "changeset_revision": "a91d19670fcd", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input", "argument": null, "type": "data", "label": "Multiple sequence alignment of protein sequences", "help": "Aligned protein sequences in FASTA, CLUSTAL or Stockholm format, and gzip-compressed FASTA. Every sequence must have the same aligned length.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz", "clustal", "stockholm"], "edam": {"edam_formats": ["format_1929", "format_1929", "format_2330", "format_1961"], "edam_data": ["data_2044", "data_2044", "data_0006", "data_0863"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Section", "name": "section_predictors", "type": "section", "title": "Biophysical predictors", "help": "DynaMine is always executed, because every other predictor is built on its output. Configure this section to select the additional predictions to be executed", "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "disomine", "argument": "--disomine", "type": "boolean", "label": "DisoMine: Prediction of protein disorder from sequence only", "help": "Predicts protein disorder with recurrent neural networks not directly from the amino acid sequence, but instead from more generic predictions of key biophysical properties, here protein dynamics, secondary structure and early folding. Selecting it also executes EFoldMine, whose output it requires.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "--disomine", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "efoldmine", "argument": "--efoldmine", "type": "boolean", "label": "EFoldMine: Prediction of protein early folding regions from sequence only", "help": "Predicts from the primary amino acid sequence of a protein, which amino acids are likely involved in early folding events.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "--efoldmine", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "agmata", "argument": "--agmata", "type": "boolean", "label": "Agmata: Prediction of protein regions that are likely to cause beta-aggregation", "help": "Agmata is a single-sequence based predictor of protein regions that are likely to cause beta-aggregation. It is based on a model that uses the biophysical predictions of protein behaviour, not on amino acid codes directly. Selecting it also executes EFoldMine, whose output it requires.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "--agmata", "falsevalue": ""}]}, {"model_class": "Section", "name": "section_plot", "type": "section", "title": "Plot options", "help": "Configure plot output", "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "plot_distribution", "argument": "--plot_distribution", "type": "boolean", "label": "Plot the distribution of each predicted feature along the alignment", "help": "Produces one plot per predicted feature showing the median, the interquartile range and the outlier boundaries across all the sequences of the alignment", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--plot_distribution", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "plot_all", "argument": "--plot_all", "type": "boolean", "label": "Plot all sequences together", "help": "Produces one plot per predicted feature holding one series per sequence, so the predicted values of the different sequences can be compared", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--plot_all", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "highlight", "argument": "--highlight", "type": "boolean", "label": "Highlight regions of interest", "help": "Highlight biophysical regions on the background of the plots. Only backbone, earlyFolding and disoMine have defined regions", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--highlight", "falsevalue": ""}]}, {"model_class": "Section", "name": "section_outputs", "type": "section", "title": "Additional outputs", "help": "Configure optional output files", "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "split_by_sequence", "argument": null, "type": "boolean", "label": "Split the predictions into one file per sequence", "help": "The same predictions as the main tabular output, split into a collection holding one file per aligned sequence", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "yes", "falsevalue": ""}]}], "outputs": [{"model_class": "ToolOutputCollection", "name": "split_output", "format": null, "label": "${tool.name} on ${on_string}: Tabular predictions by sequence", "hidden": false, "output_type": "collection", "default_format": "data", "format_source": null, "metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "tabular", "visible": true, "assign_primary_output": false, "directory": "tabular", "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<name>.*)\\.(?P<ext>[^\\.]+)?"}]}}, {"model_class": "ToolOutputCollection", "name": "split_output_plots", "format": null, "label": "${tool.name} on ${on_string}: Plots", "hidden": false, "output_type": "collection", "default_format": "data", "format_source": null, "metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "png", "visible": true, "assign_primary_output": false, "directory": "plots", "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<name>.*)\\.(?P<ext>[^\\.]+)?"}]}}, {"model_class": "ToolOutput", "name": "predictions_tabular", "format": "tabular", "label": "${tool.name} on ${on_string}: Predictions by aligned residue", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "distribution_tabular", "format": "tabular", "label": "${tool.name} on ${on_string}: Distribution of predictions along the alignment", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "predictions_output", "format": "json", "label": "${tool.name} on ${on_string}: Predictions in JSON format", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3464", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "chemicaltoolbox", "panel_section_name": "ChemicalToolBox", "form_style": "regular"}