: "homo_sapiens_vep_106_GRCh37", "options": [["Homo sapiens hg19 (V106)", "homo_sapiens_vep_106_GRCh37", false], ["Homo sapiens hg38 (V106)", "homo_sapiens_vep_106_GRCh38", false], ["Homo sapiens hg38 (V116)", "homo_sapiens_vep_116_GRCh38", false]], "display": null, "multiple": false, "textable": false}]}], "test_param": {"model_class": "SelectToolParameter", "name": "source", "argument": null, "type": "select", "label": "Select the source of annotation data if you want to use VEP", "help": "vcf2maf can utilize Ensembl's VEP to select a single effect per variant. VEP can only be used if SIFT is available for the selected genome assembly. Ensembl strongly recommends to only use annotation cache files with a version number matching the VEP version. You can disable the corresponding filtering of available cache files at your own risk.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no_vep", "options": [["Do not use VEP", "no_vep", true], ["Use VEP with a cache file with matching version number", "restricted", false], ["Use VEP with any cache file", "unrestricted", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "TextToolParameter", "name": "tumor_id", "argument": "--tumor-id", "type": "text", "label": "Enter tumor sample ID (optional)", "help": "Used to fill the Tumor_Sample_Barcode column of the output MAF with the tumor sample ID.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "normal_id", "argument": "--normal-id", "type": "text", "label": "Enter normal sample ID (optional)", "help": "Used to fill the Matched_Norm_Sample_Barcode column of the output MAF with the normal sample ID.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "vcf_tumor_id", "argument": "--vcf-tumor-id", "type": "text", "label": "Enter name of tumor genotype column (optional)", "help": "VCFs from variant callers like VarScan use hardcoded sample IDs TUMOR/NORMAL to name genotype columns. Use this parameter to have vcf2maf correctly locate these columns to parse genotypes, while still printing proper sample IDs in the output MAF.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "vcf_normal_id", "argument": "--vcf-normal-id", "type": "text", "label": "Enter name of normal genotype column (optional)", "help": "VCFs from variant callers like VarScan use hardcoded sample IDs TUMOR/NORMAL to name genotype columns. Use this parameter to have vcf2maf correctly locate these columns to parse genotypes, while still printing proper sample IDs in the output MAF.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "include_header", "argument": null, "type": "boolean", "label": "Include MAF version header in output file", "help": "The MAF version header is a comment that indicates the MAF version and is written into the first row of the ouput file. This is required by some downstream tools. The row containing column headers follows next.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}, {"model_class": "Section", "name": "adv_opt", "type": "section", "title": "Advanced options", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "any_allele", "argument": "--any-allele", "type": "boolean", "label": "Allow also mismatched variant alleles when reporting co-located variants", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "FloatToolParameter", "name": "min_hom_vaf", "argument": "--min-hom-vaf", "type": "float", "label": "Enter minimum allele fraction to call a variant homozygous if GT is undefined in VCF", "help": "Default value is 0.7", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "maf_center", "argument": "--maf-center", "type": "text", "label": "Enter variant calling center to report in MAF", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "retain_info", "argument": "--retain-info", "type": "text", "label": "Enter comma-delimited names of INFO fields to retain as extra columns in MAF", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "retain_fmt", "argument": "--retain-fmt", "type": "text", "label": "Enter comma-delimited names of FORMAT fields to retain as extra columns in MAF", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "retain_ann", "argument": "--retain-ann", "type": "text", "label": "Enter comma-delimited names of VEP annotations (within the VEP CSQ/ANN) to retain as extra columns in MAF", "help": "", "help_format": "html", "refresh_on_change": false, "optional": tru