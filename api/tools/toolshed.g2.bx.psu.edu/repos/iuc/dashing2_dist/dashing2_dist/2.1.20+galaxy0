{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/dashing2_dist/dashing2_dist/2.1.20+galaxy0", "name": "dashing2 dist", "version": "2.1.20+galaxy0", "description": "compare sketches or sequences into a distance/similarity matrix", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["2.1.20+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "dashing2_dist", "owner": "iuc", "changeset_revision": "8ea4ecb79e95", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "Conditional", "name": "input_mode", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "raw", "inputs": [{"model_class": "DataCollectionToolParameter", "name": "reference_collection", "argument": null, "type": "data_collection", "label": "Reference collection", "help": "A collection of raw FASTA/FASTQ datasets to compare. Two elements give a single pairwise distance; N elements give an all-pairs matrix.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "collection_types": ["list"], "fields": null, "column_definitions": null, "extensions": ["fasta", "fasta.gz", "fastq", "fastq.gz", "fastqsanger", "fastqsanger.gz"], "multiple": false, "tag": null, "options": {"hda": [], "hdca": [], "dce": []}, "pinned": {"hda": [], "hdca": [], "dce": []}, "options_meta": {}}, {"model_class": "Conditional", "name": "query", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "no", "inputs": []}, {"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "DataCollectionToolParameter", "name": "query_collection", "argument": null, "type": "data_collection", "label": "Query collection", "help": "Datasets forming the query set. Each is compared against every dataset in the reference collection.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "collection_types": ["list"], "fields": null, "column_definitions": null, "extensions": ["fasta", "fasta.gz", "fastq", "fastq.gz", "fastqsanger", "fastqsanger.gz"], "multiple": false, "tag": null, "options": {"hda": [], "hdca": [], "dce": []}, "pinned": {"hda": [], "hdca": [], "dce": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "use_query", "argument": null, "type": "select", "label": "Rectangular query-vs-reference comparison", "help": "Compare every reference dataset against a separate query collection, producing a rectangular |reference|\u00d7|query| matrix instead of an all-pairs matrix.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["No\u2014all-pairs within the reference set", "no", true], ["Yes\u2014supply a query collection", "yes", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "parse_by_seq", "argument": "--parse-by-seq", "type": "boolean", "label": "Parse each sequence separately", "help": "Treat every sequence within every raw input file as a separate entity rather than one entity per file. Only relevant when the inputs are raw sequences.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--parse-by-seq", "falsevalue": ""}, {"model_class": "SelectToolParameter", "name": "alphabet", "argument": null, "type": "select", "label": "Sequence alphabet", "help": "Alphabet used to interpret the input sequences. DNA is canonicalized by default; any protein alphabet disables canonicalization. The reduced alphabets group chemically similar residues to improve sensitivity for divergent proteins.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["DNA (default)", "", true], ["Protein, 20 characters (--enable-protein)", "--enable-protein", false], ["Protein, 14 characters (--protein14)", "--protein14", false], ["Protein, 8 characters (--protein8)", "--protein8", false], ["Protein, 6 characters (--protein6)", "--protein6", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "sketch_mode", "argument": null, "type": "select", "label": "Sketching mode", "help": "Data structure used to summarize each input. One-permutation SetSketch is the fastest and treats inputs as sets. Full SetSketch is more accurate for large sketches and small sets. The exact modes (k-mer set / count dictionary) build sorted hash sets rather than sketches.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["One-permutation SetSketch\u2014fastest, set-based (default)", "", true], ["Full SetSketch\u2014set-based, better for large sketches (--full)", "--full", false], ["Exact k-mer set (--set)", "--set", false], ["Exact k-mer count dictionary (--countdict)", "--countdict", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "Section", "name": "sketch_params", "type": "section", "title": "Sketch construction", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "kmer_length", "argument": "-k", "type": "integer", "label": "K-mer length", "help": "Length of the k-mers (or minimizers) to hash. Leave blank to use the maximum length expressible for the chosen alphabet (31 for DNA, 14 for protein). Values larger than that limit switch dashing2 to rolling hashing, allowing unbounded k.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "sketch_size", "argument": "-S", "type": "integer", "label": "Sketch size", "help": "Number of registers retained per sketch. Larger sketches give more accurate similarity estimates at the cost of memory and time. Unlike Dashing 1, any positive integer is allowed (it need not be a power of two).", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1024", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "window_size", "argument": "--window-size", "type": "integer", "label": "Window size (winnowing)", "help": "When greater than the k-mer length, only the minimum-hash k-mer in each window of this size is kept (minimizer winnowing). Larger windows yield fewer minimizers and faster sketching. Leave blank to use every k-mer.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "spacing", "argument": "--spacing", "type": "text", "label": "Spaced-seed pattern", "help": "Spacing scheme for spaced minimizers, given as one fewer integer than the k-mer length, e.g. for -k5 the value 0,1,1,0 specifies the match pattern KK.K.KK where '.' positions are ignored. Run-length form such as 0,1x2,0 is also accepted. Leave blank for contiguous (unspaced) k-mers.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "no_canon", "argument": "--no-canon", "type": "boolean", "label": "Disable canonicalization", "help": "By default DNA k-mers are canonicalized with their reverse complement so the sketch is strand-independent. Enable this to make sketching strand-specific. Ignored for protein alphabets.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--no-canon", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "long_kmers", "argument": "--long-kmers", "type": "boolean", "label": "Use 128-bit k-mers", "help": "Encode k-mers in 128-bit integers instead of 64-bit, allowing exact encoding of DNA k-mers up to length 64.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--long-kmers", "falsevalue": ""}, {"model_class": "IntegerToolParameter", "name": "seed", "argument": "--seed", "type": "integer", "label": "Hash seed", "help": "Seed for the k-mer hash function. A value of 0 disables k-mer XORing so k-mers are encoded directly. Leave blank to use the default seed.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}]}, {"model_class": "ConditionalWhen", "value": "presketched", "inputs": [{"model_class": "DataToolParameter", "name": "sketch_bin", "argument": null, "type": "data", "label": "Stacked sketch", "help": "The 'sketches' dataset emitted by dashing2 sketch (SetSketch modes). It is compared directly with --presketched, without re-reading any sequences.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["binary"], "edam": {"edam_formats": ["format_2333"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "sketch_names", "argument": null, "type": "data", "label": "Sketch names", "help": "The 'sketch names' (.names.txt) dataset emitted alongside the sketch. Optional, but supplying it restores the original row/column labels; without it the matrix is labelled with numeric indices.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "mode", "argument": null, "type": "select", "label": "Input type", "help": "Compare raw sequences (sketched on the fly) or a stacked sketch already produced by the dashing2 sketch tool. Pre-sketched comparison skips sketching entirely and is the way to re-use sketches across several comparisons.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "raw", "options": [["Sequences\u2014a FASTA/FASTQ collection, sketched on the fly", "raw", true], ["Pre-sketched\u2014a stacked sketch from dashing2 sketch", "presketched", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "measure", "argument": null, "type": "select", "label": "Comparison measure", "help": "Quantity emitted for each pair. Similarity is the fraction of shared registers. Mash/Poisson distance converts similarity to an evolutionary distance suitable for clustering. Containment is asymmetric (|A&B|/|A|); symmetric containment uses the smaller set. Intersection and union report raw cardinalities.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["Similarity (default)", "", true], ["Mash / Poisson distance (--distance)", "--distance", false], ["Containment, asymmetric (--containment)", "--containment", false], ["Symmetric containment (--symmetric-containment)", "--symmetric-containment", false], ["Intersection size (--intersection)", "--intersection", false], ["Union size (--union-size)", "--union-size", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "result_shape", "argument": null, "type": "select", "label": "Output shape", "help": "Dense all-pairs layout. Symmetric emits an upper-triangular PHYLIP matrix. Square emits a full N\u00d7N matrix (use with an asymmetric measure such as containment). For a query-vs-reference (rectangular) comparison, additionally supply a query collection above.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["Symmetric all-pairs, upper-triangular PHYLIP (default)", "", true], ["Square all-pairs, full N\u00d7N matrix (--asymmetric-all-pairs)", "--asymmetric-all-pairs", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "Conditional", "name": "sparse", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "none", "inputs": []}, {"model_class": "ConditionalWhen", "value": "topk", "inputs": [{"model_class": "IntegerToolParameter", "name": "topk", "argument": "--topk", "type": "integer", "label": "Number of nearest neighbours (k)", "help": "Maximum number of nearest neighbours listed per item. If k is greater than N-1, full pairwise distances are emitted instead.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "25", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "threshold", "inputs": [{"model_class": "FloatToolParameter", "name": "threshold", "argument": "--similarity-threshold", "type": "float", "label": "Minimum similarity", "help": "Only pairs whose similarity exceeds this fraction are emitted.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.7", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "mode", "argument": null, "type": "select", "label": "Sparse output filter", "help": "Restrict the dense matrix to its most important entries, emitting a compressed-sparse-row (CSR) result powered by an LSH index. Top-k keeps each item's nearest neighbours; thresholding keeps pairs above a similarity cutoff.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["None\u2014emit the full matrix", "none", true], ["Top-k nearest neighbours (--topk)", "topk", false], ["Similarity threshold (--similarity-threshold)", "threshold", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "binary_output", "argument": "--binary-output", "type": "boolean", "label": "Binary output", "help": "Emit the distances as a binary float32 matrix rather than human-readable text. Symmetric comparisons emit a condensed matrix; square and rectangular comparisons emit full row-major matrices.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--binary-output", "falsevalue": ""}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "tabular", "label": "${tool.name} on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "annotation", "panel_section_name": "Annotation", "form_style": "regular"}