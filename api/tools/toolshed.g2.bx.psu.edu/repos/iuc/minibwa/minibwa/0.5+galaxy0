ameter", "name": "y", "argument": "-y", "type": "boolean", "label": "Copy FASTA/Q comments to the output", "help": "-y", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-y", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "Y", "argument": "-Y", "type": "boolean", "label": "Use soft clipping for supplementary alignments", "help": "-Y; by default supplementary alignments are hard clipped", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-Y", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "five", "argument": "-5", "type": "boolean", "label": "For split alignment, take the alignment with the smallest query coordinate as primary", "help": "-5; useful for Hi-C data. The Hi-C library type already implies this option.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-5", "falsevalue": ""}, {"model_class": "IntegerToolParameter", "name": "outn", "argument": "--outn", "type": "integer", "label": "Output up to this many secondary alignments", "help": "--outn; default=0; capped by the -N value", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "outs", "argument": "--outs", "type": "float", "label": "Output a secondary hit if its score is at least this fraction of the best score", "help": "--outs; default=0.8", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.8", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "xa", "argument": "--xa", "type": "integer", "label": "Write up to thi