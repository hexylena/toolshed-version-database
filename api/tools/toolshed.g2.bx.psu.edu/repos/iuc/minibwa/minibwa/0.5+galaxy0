": []}, {"model_class": "IntegerToolParameter", "name": "c", "argument": "-c", "type": "integer", "label": "Skip seeds with more than that many occurrences", "help": "-c; default=250", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "250", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "g", "argument": "-g", "type": "integer", "label": "Maximum gap size", "help": "-g; default=100; controls both extension and chain breaking", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "w", "argument": "-w", "type": "integer", "label": "Bandwidth for banded alignment", "help": "-w; default=100", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "W", "argument": "-W", "type": "integer", "label": "Long bandwidth", "help": "-W; default=20000; used for long reads and in the adaptive mode", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "20000", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "m", "argument": "-m", "type": "integer", "label": "Minimum chaining score", "help": "-m; default=25", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "25", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "p", "argument": "-p", "type": "float", "label": "Minimum secondary-to-primary score ratio", "help": "-p; default=0.5", "help_format": "html", "refresh_on_change": f