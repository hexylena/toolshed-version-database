{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/iuc/oatk/oatk/1.0+galaxy0", "name": "oatk", "version": "1.0+galaxy0", "description": "Organelle Genome Assembly Toolkit", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "oatk", "owner": "iuc", "changeset_revision": "d9076b232ce4", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_reads", "argument": null, "type": "data", "label": "Input PacBio HiFi Reads", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fastqsanger", "fastqsanger.gz", "fasta", "fasta.gz"], "edam": {"edam_formats": ["format_1932", "format_1932", "format_1929", "format_1929"], "edam_data": ["data_2044", "data_2044", "data_2044", "data_2044"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Section", "name": "syncasm", "type": "section", "title": "Syncasm Options", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "use_graph_mode", "argument": "-G", "type": "boolean", "label": "Use Graph Mode", "help": "Treat the input file as an assembly graph (GFA) from another assembler rather than raw HiFi reads. Requires genome assembly graph input file, built from tools such as MBG, Spades or Hifiasm", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-G", "falsevalue": ""}, {"model_class": "IntegerToolParameter", "name": "kmer_size", "argument": "-k", "type": "integer", "label": "K-mer Size", "help": "K-mer size used by Syncasm for building the assembly graph. Larger values are suitable for accurate long reads such as PacBio HiFi.", "help_format": "html", "refresh_on_change": false, "min": 21, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1001", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "smer_size", "argument": "-s", "type": "integer", "label": "S-mer Size", "help": "Syncmer size used for k-mer sampling. This value to be no larger than 31.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 31, "optional": false, "hidden": false, "is_dynamic": false, "value": "31", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "min_kmer_coverage", "argument": "-c", "type": "integer", "label": "Minimum K-mer Coverage", "help": "K-mers below this value are removed from the assembly graph. This is an important parameter for organelle genome assembly, as higher values help filter out nuclear sequences and NUMTs. As an empirical instruction, this parameter can be set as 5-10 times the value of nuclear sequence coverage.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "30", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_arc_coverage", "argument": "-a", "type": "float", "label": "Minimum Arc Coverage", "help": "Relative threshold (0-1) to keep or prune connections between sequences", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.35", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "max_data_usage", "argument": "-D", "type": "text", "label": "Maximum Data Usage", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "0", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_bubble_size", "argument": "--max-bubble", "type": "integer", "label": "Maximum Bubble Size", "help": "Maximum size of bubbles (alternative paths) to resolve during graph cleaning.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "100000", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_tip_size", "argument": "--max-tip", "type": "integer", "label": "Maximum Tip Size", "help": "Maximum size of tips (dead ends) to resolve during graph cleaning.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "10000", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "weak_crosslink", "argument": "--weak-cross", "type": "float", "label": "Maximum Relative Edge Coverage for Weak Crosslink", "help": "Maximum relative coverage allowed for weak cross-links to be removed during graph cleaning.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.3", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "unzip_rounds", "argument": "--unzip-round", "type": "integer", "label": "Maximum Unzip Rounds", "help": "Maximum number of rounds to attempt unzipping the assembly graph.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "3", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "disable_read_ec", "argument": null, "type": "boolean", "label": "Disable Read Error Correction?", "help": "Disable read error correction during assembly.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--no-read-ec", "falsevalue": ""}]}, {"model_class