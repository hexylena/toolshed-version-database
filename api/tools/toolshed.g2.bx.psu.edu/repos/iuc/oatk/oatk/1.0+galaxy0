ons", "help": null, "expanded": false, "inputs": [{"model_class": "TextToolParameter", "name": "edge_coverage_tag", "argument": "--edge-c-tag", "type": "text", "label": "Edge Coverage Tag in GFA File", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "EC:i", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "kmer_coverage_tag", "argument": "--kmer-c-tag", "type": "text", "label": "K-mer Coverage Tag in GFA File", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "KC:i", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "seq_coverage_tag", "argument": "--seq-c-tag", "type": "text", "label": "Sequence Coverage Tag in GFA File", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "SC:f", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "final_gfa_file", "format": "gfa1", "label": "${tool.name} on ${on_string}: GFA file for final genome assembly", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "oatk.asm.utg.final.gfa", "edam_format": "format_2330", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "mt_gene", "format": "txt", "label": "${tool.name} on ${on_string}: MT gene annotation file for assembled sequences", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "oatk.asm.annot_mito.txt", "edam_format": "format_2330", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "pt_gene", "format": "txt", "label": "${tool.name} on ${on_string}: PT