{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/recetox/recetox_aplcms_remove_noise/recetox_aplcms_remove_noise/0.15.0+galaxy0", "name": "recetox-aplcms - remove noise", "version": "0.15.0+galaxy0", "description": "filter noise and detect peaks in high resolution mass spectrometry (HRMS) profile data", "labels": [], "icon": null, "edam_operations": ["operation_3937"], "edam_topics": ["topic_3172", "topic_0091", "topic_3520"], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "recetox-aplcms", "type": "bio.tools"}], "versions": ["0.11.0+galaxy1", "0.11.0+galaxy2", "0.12.0+galaxy2", "0.12.0+galaxy3", "0.13.2+galaxy0", "0.13.3+galaxy0", "0.13.4+galaxy0", "0.15.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "recetox_aplcms_remove_noise", "owner": "recetox", "changeset_revision": "97f14feab793", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_file", "argument": null, "type": "data", "label": "Input spectra data", "help": "Sample data in .mzml format acquired in profile mode.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["mzml", "thermo.raw"], "edam": {"edam_formats": ["format_3244", "format_3712"], "edam_data": ["data_2536", "data_2536"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "FloatToolParameter", "name": "min_pres", "argument": null, "type": "float", "label": "Minimal signal presence [fraction of scans]", "help": "The minimum proportion of presence in the time period for a series of signals grouped by m/z to be considered a peak.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_run", "argument": null, "type": "float", "label": "Minimal elution time [unit corresponds to the retention time]", "help": "The minimum length of elution time for a series of signals grouped by m/z to be considered a peak.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "12.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "max_run", "argument": null, "type": "float", "label": "Maximum elution time [unit corresponds to the retention time]", "help": "The maximum length of elution time for a series of signals grouped by m/z to be considered a peak.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "100.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "mz_tol", "argument": null, "type": "float", "label": "m/z tolerance [ppm]", "help": "The m/z tolerance level for the grouping of data points. This value is expressed as the fraction of the m/z value.                This value, multiplied by the m/z value, becomes the cutoff level.                The recommended value is the machine's nominal accuracy level (e.g. for FTMS, it is 10).", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "10.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "baseline_correct", "argument": null, "type": "float", "label": "Baseline correction [unit of signal intensity]", "help": "After grouping the observations, the highest intensity in each group is found. If the highest is lower than this value, the entire group will be deleted.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "grouping_threshold", "argument": null, "type": "float", "label": "Grouping Threshold [unit corresponds to the retention time]", "help": "Maximum empty space between section of the chromatogram for splitting EICs", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "10.0", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "intensity_weighted", "argument": null, "type": "boolean", "label": "Weight intensity", "help": "Whether to weight the local density by signal intensities in initial peak detection.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "TRUE", "falsevalue": "FALSE"}], "outputs": [{"model_class": "ToolOutput", "name": "output_file", "format": "parquet", "label": "${($input_file.element_identifier).rsplit('.',1)[0]}.parquet", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_2333", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "metabolomics", "panel_section_name": "Metabolomics", "form_style": "regular"}