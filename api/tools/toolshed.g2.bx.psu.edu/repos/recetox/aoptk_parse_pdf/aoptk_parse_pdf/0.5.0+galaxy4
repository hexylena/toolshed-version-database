b-llmlb-freiburg", false], ["Flagship 397B mixture-of-experts model for the most demanding reasoning, long-context, and visual tasks (Qwen3.5-397B) [uni-freiburg]", "qwen-3.5-397b-llmlb-freiburg", false], ["Advanced reasoning and multimodal understanding with efficient 27B architecture (Qwen3.6-27B) [uni-freiburg]", "qwen-3.6-27b-llmlb-freiburg", false], ["Efficient 9B native vision-language model for everyday tasks with fast inference (Qwen3.5-9B) [uni-freiburg]", "qwen3.5-9b-llmlb-freiburg", false], ["Latest Mistral Small generation with multimodal support and strong instruction following (Mistral-Small-4) [uni-freiburg]", "mistral-small-4-llmlb-freiburg", false], ["High-performance 31B multimodal model for complex reasoning and image understanding (Gemma-4-31B-IT) [uni-freiburg]", "gemma-4-31b-llmlb-freiburg", false], ["Efficient instruct-tuned model for general tasks (Llama-4-Scout-17B) [e-INFRA CZ]", "llama-4-scout-17b-16e-instruct-e-infra.cz", false], ["Specialized code generation model with 30B parameters (Qwen3-Coder-30B) [e-INFRA CZ]", "qwen3-coder-30b-e-infra.cz", false], ["Efficient code generation model for programming tasks (Qwen3-Coder) [e-INFRA CZ]", "qwen3-coder-e-infra.cz", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "custom", "inputs": [{"model_class": "TextToolParameter", "name": "model", "argument": null, "type": "text", "label": "LLM Model identifier", "help": "Model identifier - can be specific for the server at hand.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "server_url", "argument": null, "type": "text", "label": "OpenAI API endpoint url", "help": "URL for the OpenAI API endpoint to use.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": fal