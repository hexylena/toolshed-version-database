{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/recetox/aoptk_query_literature/aoptk_query_literature/0.5.0+galaxy7", "name": "aoptk query literature", "version": "0.5.0+galaxy7", "description": "Query literature for a list of publication IDs.", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.5.0+galaxy1", "0.5.0+galaxy2", "0.5.0+galaxy3", "0.5.0+galaxy4", "0.5.0+galaxy5", "0.5.0+galaxy6", "0.5.0+galaxy7"], "hidden_versions": [], "tool_shed_repository": {"name": "aoptk_query_literature", "owner": "recetox", "changeset_revision": "3cec2d4045dd", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "TextToolParameter", "name": "search_term", "argument": null, "type": "text", "label": "Search term", "help": "Enter the query exactly as you would in PMC, Europe PMC, or PubMed.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "database", "argument": null, "type": "select", "label": "Literature database", "help": "Choose the database to search in / download from. PubMed only accepts searches with up to 10,000 results, while Europe PMC and PMC have no such limit. Pubmed only allows downloading abstracts", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "pmc", "options": [["Europe PMC", "europepmc", false], ["PMC", "pmc", true], ["PubMed", "pubmed", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "preprint_mode", "argument": null, "type": "select", "label": "Preprint handling", "help": "Choose whether preprints should be included in the search results.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "all", "options": [["Include preprints and non-preprints", "all", true], ["Exclude preprints", "exclude", false], ["Only include preprints", "only", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "licensing", "argument": null, "type": "select", "label": "Licensing filter", "help": "Limit search results to publications with a specific Creative Commons (CC) license. This setting is ignored for PubMed.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "all", "options": [["No licensing specification", "all", true], ["Open Access", "open-access", false], ["CC0", "CC0", false], ["CC-BY", "CC-BY", false], ["CC-BY-SA", "CC-BY-SA", false], ["CC-BY-ND", "CC-BY-ND", false], ["CC-BY-NC", "CC-BY-NC", false], ["CC-BY-NC-ND", "CC-BY-NC-ND", false], ["CC-BY-NC-SA", "CC-BY-NC-SA", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "full_text_subset", "argument": null, "type": "boolean", "label": "Only include publications with full text", "help": "Limit the query to publications for which full text is available.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}], "outputs": [{"model_class": "ToolOutput", "name": "ids", "format": "txt", "label": "Query ${search_term} on ${database}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "ids.txt", "edam_format": "format_2330", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "machine_learning", "panel_section_name": "Machine Learning", "form_style": "regular"}