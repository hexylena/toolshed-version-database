ents", "nb_events", false], ["max_nb_consecutive_events \u2014 Maximum consecutive sequence", "max_nb_consecutive_events", false], ["run_mean \u2014 Running mean", "run_mean", false], ["run_sum \u2014 Running sum", "run_sum", false], ["anomaly \u2014 Anomaly relative to a reference", "anomaly", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "ui_var_type", "argument": null, "type": "select", "label": "Climate variable type", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["-- Not specified --", "", false], ["t \u2014 Temperature", "t", false], ["p \u2014 Precipitation", "p", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "TextToolParameter", "name": "ui_thresh", "argument": null, "type": "text", "label": "Threshold", "help": "E.g. '25 degC', '10 mm/day', '0 degC'. Use pint units.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "ui_logical_operation", "argument": null, "type": "select", "label": "Logical operator", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["-- Not specified --", "", false], ["gt \u2014 strictly greater than (>)", "gt", false], ["lt \u2014 strictly less than (<)", "lt", false], ["get \u2014 greater than or equal (>=)", "get", false], ["let \u2014 less than or equal (<=)", "let", false], ["e \u2014 equal (==)", "e", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "ui_link_logical_operations", "argument": null, "type": "select", "label": "Logical link between multiple thresholds", "help": "", "help_format": "html", "refresh_on_change": false,