{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/climate/icclim_climate_indices/icclim_climate_indices/7.1.0+galaxy0", "name": "Climate Indices Computation (icclim)", "version": "7.1.0+galaxy0", "description": "from CF NetCDF files", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["7.1.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "icclim_climate_indices", "owner": "climate", "changeset_revision": "0c56299c3551", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "Repeat", "name": "file_groups", "type": "repeat", "title": "File Group", "help": null, "default": 1, "min": 1, "max": null, "inputs": [{"model_class": "DataToolParameter", "name": "input_files", "argument": null, "type": "data", "label": "Input NetCDF file(s) for this group (CF-compliant)", "help": "One or more NetCDF files sharing the same time series (e.g. decade-split files for the same variable and site). All files are passed together to icclim for each index in this group.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["netcdf", "h5"], "edam": {"edam_formats": ["format_3650", "format_3590"], "edam_data": ["data_0943", "data_0006"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Repeat", "name": "indices", "type": "repeat", "title": "Index to Compute", "help": null, "default": 1, "min": 1, "max": null, "inputs": [{"model_class": "Conditional", "name": "index_sel", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "TG", "inputs": []}, {"model_class": "ConditionalWhen", "value": "TN", "inputs": []}, {"model_class": "ConditionalWhen", "value": "TX", "inputs": []}, {"model_class": "Con