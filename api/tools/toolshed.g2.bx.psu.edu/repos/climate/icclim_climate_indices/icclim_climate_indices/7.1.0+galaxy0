"is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "ui_ref_time_range_end", "argument": null, "type": "text", "label": "Reference period end (anomaly, YYYY-MM-DD)", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "index_name", "argument": null, "type": "select", "label": "Climate index to compute", "help": "Select an ECA&D/ETCCDI index, or choose '\u2014 Custom index \u2014' to define your own. Compound indices CD, CW, WD, WW require both a temperature file (tas) and a precipitation file (pr) as input.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "TG", "options": [["TG \u2014 Mean daily temperature", "TG", false], ["TN \u2014 Minimum daily temperature", "TN", false], ["TX \u2014 Maximum daily temperature", "TX", false], ["TXx \u2014 Monthly maximum of TX", "TXx", false], ["TXn \u2014 Monthly minimum of TX", "TXn", false], ["TNx \u2014 Monthly maximum of TN", "TNx", false], ["TNn \u2014 Monthly minimum of TN", "TNn", false], ["FD \u2014 Frost days (TN < 0\u00b0C)", "FD", false], ["CFD \u2014 Consecutive frost days", "CFD", false], ["SU \u2014 Summer days (TX > 25\u00b0C)", "SU", false], ["CSU \u2014 Consecutive summer days", "CSU", false], ["ID \u2014 Ice days (TX < 0\u00b0C)", "ID", false], ["TR \u2014 Tropical nights (TN > 20\u00b0C)", "TR", false], ["GD4 \u2014 Growing degree days (> 4\u00b0C)", "GD4", false], ["HD17 \u2014 Heating degree days (< 17\u00b0C)", "HD17", false], ["TG10p \u2014 Cold days (TG < 10th percentile)", "TG10p", false], ["TG90p \u2014 Warm days (TG > 90th percentile)", "TG90p", false], ["TN10p \u2014 Cold nights (TN < 10th percentile)", "TN10p", false], ["TN90p \u2014 Warm nights (TN > 90th percentile)", "TN90p", false], ["TX10p \u2014 Cold days (TX < 10th percentile)", "TX10p", false], ["TX90p \u2014 Warm days (TX > 90th percentile)", "TX90p", false], ["WSDI \u2014 Warm spell duration index", "WSDI", false], ["CSDI \u2014 Cold spell duration index", "CSDI", false], ["DTR \u2014 Diurnal temperature range", "DTR", false], ["ETR \u2014 Intra-period temperature range", "ETR", false], ["vDTR \u2014 Variability of diurnal temperature range", "vDTR", false], ["RR \u2014 Total precipitation", "RR", false], ["RR1 \u2014 Wet days (RR >= 1 mm)", "RR1", false], ["SDII \u2014 Simple daily intensity index", "SDII", false], ["CWD \u2014 Consecutive wet days", "CWD", false], ["CDD \u2014 Consecutive dry days", "CDD", false], ["R10mm \u2014 Heavy precipitation days (>= 10 mm)", "R10mm", false], ["R20mm \u2014 Very heavy precipitation days (>= 20 mm)", "R20mm", false], ["RX1day \u2014 Maximum 1-day precipitation", "RX1day", false], ["RX5day \u2014 Maximum consecutive 5-day precipitation", "RX5day", false], ["R75p \u2014 Very wet days (> 75th percentile)", "R75p", false], ["R95p \u2014 Extremely wet days (> 95th percentile)", "R95p", false], ["R99p \u2014 Ultra-extreme wet days (> 99th percentile)", "R99p", false], ["R75pTOT \u2014 Precipitation fraction above 75th percentile", "R75pTOT", false], ["R95pTOT \u2014 Precipitation fraction above 95th percentile", "R95pTOT", false], ["R99pTOT \u2014 Precipitation fraction above 99th percentile", "R99pTOT", false], ["PRCPTOT \u2014 Total precipitation on wet days (\u2265 1 mm/day)", "PRCPTOT", false], ["CD \u2014 Cold and Dry days (TG < 25th perc. and RR < 25th perc.)", "CD", false], ["CW \u2014 Cold and Wet days (TG < 25th perc. and RR > 75th perc.)", "CW", false], ["WD \u2014 Warm and Dry days (TG > 75th perc. and RR < 25th perc.)", "WD", false], ["WW \u2014 Warm and Wet days (TG > 75th perc. and RR > 75th perc.)", "WW", false], ["SD \u2014 Mean snow depth", "SD", false], ["SD1 \u2014 Days with >= 1 cm of snow", "SD1", false], ["SD5cm \u2014 Days with >= 5 cm of snow", "SD5cm", false], ["SD50cm \u2014 Days with >= 50 cm of snow", "SD50cm", false], ["\u2014 Custom index (define your own) \u2014", "CUSTOM", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "slice_mode", "argument": null, "type": "select", "label": "Computation frequency", "help": "Period over which the index is computed. Note: all indices within the same file group must use the same frequency when the output is merged. If you need different frequencies, enable 'One output file per index'.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "year", "options": [["Annual", "year", true], ["Monthly", "month", false], ["Winter (DJF)", "DJF", false], ["Spring (MAM)", "MAM", false], ["Summer (JJA)", "JJA", false], ["Autumn (SON)", "SON", false], ["Winter half-year (ONDJFM)", "ONDJFM", false], ["Summer half-year (AMJJAS)", "AMJJAS", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "TextToolParameter", "name": "var_name", "argument": null, "type": "text", "label": "Climate variable name (optional)", "help": "Variable name in the NetCDF file (e.g. tasmax). Leave blank for auto-detection. For indices requiring two variables (CD, CW, WD, WW, DTR, ETR, vDTR), enter both names separated by a comma, e.g. tas,pr or tasmax,tasmin.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "Section", "name": "adv", "type": "section", "title": "Advanced parameters", "help": null, "expanded": false, "inputs": [{"model_class": "TextToolParameter", "name": "time_range_start", "argument": null, "type": "text", "label": "Time range start (YYYY-MM-DD)", "help": "E.g. 1990-01-01. Leave empty to use the full series.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "time_range_end", "argument": null, "type": "text", "label": "Time range end (YYYY-MM-DD)", "help": "E.g. 2020-12-31. Must be set if start is set.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "base_period_start", "argument": null, "type": "text", "label": "Base period start (for TX90p, TN10p\u2026 YYYY-MM-DD)", "help": "Reference period for percentile-based indices. E.g. 1961-01-01.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "base_period_end", "argument": null, "type": "text", "label": "Base period end (YYYY-MM-DD)", "help": "E.g. 1990-12-31.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "only_leap_years", "argument": null, "type": "boolean", "label": "Leap years only", "help": "If enabled, only leap years are taken into account.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--only-leap-years", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "ignore_Feb29th", "argument": null, "type": "boolean", "label": "Ignore February 29th", "help": "If enabled, February 29th is excluded from all computations.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--ignore-Feb29th", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "save_thresholds", "argument": null, "type": "boolean", "label": "Save thresholds in the output file", "help": "For indices using percentiles (TX90p, TN10p\u2026).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--save-thresholds", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "date_event", "argument": null, "type": "boolean", "label": "Store extreme event dates", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--date-event", "falsevalue": ""}, {"model_class": "IntegerToolParameter", "name": "min_spell_length", "argument": null, "type": "integer", "label": "Minimum spell length", "help": "For WSDI, CSDI, CSU, CFD\u2026 indices (icclim default: 6).", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "rolling_window_width", "argument": null, "type": "integer", "label": "Rolling window width for percentiles", "help": "Window in days centered on each day (icclim default: 5).", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "out_unit", "argument": null, "type": "text", "label": "Output unit", "help": "E.g. 'days', 'percent', 'degC'. Uses the icclim default unit if absent.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "threshold", "argument": null, "type": "text", "label": "Custom threshold (SU, CSU, TR, WSDI, CSDI, TX90p, TG90p, TN90p, TX10p, TG10p, TN10p)", "help": "Overrides the default threshold of the index. Must include an operator and pint unit. E.g. '>= 30 degC' for SU (default: > 25 degC).", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "doy_window_width", "argument": null, "type": "integer", "label": "Day-of-year window width for percentiles", "help": "Number of days on each side of the current day used to aggregate values when computing percentiles. icclim default: 5.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "interpolation", "argument": null, "type": "select", "label": "Percentile interpolation method", "help": "Method used to compute reference percentiles. Ignored for non-percentile indices. icclim default: median_unbiased.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "options": [["-- Default (median_unbiased) --", "", true], ["median_unbiased \u2014 median-unbiased (ECA&D default)", "median_unbiased", false], ["linear \u2014 linear interpolation", "linear", false]], "display": null, "multiple": false, "textable": false}]}]}]}, {"model_class": "BooleanToolParameter", "name": "split_by_file", "argument": null, "type": "boolean", "label": "One output file per input file", "help": "If enabled, icclim is called once per input file instead of passing all files in a group together. Use when files are independent datasets (different sites, models), not a split time series. Produces a collection output.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "yes", "falsevalue": "no"}, {"model_class": "BooleanToolParameter", "name": "split_by_index", "argument": null, "type": "boolean", "label": "One output file per index", "help": "If enabled, each computed index is saved in a separate output file. By default, all indices are merged into a single file. Produces a collection output. WARNING: you MUST enable this option if indices in the same group use different computation frequencies (e.g. Monthly + Annual) \u2014 merging datasets with incompatible time coordinates will fail.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "yes", "falsevalue": "no"}, {"model_class": "Section", "name": "global_opts", "type": "section", "title": "Global options", "help": null, "expanded": false, "inputs": [{"model_class": "SelectToolParameter", "name": "netcdf_version", "argument": null, "type": "select", "label": "Output NetCDF format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "NETCDF4", "options": [["NETCDF4", "NETCDF4", true], ["NETCDF4_CLASSIC", "NETCDF4_CLASSIC", false], ["NETCDF3_CLASSIC", "NETCDF3_CLASSIC", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "logs_verbosity", "argument": null, "type": "select", "label": "icclim log verbosity", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "LOW", "options": [["LOW \u2014 minimal", "LOW", true], ["HIGH \u2014 detailed", "HIGH", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "sampling_method", "argument": null, "type": "select", "label": "Temporal sampling method", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "resample", "options": [["resample (default)", "resample", true], ["groupby", "groupby", false], ["groupby_ref_and_resample_study", "groupby_ref_and_resample_study", false]], "display": null, "multiple": false, "textable": false}]}], "outputs": [{"model_class": "ToolOutputCollection", "name": "output_collection", "format": null, "label": "Computed climate indices", "hidden": false, "output_type": "collection", "default_format": "data", "format_source": null, "metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "netcdf", "visible": false, "assign_primary_output": false, "directory": "output_split", "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<name>.+)\\.nc"}]}}, {"model_class": "ToolOutput", "name": "output", "format": "netcdf", "label": "Computed climate indices (icclim ${tool.version})", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3650", "edam_data": "data_0943", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "climate_analysis", "panel_section_name": "Climate Analysis", "form_style": "regular"}