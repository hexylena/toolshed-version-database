nal", "cases": [{"model_class": "ConditionalWhen", "value": "__q2galaxy__::control::default", "inputs": [{"model_class": "HiddenToolParameter", "name": "random_effects_formula", "argument": null, "type": "hidden", "label": "", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": true, "is_dynamic": false, "value": "__q2galaxy__::literal::None"}]}, {"model_class": "ConditionalWhen", "value": "__q2galaxy__::control::provide", "inputs": [{"model_class": "TextToolParameter", "name": "random_effects_formula", "argument": null, "type": "text", "label": "", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "__q2galaxy__GUI__select__", "argument": null, "type": "select", "label": "random_effects_formula: Str", "help": "[optional]  A formula that expresses how the feature absolute abundances in the feature table depend on the random effects of variables (columns) in the metadata. Do not include the dependent variable. For example, to specify `MyVariable` as a random intercept use the syntax `(1 | MyVariable)`. Reference the `lmerTest` R package for a specification of valid formulae.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "__q2galaxy__::control::default", "options": [["None (Use default behavior)", "__q2galaxy__::control::default", true], ["Provide a value", "__q2galaxy__::control::provide", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Repeat", "name": "reference_levels", "type": "repeat", "title": "reference_levels: List[Str]", "help": "[optional]  Specify reference levels for one or more categorical metadata variables (columns). The method of specification is \"column_name::column_value\". E.g. \"sex::female\" sets the \"female\" category of the \"sex\" variable to be the reference level. Separate multiple specifications by spaces.", "default": 0, "min": 0, "max": "__Infinity__", "inputs": [{"model_class": "TextToolParameter", "name": "element", "argument": null, "type": "text", "label": "element: Str", "help": "[required]", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "TextToolParameter", "name": "p_adjust_method", "argument": null, "type": "text", "label": "p_adjust_method: Str", "help": "[default: 'holm']  The method used to adjust p-values. Choose from \"holm\", \"hochberg\", \"hommel\", \"bonferroni\",  \"BH\", \"BY\", \"fdr\", \"none\". See the `p.adjust` method in the `stats` R package for explanations of each option.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "holm", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "prevalence_cutoff", "argument": null, "type": "float", "label": "prevalence_cutoff: Float % Range(0.0, 1.0, inclusive_end=True)", "help": "[default: 0.1]  Features with prevalences less than this threshold will be excluded from the analysis.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.1", "area": false, "datalist": []}, {"model_class": "Conditional", "name": "__q2galaxy__GUI__conditional__group__", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "__q2galaxy__::control::default", "inputs": [{"model_class": "HiddenToolParameter", "name": "group", "argument": null, "type": "hidden", "label": "", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": true, "is_dynamic": false, "value": "__q2galaxy__::literal::None"}]}, {"model_class": "ConditionalWhen", "value": "__q2galaxy__::control::provide", "inputs": [{"model_class": "TextToolParameter", "name": "group", "argument": null, "type": "text", "label": "", "help": "", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "__q2galaxy__GUI__select__", "argument": null, "type": "select", "label": "group: Str", "help": "[optional]  The name of the group variable in the metadata. The group variable must be categorical and is required to detect structural zeros.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "__q2galaxy__::control::default", "options": [["None (Use default behavior)", "__q2galaxy__::control::default", true], ["Provide a value", "__q2galaxy__::control::provide", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "structural_zeros", "argument": null, "type": "boolean", "label": "structural_zeros: Bool", "help": "[default: No]  Whether to detect structurual zeros based on the `group` variable. Refer to the ANCOM-BC2 paper for an expalanation of the use of structural zeros.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "__q2galaxy__::literal::True", "falsevalue": "__q2galaxy__::literal::False"}, {"model_class": "BooleanToolParameter", "name": "asymptotic_cutoff", "argument": null, "type": "boolean", "label": "asymptotic_cutoff: Bool", "help": "[default: No]  Whether to classify a taxon as a structural zero using its asymptotic lower bound. Generally, it is recommended to set this parameter when the sample size per group is relatively large (n > 30). When this parameter is not set, a feature is classified as a structural zero in a group if its frequency is zero in that group. See the ANCOM-BC2 publication for details.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "__q2galaxy__::literal::True", "falsevalue": "__q2galaxy__::literal::False"}, {"model_class": "FloatToolParameter", "name": "alpha", "argument": null, "type": "float", "label": "alpha: Float % Range(0.0, 1.0, inclusive_start=False, inclusive_end=True)", "help": "[default: 0.05]  The significance level.", "help_format": "html", "refresh_on_change": false, "min": 1e-06, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.05", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "ancombc2_output", "format": "qza", "label": "${tool.name} on ${on_string}: ancombc2_output.qza", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "ancombc2_output.qza", "edam_format": "format_2333", "edam_data": "data_0006", "discover_datasets": []}], "panel_section_id": "qiime_2", "panel_section_name": "QIIME 2", "form_style": "regular"}