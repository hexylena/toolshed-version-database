{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/tcollins/rgi_main/rgi_main/6.0.5+galaxy0", "name": "RGI main", "version": "6.0.5+galaxy0", "description": "identify antimicrobial resistance genes using CARD", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["6.0.5+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "rgi_main", "owner": "tcollins", "changeset_revision": "15d244ecf848", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_sequence", "argument": "-i", "type": "data", "label": "Input sequences", "help": "FASTA or gzip-compressed FASTA file containing contigs or protein sequences.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz"], "edam": {"edam_formats": ["format_1929", "format_1929"], "edam_data": ["data_2044", "data_2044"]}, "multiple": false, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "tag": null}, {"model_class": "Conditional", "name": "card_source", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "cached", "inputs": [{"model_class": "SelectToolParameter", "name": "cached_card", "argument": null, "type": "select", "label": "CARD database", "help": "Select a pre-installed CARD release. Contact your Galaxy administrator if none are listed.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "annotation_model", "argument": null, "type": "select", "label": "Annotation model type", "help": "Controls which annotation FASTA is passed to rgi load. 'Homolog models only' is sufficient for standard AMR gene identification. 'All model types' loads the exten