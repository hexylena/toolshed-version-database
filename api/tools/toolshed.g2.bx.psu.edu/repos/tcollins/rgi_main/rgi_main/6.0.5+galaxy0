 To prepare: download card-variants.tar.bz2 from https://card.mcmaster.ca/download, extract and decompress all .gz files inside, then run: rgi wildcard_annotation --input_directory DIR --version VERSION --card_json card.json. Required to use Include wildcard variants.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz"], "edam": {"edam_formats": ["format_1929", "format_1929"], "edam_data": ["data_2044", "data_2044"]}, "multiple": false, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "tag": null}]}, {"model_class": "ConditionalWhen", "value": "all", "inputs": [{"model_class": "DataToolParameter", "name": "wildcard_annotation_all_models", "argument": null, "type": "data", "label": "WildCARD annotation FASTA \u2014 all models", "help": "wildcard_database_v*_all.fasta. To prepare: download card-variants.tar.bz2 from https://card.mcmaster.ca/download, extract and decompress all .gz files inside, then run: rgi wildcard_annotation --input_directory DIR --version VERSION --card_json card.json. Both FASTAs (homolog-only and all-models) are produced by the same command. Required when combining Include wildcard variants with Include other model types.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta", "fasta.gz"], "edam": {"edam_formats": ["format_1929", "format_1929"], "edam_data": ["data_2044", "data_2044"]}, "multiple": false, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "tag": null}]}], "test_param": {"model_class": "SelectToolParameter", "name": "wildcard_annotation_model", "argument": null, "type": "select", "label": "WildCARD annotation model type", "help": "Controls which WildCARD annotation FASTA is passed to rgi load. 'Homolog models only' is sufficient for standard variant detection. 'All model types' loads the extended WildCARD annotation database \u2014 required when using Include other model types.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "homolog", "options": [["Homolog models only", "homolog", true], ["All model types", "all", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "DataToolParameter", "name": "wildcard_index", "argument": null, "type": "data", "label": "WildCARD index file", "help": "index-for-model-sequences.txt from the WildCARD archive. Extract card-variants.tar.bz2 and decompress index-for-model-sequences.txt.gz from inside it to obtain this plain-text file.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt", "tabular"], "edam": {"edam_formats": ["format_2330", "format_3475"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "tag": null}, {"model_class": "TextToolParameter", "name": "wildcard_version", "argument": null, "type": "text", "label": "WildCARD version string", "help": "Version of the WildCARD data being loaded, e.g. 4.0.0. Find the version number in the WildCARD release notes at https://card.mcmaster.ca/download \u2014 it corresponds to the card-variants.tar.bz2 archive you downloaded.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "source", "argument": null, "type": "select", "label": "WildCARD variant database", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "none", "options": [["Do not load WildCARD", "none", true], ["Use a database installed by the administrator", "cached", false], ["Use files from your history", "history", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "Conditional", "name": "input_options", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "contig", "inputs": [{"model_class": "SelectToolParameter", "name": "orf_finder", "argument": "-g", "type": "select", "label": "ORF finding tool", "help": "PRODIGAL is the standard prokaryotic gene predictor. PYRODIGAL is a faster Python reimplementation that produces near-identical predictions.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "PRODIGAL", "options": [["PRODIGAL", "PRODIGAL", true], ["PYRODIGAL (faster)", "PYRODIGAL", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "protein", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "input_type", "argument": "-t", "type": "select", "label": "Input type", "help": "Nucleotide contigs require ORF prediction before alignment. Protein sequences are aligned directly, skipping gene prediction.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "contig", "options": [["Contig (nucleotide)", "contig", true], ["Protein", "protein", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "SelectToolParameter", "name": "alignment_tool", "argument": "-a", "type": "select", "label": "Alignment tool", "help": "DIAMOND is 20-100x faster than BLAST with minimal sensitivity loss for typical AMR databases. Use BLAST for small inputs or when maximum sensitivity is required.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "DIAMOND", "options": [["DIAMOND (faster)", "DIAMOND", true], ["BLAST (more sensitive)", "BLAST", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "data_type", "argument": "-d", "type": "select", "label": "Sequence data type", "help": "Genomic origin of the input sequences. Used to annotate results and does not change alignment behaviour. Select the most specific category that applies.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "NA", "options": [["Not specified (NA)", "NA", true], ["Whole-genome shotgun (wgs)", "wgs", false], ["Plasmid", "plasmid", false], ["Chromosome", "chromosome", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "Section", "name": "hit_inclusion", "type": "section", "title": "Hit inclusion options", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "include_loose", "argument": "--include_loose", "type": "boolean", "label": "Include loose hits", "help": "Report hits that partially satisfy CARD model thresholds (Loose hits). Increases sensitivity but raises the false-positive rate. By default only Perfect and Strict hits are reported.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--include_loose", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "include_nudge", "argument": "--include_nudge", "type": "boolean", "label": "Include nudged hits", "help": "Promote qualifying Loose hits to Strict classification based on genomic context (e.g. co-location with other AMR determinants). Only has an effect when loose hits are also enabled.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--include_nudge", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "low_quality", "argument": "--low_quality", "type": "boolean", "label": "Low quality / short contigs mode", "help": "Relax ORF prediction thresholds to recover partial or truncated genes from fragmented assemblies. Recommended for low-coverage or short-read assemblies.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--low_quality", "falsevalue": ""}]}], "outputs": [{"model_class": "ToolOutput", "name": "output_txt", "format": "tabular", "label": "${tool.name} on ${on_string}: AMR results (tabular)", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "staging/output.txt", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "output_json", "format": "json", "label": "${tool.name} on ${on_string}: AMR results (JSON)", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "staging/output.json", "edam_format": "format_3464", "edam_data": "data_0006", "discover_datasets": []}], "panel_section_id": "metagenomic_analysis", "panel_section_name": "Metagenomic Analysis", "form_style": "regular"}