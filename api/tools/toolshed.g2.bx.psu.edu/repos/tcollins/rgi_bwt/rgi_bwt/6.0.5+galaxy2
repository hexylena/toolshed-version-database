{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/tcollins/rgi_bwt/rgi_bwt/6.0.5+galaxy0", "name": "RGI bwt", "version": "6.0.5+galaxy0", "description": "align metagenomic reads to CARD to identify AMR genes", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["6.0.5+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "rgi_bwt", "owner": "tcollins", "changeset_revision": "c2ba21bd8f34", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "read_one", "argument": "-1", "type": "data", "label": "Read 1 (or single-end reads)", "help": "Quality-trimmed FASTQ reads. For single-end sequencing, provide only this file.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fastqsanger", "fastqsanger.gz", "fastq", "fastq.gz"], "edam": {"edam_formats": ["format_1932", "format_1932", "format_1930", "format_1930"], "edam_data": ["data_2044", "data_2044", "data_2044", "data_2044"]}, "multiple": false, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "tag": null}, {"model_class": "DataToolParameter", "name": "read_two", "argument": "-2", "type": "data", "label": "Read 2 (paired-end, optional)", "help": "Reverse reads for paired-end sequencing. Leave empty for single-end.", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fastqsanger", "fastqsanger.gz", "fastq", "fastq.gz"], "edam": {"edam_formats": ["format_1932", "format_1932", "format_1930", "format_1930"], "edam_data": ["data_2044", "data_2044", "data_2044", "data_2044"]}, "multiple": false, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "tag": null}, {"model_class": "Conditional", "name": "card_source", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "cached", "inputs": [{"model_class": "SelectToolParameter", "name": "cached_card", "argument": null, "type": "select", "label": "CARD database", "help": "Select a pre-installed CARD release. Contact your Galaxy administrator if none are listed.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "annotation_model", "argument": null, "type": "select", "label": "Annotation model type", "help": "Controls which annotation FASTA is passed to rgi load. 'Homolog models only' is sufficient for standard AMR gene identification. 'All model types' loads the extended annotation database covering protein variant, rRNA variant, knockout, and overexpression models \u2014 required when using Include other model types.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "homolog", "options": [["Homolog models only", "homolog", true], ["All model types", "all", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "history", "inputs": [{"model_class": "DataToolParameter", "name": "card_json", "argument": null, "type": "data", "label": "card.json", "help": "The card.json file from the CARD database. Download card-data.tar.bz2 from https://card.mcmaster.ca/download and extract card.json from the archive. For RGI main, card.json alone is sufficient for standard AMR gene detection. For RGI bwt, you must also supply an annotation FASTA below.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["json"], "edam": {"edam_formats": ["format_3464"], "edam_data": ["data_0006"]}, "multiple": false, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "tag": null}, {"model_class": "Conditional", "