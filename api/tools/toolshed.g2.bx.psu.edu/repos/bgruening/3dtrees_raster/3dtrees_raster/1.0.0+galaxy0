{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/bgruening/3dtrees_raster/3dtrees_raster/1.0.0+galaxy0", "name": "3Dtrees: Raster", "version": "1.0.0+galaxy0", "description": "forest-structure metrics, DTM, CHM and voxel counts", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.0.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "3dtrees_raster", "owner": "bgruening", "changeset_revision": "a4ac600a17e9", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "point_cloud", "argument": null, "type": "data", "label": "Segmented point cloud", "help": "One full-resolution point cloud with at least one tree instance dimension (PredInstance, PredInstance_SAT, PredInstance_FM or PredInstance_RCT); coordinates in metres, a CRS (if present) projected in metres.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["laz", "las"], "edam": {"edam_formats": ["format_2333", "format_2333"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Conditional", "name": "area", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "no", "inputs": []}, {"model_class": "ConditionalWhen", "value": "yes", "inputs": [{"model_class": "DataToolParameter", "name": "aoi", "argument": null, "type": "data", "label": "Area of interest", "help": "Polygon or MultiPolygon (GeoJSON) in the point cloud's coordinate system; it is not reprojected. Only whole tiles and voxel cells inside it are reported.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["geojson", "json"], "edam": {"edam_formats": ["format_3464", "format_3464"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "restrict", "argument": null, "type": "select", "label": "Restrict to an area of interest", "help": "Without an area of interest the full point-cloud extent is analysed.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "no", "options": [["No", "no", true], ["Yes", "yes", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "TextToolParameter", "name": "instance_dimension", "argument": "--instance-dimension", "type": "text", "label": "Instance dimensions", "help": "Leave empty to process every one present of PredInstance, PredInstance_SAT, PredInstance_FM and PredInstance_RCT. Or type one or more of them, separated by commas without spaces; each must exist in the point cloud, otherwise the job fails.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "denoise", "argument": "--denoise", "type": "boolean", "label": "Remove noise points", "help": "kNN distance filter: flags points whose mean distance to their nearest neighbours exceeds the whole cloud's mean plus two standard deviations (settings under Advanced parameters). The terrain model, canopy models and tile metrics then use the remaining points; raw voxel counts always include every recorded point.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--denoise knn", "falsevalue": "--denoise none"}, {"model_class": "Section", "name": "advanced", "type": "section", "title": "Advanced parameters", "help": "Defaults are the published 3Dtrees settings. Every run records the values it used in its run provenance.", "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "tile_size", "argument": "--tile-size", "type": "float", "label": "Tile size (m)", "help": "Width of the square analysis tiles.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 1000.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "20.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "grid_search_step", "argument": "--grid-search-step", "type": "float", "label": "Tile-grid search step (m)", "help": "Step of the offset search that places the tile grid. Must not exceed the tile size.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 1000.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "voxel_resolution", "argument": "--voxel-resolution", "type": "float", "label": "Metric voxel size (m)", "help": "Voxel edge length for the tile and tree metrics. Must divide 1 m evenly, for example 0.1, 0.2, 0.25, 0.5 or 1.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.2", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "voxel_count_resolution", "argument": "--voxel-count-resolution", "type": "float", "label": "Voxel count size (m)", "help": "Voxel edge length, horizontal and vertical, of the voxel point counts.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 10.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "dtm_resolution", "argument": "--dtm-resolution", "type": "float", "label": "DTM resolution (m)", "help": "Must divide 60 m evenly, for example 0.5, 1, 2 or 5.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 60.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "chm_resolution", "argument": "--chm-resolution", "type": "float", "label": "CHM resolution (m)", "help": "Must divide 1 m evenly, for example 0.1, 0.2, 0.25, 0.5 or 1.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "ptd_resolution", "argument": "--ptd-resolution", "type": "float", "label": "Ground-seed resolution (m)", "help": "Seed resolution of the progressive TIN densification (PTD) ground classification.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 1000.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "20.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "vegetation_minimum_height", "argument": "--vegetation-minimum-height", "type": "float", "label": "Minimum vegetation height (m)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "gap_height_threshold", "argument": "--gap-height-threshold", "type": "float", "label": "Gap height threshold (m)", "help": "CHM height below which a cell counts as a canopy gap.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "3.0", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "minimum_tree_voxels", "argument": "--minimum-tree-voxels", "type": "integer", "label": "Minimum tree voxels", "help": "Occupied metric voxels a segment needs to be accepted as a tree.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 1000000, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "apex_minimum_height", "argument": "--apex-minimum-height", "type": "float", "label": "Minimum apex height (m)", "help": "A tree's highest point must be strictly above this height.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "3.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "minimum_tree_thickness", "argument": "--minimum-tree-thickness", "type": "float", "label": "Minimum tree thickness (m)", "help": "Smallest PCA extent a tree must reach.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "raster_format", "argument": "--raster-format", "type": "select", "label": "Raster format", "help": "Format of the DTM, CHM, DSM and voxel-count rasters. A Cloud Optimized GeoTIFF is a regular GeoTIFF that web viewers can read in parts.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "COG", "options": [["Cloud Optimized GeoTIFF", "COG", true], ["GeoTIFF", "GTiff", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "minimum_occupied_layers", "argument": "--minimum-occupied-layers", "type": "integer", "label": "Minimum occupied layers", "help": "One-metre height layers a tree must occupy.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 100, "optional": false, "hidden": false, "is_dynamic": false, "value": "3", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "denoise_neighbors", "argument": "--denoise-neighbors", "type": "integer", "label": "Noise filter: neighbours", "help": "Nearest neighbours for each point's mean distance, counting the point itself as lidR::sor() does. Used only with Remove noise points.", "help_format": "html", "refresh_on_change": false, "min": 2, "max": 1000, "optional": false, "hidden": false, "is_dynamic": false, "value": "8", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "denoise_sigma", "argument": "--denoise-sigma", "type": "float", "label": "Noise filter: standard deviations", "help": "Points whose mean distance exceeds the whole cloud's mean plus this many standard deviations are flagged. Used only with Remove noise points.", "help_format": "html", "refresh_on_change": false, "min": 0.001, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "2.0", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutputCollection", "name": "tile_metrics", "format": null, "label": "${tool.name} on ${on_string}: Tile metrics", "hidden": false, "output_type": "collection", "default_format": "data", "format_source": null, "metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "csv", "visible": false, "assign_primary_output": false, "directory": "output/tile_metrics", "recurse": false, "match_relative_path": false, "sort_key": "designation", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<designation>.+)_tile_metrics\\.csv"}]}}, {"model_class": "ToolOutputCollection", "name": "segment_diagnostics", "format": null, "label": "${tool.name} on ${on_string}: Segment diagnostics", "hidden": false, "output_type": "collection