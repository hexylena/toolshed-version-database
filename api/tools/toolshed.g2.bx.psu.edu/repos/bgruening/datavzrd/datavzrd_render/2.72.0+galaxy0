{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/bgruening/datavzrd/datavzrd_render/2.72.0+galaxy0", "name": "datavzrd", "version": "2.72.0+galaxy0", "description": "Render visual and interactive HTML reports from tabular data", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["2.72.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "datavzrd", "owner": "bgruening", "changeset_revision": "f61acf355127", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_data", "argument": null, "type": "data", "label": "Input table(s)", "help": "One or more tabular datasets (CSV, TSV, JSON or Parquet) to include in the report. When using a custom configuration file, provide the tables in the same order as the datasets defined in that configuration file.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["csv", "tsv", "tabular", "json", "parquet"], "edam": {"edam_formats": ["format_3475", "format_3475", "format_3475", "format_3464", "format_2333"], "edam_data": ["data_0006", "data_0006", "data_0006", "data_0006", "data_0006"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Conditional", "name": "config_mode", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "auto", "inputs": [{"model_class": "TextToolParameter", "name": "report_name", "argument": null, "type": "text", "label": "Report name", "help": "Name of the generated report, shown in the report header", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "Datavzrd Report", "area": false, "datalist": []}]}, {"model_cla