: null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "max_in_memory_rows", "argument": null, "type": "integer", "label": "Maximum in-memory rows", "help": "Maximum number of rows of a table that are rendered into a single page (default: 20000). Tables with more rows are split into searchable pages.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "20000", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "output_html", "format": "html", "label": "${tool.name} on ${on_string}: interactive report", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_2331", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "output_zip", "format": "zip", "label": "${tool.name} on ${on_string}: zipped report", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_2333", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "graph_display_data", "panel_section_name": "Graph/Display Data", "form_style": "regular"}