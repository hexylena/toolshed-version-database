{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/bgruening/coco_annotation_visualizer/coco_annotation_visualizer/1.0.0", "name": "COCO Annotation Visualizer", "version": "1.0.0", "description": "Draw COCO bounding boxes, segmentation masks, and labels.", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.0.0"], "hidden_versions": [], "tool_shed_repository": {"name": "coco_annotation_visualizer", "owner": "bgruening", "changeset_revision": "7b390f574967", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "Conditional", "name": "input", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "image", "inputs": [{"model_class": "DataToolParameter", "name": "source", "argument": null, "type": "data", "label": "Input images", "help": "Select one or more images or a list collection. Filenames must match those in the COCO JSON.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["jpg", "png", "tiff"], "edam": {"edam_formats": ["format_3579", "format_3603", "format_3591"], "edam_data": ["data_2968", "data_2968", "data_2968"]}, "multiple": true, "min": null, "max": null, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}, {"model_class": "ConditionalWhen", "value": "video", "inputs": [{"model_class": "DataToolParameter", "name": "source", "argument": null, "type": "data", "label": "Input video file", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["mp4", "avi", "mov", "gif"], "edam": {"edam_formats": ["format_2333", "format_2333", "format_2333", "format_3467"], "edam_data": ["data_0006", "data_0006", "data_0006", "data_2968"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "IntegerToolParameter", "name": "vid_stride", "argument": "--vid_stride", "type": "integer", "label": "Frame stride", "help": "<strong>N \u2265 1 \u2014 Index-based matching (SAM3 tool output):</strong><br/>Process one frame every N frames. Each candidate frame is matched by name using the pattern<code>{video_name}_frame_{index:06d}</code>.<br/>Set N to the same stride value used when generating the COCO file.<br/><u>\u26a0 The video filename must match the one referenced in the COCO file (i.e. the name used when running SAM3).</u><br/><strong>N = 0 \u2014 Positional matching:</strong><br/>Ignore filenames entirely. The 1st COCO image entry is applied to the 1st video frame,the 2nd entry to the 2nd frame, and so on.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": 300, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "input_kind", "argument": "--input_kind", "type": "select", "label": "Input type", "help": "Choose either one or more images, or a single video file (not both).", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "image", "options": [["One or more images", "image", false], ["One video", "video", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "DataToolParameter", "name": "annotations", "argument": "--annotations", "type": "data", "label": "COCO annotation file", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["json"], "edam": {"edam_formats": ["format_3464"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "TextToolParameter", "name": "filter_categories", "argument": "--filter_categories", "type": "text", "label": "Filter categories ", "help": "Comma-separated list of category names to display. Leave empty to show all categories. Note: apostrophes (') are not supported in category names.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "Section", "name": "display", "type": "section", "title": "Display options", "help": null, "expanded": false, "inputs": [{"model_class": "BooleanToolParameter", "name": "show_bbox", "argument": "--show_bbox", "type": "boolean", "label": "Show bounding boxes", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "show_mask", "argument": "--show_mask", "type": "boolean", "label": "Show segmentation masks", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "show_labels", "argument": "--show_labels", "type": "boolean", "label": "Show category labels", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "show_count", "argument": "--show_count", "type": "boolean", "label": "Show annotation count", "help": "Draws the total number of visible annotations in the top-left corner of each image.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "FloatToolParameter", "name": "mask_opacity", "argument": "--mask_opacity", "type": "float", "label": "Mask opacity", "help": "Transparency of segmentation mask overlays (0 = transparent, 1 = opaque).", "help_format": "html", "refresh_on_change": false, "min": 0.05, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.4", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "bbox_thickness", "argument": "--bbox_thickness", "type": "integer", "label": "Bounding box thickness (pixels)", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 15, "optional": false, "hidden": false, "is_dynamic": false, "value": "2", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "font_scale", "argument": "--font_scale", "type": "float", "label": "Label font scale", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0.3, "max": 3.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.6", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "color_mode", "argument": "--color_mode", "type": "select", "label": "Color mode", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "per_category", "options": [["Per category (same color for each class) ", "per_category", true], ["Per instance (different color for each annotation) ", "per_instance", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "output_format", "argument": "--output_format", "type": "select", "label": "Output image format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "png", "options": [["PNG (lossless)", "png", true], ["JPEG (smaller file size)", "jpg", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "Conditional", "name": "output_mode", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "frames", "inputs": []}, {"model_class": "ConditionalWhen", "value": "video", "inputs": [{"model_class": "FloatToolParameter", "name": "video_fps", "argument": "--video_fps", "type": "float", "label": "Video frame rate (FPS)", "help": "Controls the speed of the output video. Set to <strong>0</strong> to auto-detect from the input video (recommended when input is a video file). For image inputs, set to the original acquisition rate (e.g. 25 fps for PAL, 30 fps for NTSC). If left at 0 with image input, 25 FPS is used.<br/>Example: 60 frames at <strong>60 FPS</strong> gives a <strong>1 second</strong> video, at <strong>10 FPS</strong> the same frames give a <strong>6 second</strong> video.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 120.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "both", "inputs": [{"model_class": "FloatToolParameter", "name": "video_fps", "argument": "--video_fps", "type": "float", "label": "Video frame rate (FPS)", "help": "Controls the speed of the output video. Set to <strong>0</strong> to auto-detect from the input video (recommended when input is a video file). For image inputs, set to the original acquisition rate (e.g. 25 fps for PAL, 30 fps for NTSC). If left at 0 with image input, 25 FPS is used.<br/>Example: 60 frames at <strong>60 FPS</strong> gives a <strong>1 second</strong> video, at <strong>10 FPS</strong> the same frames give a <strong>6 second</strong> video.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 120.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "mode", "argument": null, "type": "select", "label": "Output mode", "help": "Choose whether to output annotated frames, a compiled video, or both.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "frames", "options": [["Frames (one image per input frame) ", "frames", true], ["Video (compile all frames into a single video) ", "video", false], ["Both (frames and video) ", "both", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "only_annotated", "argument": "--only_annotated", "type": "boolean", "label": "Annotated frames only", "help": "When checked (default) : only frames that have at least one matching annotation are saved or compiled into the video. <br/>When unchecked: all frames are included", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}], "outputs": [{"model_class": "ToolOutputCollection", "name": "annotated_images", "format": null, "label": "Annotated images", "hidden": false, "output_type": "collection", "default_format": "data", "default_format_source": null, "default_metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": null, "visible": false, "assign_primary_output": false, "directory": "outputs/outputs_annotated", "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<name>.*)\\.(?P<ext>[^\\.]+)?"}]}}, {"model_class": "ToolOutput", "name": "output_video", "format": "mp4", "label": "Annotated video", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, 