{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/bgruening/pynxtools_peak_finding/pynxtools_peak_finding/0.1.0+galaxy0", "name": "XPS peak finding", "version": "0.1.0+galaxy0", "description": "in a NeXus spectrum, written back as NXfit/NXpeak", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.1.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "pynxtools_peak_finding", "owner": "bgruening", "changeset_revision": "0a6a35172776", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_nxs", "argument": null, "type": "data", "label": "XPS spectrum (NeXus/HDF5)", "help": "An already-converted NeXus file (for example NXxps) with a resolvable default NXdata group holding energy vs. intensity.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["nxxps"], "edam": {"edam_formats": ["format_3590"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "Section", "name": "peak_detection", "type": "section", "title": "Peak detection", "help": null, "expanded": true, "inputs": [{"model_class": "FloatToolParameter", "name": "prominence", "argument": "--prominence", "type": "float", "label": "Required prominence of peaks", "help": "How far a peak must stand out from the surrounding baseline, in the intensity units of the spectrum. Left empty, scipy applies no prominence filter and typically returns hundreds of peaks. For a survey spectrum in counts per second, 10000 is a reasonable starting point.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "distance", "argument": "--distance", "type": "float", "label": "Minimal horizontal distance between peaks", "help": "In data points, not energy units. Smaller peaks within this distance of a larger one are discarded. Try 20 for a survey spectrum.", "help_format": "html", "refresh_on_change": false, "min": 1.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "height", "argument": "--height", "type": "float", "label": "Required absolute height of peaks", "help": "Minimum intensity a peak must reach, in the intensity units of the spectrum. Unlike prominence this ignores the local baseline, so it is mostly useful for picking out only the strongest lines.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "output_nxs", "format": "nxxps", "label": "${tool.name} on ${on_string}: Annotated NeXus", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3590", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "peaks_tabular", "format": "tabular", "label": "${tool.name} on ${on_string}: Peak table", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "peaks_json", "format": "json", "label": "${tool.name} on ${on_string}: Peaks (JSON)", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3464", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "chemicaltoolbox", "panel_section_name": "ChemicalToolBox", "form_style": "regular"}