{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/bgruening/dna_foundation_models/dna_foundation_models/0.1.0+galaxy0", "name": "DNA Foundation Models", "version": "0.1.0+galaxy0", "description": "for generating embeddings or fine-tuning models on labeled datasets", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.1.0+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "dna_foundation_models", "owner": "bgruening", "changeset_revision": "53ebe5880f98", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "SelectToolParameter", "name": "selected_model", "argument": null, "type": "select", "label": "Select model", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": true, "value": null, "options": [], "display": null, "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "attn_vis", "argument": null, "type": "boolean", "label": "Visualize attention", "help": "Generate attention visualizations for all sequences in the input file (embedding generation) / test file (fine-tuning).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "Conditional", "name": "tasks", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "embed", "inputs": [{"model_class": "DataToolParameter", "name": "fasta_file", "argument": null, "type": "data", "label": "Input", "help": "FASTA file containing the DNA sequences to embed. Each FASTA record is processed                         as one sequence.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta"], "edam": {"edam_formats": ["format_1929"], "edam_data": ["data_2044"]}, "mul