l", "refresh_on_change": false, "min": 1, "max": 256, "optional": false, "hidden": false, "is_dynamic": false, "value": "8", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "lora_alpha", "argument": null, "type": "integer", "label": "LoRA alpha", "help": "Scaling factor applied to the LoRA updates. The magnitude of the adaptation's                                 contribution to the model's output is scaled by alpha/r.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 512, "optional": false, "hidden": false, "is_dynamic": false, "value": "16", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "lora_dropout", "argument": null, "type": "float", "label": "LoRA dropout", "help": "Dropout probability applied to the LoRA layers during training. Increasing                                 this value can provide additional regularization.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 0.8, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.1", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "target_modules", "argument": null, "type": "select", "label": "LoRA target modules", "help": "Select which modules LoRA should be applied to. At least one must be selected.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "Wqkv", "options": [["Wqkv (query/key/value projection)", "Wqkv", true], ["wo (output projection)", "wo", false]], "display": null, "multiple": true, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "false", "inputs": []}], "test_param": {"model_class": "SelectToolParameter", "name": "use_lora", "argument": null, "type": "select", "label": "Use LoRA", "help": "Enable Low-Rank Adaptation (LoRA) to fine-tune a smaller set of adapter parameters                             instead of updating all model parameters. This can reduce memory 