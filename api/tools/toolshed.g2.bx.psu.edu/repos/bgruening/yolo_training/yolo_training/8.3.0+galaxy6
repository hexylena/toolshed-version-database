, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "degree", "argument": null, "type": "float", "label": "Image rotation augmentation", "help": "Image rotation (+/- deg).", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 20.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "hsv_v", "argument": null, "type": "float", "label": "Image HSV-Value", "help": "Image HSV-Value augmentation (fraction).", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.4", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "hsv_s", "argument": null, "type": "float", "label": "Image HSV-Saturation", "help": "Image HSV-Saturation augmentation (fraction).", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.7", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "hsv_h", "argument": null, "type": "float", "label": "Image HSV-Hue", "help": "Image HSV-Hue augmentation (fraction).", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.015", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "init_lr", "argument": null, "type": "float", "label": "Learning rate", "help": "Initial learning rate for training.", "help_format": "html", "refresh_on_change": false, "min": 1e-05, "max": 0.1, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.01", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "weight_decay", "argument": null, "type": "float", "label": "Weight decay", "help": "", "help_format": "html", "refresh_on_change": false, "min": 0.0001, "max": 0.1,