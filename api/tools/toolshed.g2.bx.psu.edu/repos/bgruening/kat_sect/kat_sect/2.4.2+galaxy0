lue of 0 means no upper limit", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutput", "name": "output_counts", "format": "fasta", "label": "${tool.name} on ${on_string}: Per-sequence coverage counts", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "kat-sect-counts.cvg", "edam_format": "format_1929", "edam_data": "data_2044", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "output_stats", "format": "tabular", "label": "${tool.name} on ${on_string}: Per-sequence summary stats", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "kat-sect-stats.tsv", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "output_gc_counts", "format": "fasta", "label": "${tool.name} on ${on_string}: Per-sequence GC counts", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "kat-sect-counts.gc", "edam_format": "format_1929", "edam_data": "data_2044", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "output_nr_fasta", "format": "fasta", "label": "${tool.name} on ${on_string}: Non-repetitive regions FASTA", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "kat-sect-non_repetitive.fa", "edam_format": "format_1929", "edam_data": "data_2044", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "output_r_fasta", "format": "fasta", "label": "${tool.n