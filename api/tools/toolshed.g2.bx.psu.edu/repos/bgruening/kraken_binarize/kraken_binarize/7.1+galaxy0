{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/bgruening/kraken_binarize/kraken_binarize/7.1+galaxy0", "name": "Kraken Binarize", "version": "7.1+galaxy0", "description": "binarise document images", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["7.0.2+galaxy1", "7.1+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "kraken_binarize", "owner": "bgruening", "changeset_revision": "d62a46e0b96a", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "image", "argument": null, "type": "data", "label": "Image or document", "help": "multipage is only supported for PDF inputs", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["jpg", "png", "tiff", "pdf"], "edam": {"edam_formats": ["format_3579", "format_3603", "format_3591", "format_3508"], "edam_data": ["data_2968", "data_2968", "data_2968", "data_2968"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "out_ext", "argument": null, "type": "select", "label": "Output format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "png", "options": [["png", "png", true], ["tiff", "tiff", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "FloatToolParameter", "name": "threshold", "argument": "--threshold", "type": "float", "label": "Black-and-white threshold", "help": "Cutoff used to classify pixels as black or white after background correction and brightness normalization. Increase it to classify more pixels as black, which may recover faint text but add noise; decrease it to keep more pixels white, which may reduce noise but remove faint strokes.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 0.999, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "Section", "name": "background_estimation", "type": "section", "title": "Background estimation", "help": "Controls how Kraken estimates the local page background. Adjust these settings for uneven illumination, shadows, paper texture, or faint text.", "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "zoom", "argument": "--zoom", "type": "float", "label": "Zoom (scale factor)", "help": "Lower values downsample the page more strongly, producing a smoother and faster background estimate; higher values retain more image detail but require more processing time.", "help_format": "html", "refresh_on_change": false, "min": 0.1, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.5", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "perc", "argument": "--perc", "type": "integer", "label": "Brightness percentile", "help": "Control how the local page background is estimated from nearby pixel brightness values to correct uneven illumination and shadows. Higher values use brighter pixels for this estimate and may preserve faint text, but can retain more noise. Lower values may suppress noise but can also remove faint strokes.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 100, "optional": false, "hidden": false, "is_dynamic": false, "value": "80", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "range", "argument": "--range", "type": "integer", "label": "Window size", "help": "Control the size of the surrounding area used to estimate the local page background. Increase it for a smoother background-brightness estimate that is less sensitive to noise and paper texture, but less responsive to small illumination changes. Decrease it to follow local changes more closely, although text strokes, noise, or texture may then influence the estimate.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 100, "optional": false, "hidden": false, "is_dynamic": false, "value": "20", "area": false, "datalist": []}]}, {"model_class": "Section", "name": "brightness_normalization", "type": "section", "title": "Brightness normalization", "help": "Control which parts of the page are sampled and which brightness values are treated as black and white when normalizing the image after background correction. Border areas excluded from estimation are not cropped from the output.", "expanded": false, "inputs": [{"model_class": "FloatToolParameter", "name": "escale", "argument": "--escale", "type": "float", "label": "Text-region estimation scale", "help": "Control the scale used to identify areas with brightness variation that are likely to contain text. Increase it for larger text or broader foreground features; decrease it for smaller text or finer details.", "help_format": "html", "refresh_on_change": false, "min": 0.02, "max": 10.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "border", "argument": "--border", "type": "float", "label": "Border fraction excluded from estimation", "help": "Fraction excluded at each page edge when estimating the black and white brightness values. Increase it to reduce the influence of scanner borders, shadows, or dark margins; decrease it to sample more of the page edges. This does not crop the output image.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 0.499, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.1", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "low", "argument": "--low", "type": "integer", "label": "Percentile for black estimation", "help": "Percentile used to select the brightness value treated as black. Increase it to reduce the influence of extremely dark speckles or stains and map more pixels toward black. Decrease it to let darker pixels determine the black reference, which can make faint strokes lighter after normalization.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 100, "optional": false, "hidden": false, "is_dynamic": false, "value": "5", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "high", "argument": "--high", "type": "integer", "label": "Percentile for white estimation", "help": "Percentile used to select the brightness value treated as white. Increase it to use a brighter white reference, which may preserve faint strokes but can be influenced by glare or other bright artifacts. Decrease it to reduce the influence of the brightest pixels, but this can make faint strokes lighter after normalization.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 100, "optional": false, "hidden": false, "is_dynamic": false, "value": "90", "area": false, "datalist": []}]}], "outputs": [{"model_class": "ToolOutputCollection", "name": "pdf_output", "format": null, "label": "${tool.name} pages on ${on_string}", "hidden": false, "output_type": "collection", "default_format": "data", "default_format_source": null, "default_metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": null, "visible": false, "assign_primary_output": false, "directory": null, "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<designation>.+)\\.(?P<ext>png|tiff)"}]}}, {"model_class": "ToolOutput", "name": "output", "format": "png", "label": "${tool.name} on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3603", "edam_data": "data_2968", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "digital_humanities", "panel_section_name": "Digital Humanities", "form_style": "regular"}