{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/bgruening/drs_transcript_prediction/drs_transcript_prediction/1.0.5+galaxy0", "name": "drs-transcript-prediction", "version": "1.0.5+galaxy0", "description": "Predicts transcripts from direct RNA sequencing reads for organisms without splicing", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [{"value": "drs-transcript-prediction", "type": "bio.tools"}], "versions": ["1.0.5+galaxy0"], "hidden_versions": [], "tool_shed_repository": {"name": "drs_transcript_prediction", "owner": "bgruening", "changeset_revision": "8277ab2a0123", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "reads_bed", "argument": "--reads_bed", "type": "data", "label": "Reads BED file", "help": "Position-sorted BED file of direct RNA sequencing reads. The first 6 BED columns (chrom, start, end, name, score, strand) are required. A read is only used if it lies entirely within a range of the same strand. Leading '#', 'track', 'browser' and blank lines are skipped.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["bed"], "edam": {"edam_formats": ["format_3003"], "edam_data": ["data_3002"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "ranges_bed", "argument": "--ranges_bed", "type": "data", "label": "Ranges BED file", "help": "BED file of distinct, non-overlapping interval ranges per strand. The first 4 columns (chrom, start, end, strand) are read and any additional columns are ignored. Leading '#', 'track', 'browser' and blank lines are skipped. A typical source is a strand-aware 'bedtools merge' over the reads BED.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["bed"], "edam": {"edam_formats": ["format_3003"], "edam_data": ["data_3002"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "TextToolParameter", "name": "chromosome", "argument": "--chromosome", "type": "text", "label": "Chromosome to analyze", "help": "Restrict the analysis to this single chromosome/contig ID. Leave empty to loop over all chromosomes present in the ranges file. The ID is compared as a string, so numeric chromosome names (e.g. '1') work as expected.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "Section", "name": "sec_region", "type": "section", "title": "Region filtering", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "min_depth", "argument": "--min_depth", "type": "integer", "label": "Minimum depth per region", "help": "Minimum required depth for a distinct region to have candidate transcripts searched for.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_depth", "argument": "--max_depth", "type": "integer", "label": "Maximum depth per region", "help": "Maximum allowed depth for a distinct region. Regions above this depth are skipped and reported in the tool output. Leave empty to disable the maximum threshold.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "min_region_positional_depth", "argument": "--min_region_positional_depth", "type": "integer", "label": "Minimum positional depth within a region", "help": "Minimum required positional depth within a region. Reads mapping to positions below this threshold are discarded and new distinct sub-regions are created from the remaining runs of positions. Sub-region names gain a '/N' suffix.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "2", "area": false, "datalist": []}]}, {"model_class": "Section", "name": "sec_candidate", "type": "section", "title": "Candidate and transcript filtering", "help": null, "expanded": false, "inputs": [{"model_class": "IntegerToolParameter", "name": "candidate_offset_len", "argument": "--candidate_offset_len", "type": "integer", "label": "Minimum distance between candidate coordinates", "help": "Candidate start/end coordinates can be very close together. When a candidate start or end coordinate is encountered, require the next candidate position to be at least this many bases away.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "100", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "depth_delta_threshold", "argument": "--depth_delta_threshold", "type": "integer", "label": "Depth change threshold for start/stop sites", "help": "If the absolute change in depth between two consecutive positions exceeds this number, consider it a potential transcript start or stop site.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "4", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "candidate_read_threshold", "argument": "--candidate_read_threshold", "type": "integer", "label": "Minimum overlapping reads per candidate", "help": "Discard a candidate transcript if the number of reads overlapping within it is below this threshold.", "help_format": "html", "refresh_on_change": false, "min": 0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "2", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "assigned_read_ratio_threshold", "argument": "--assigned_read_ratio_threshold", "type": "float", "label": "Minimum assigned read ratio", "help": "Ratio of reads assigned solely to a candidate transcript to all reads overlapping within that transcript. Transcripts exceeding this ratio are kept in the predicted output.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.2", "area": false, "datalist": []}]}, {"model_class": "BooleanToolParameter", "name": "candidates_only", "argument": null, "type": "boolean", "label": "Output candidate transcripts only", "help": "Skip the alternative-transcript filtering step and only report the candidate transcripts BED. The predicted transcripts BED and GFF3 outputs are not produced.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--candidates_only", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "verbose", "argument": null, "type": "boolean", "label": "Verbose output", "help": "Print the resolved arguments and per-region progress to the tool output.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "-v", "falsevalue": ""}], "outputs": [{"model_class": "ToolOutput", "name": "candidates_bed", "format": "bed", "label": "${tool.name} candidate transcripts on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "output.candidates.bed", "edam_format": "format_3003", "edam_data": "data_3002", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "predicted_transcripts_bed", "format": "bed", "label": "${tool.name} predicted transcripts on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "output.bed", "edam_format": "format_3003", "edam_data": "data_3002", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "predicted_transcripts_gff3", "format": "gff3", "label": "${tool.name} predicted transcripts (GFF3) on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "output.gff3", "edam_format": "format_1975", "edam_data": "data_1255", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "rna_analysis", "panel_section_name": "RNA Analysis", "form_style": "regular"}