alse, "value": true, "truevalue": "true", "falsevalue": "false"}]}]}]}, {"model_class": "ConditionalWhen", "value": "criteria", "inputs": [{"model_class": "IntegerToolParameter", "name": "max_number", "argument": null, "type": "integer", "label": "Maximum number of paths", "help": "Will select (up to) this many paths, ordered by ascending path length, subject to criteria below. If unset, will select all that meet the criteria.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "max_path_length", "argument": null, "type": "float", "label": "Maximum path length", "help": "Exclude paths with lengths greater than this (expressed in Angstrom). If unset, will not restrict based on path length.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_amplitude_ratio", "argument": null, "type": "float", "label": "Minimum amplitude ratio (%)", "help": "Exclude paths with a ratio below this ratio (expressed as a percentage). If unset, will not restrict based on amplitude ratio.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_degeneracy", "argument": null, "type": "integer", "label": "Maximum degeneracy", "help": "Exclude paths with degeneracy above this value. If unset, will not restrict based on degeneracy.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "combinations", "inputs": [{"model_class": "IntegerToolParameter", "name": "min_combination_size", "argument": null, "type": "integer", "label": "Minimum combination size", "help": "Each combination will have at least this many paths. If less then this many paths match the below criteria, a single combination with all paths will be generated.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_combination_size", "argument": null, "type": "integer", "label": "Maximum combination size", "help": "Each combination will have at most this many paths. Note this is distinct from the number of paths to consider, below. One might want to consider combinations of the 5 shortest paths (set using 'Maximum number of paths'), but have no more than 3 paths in each combination (set using this).", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_number", "argument": null, "type": "integer", "label": "Maximum number of paths", "help": "Will select (up to) this many paths, ordered by ascending path length, subject to criteria below. If unset, will select all that meet the criteria.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "max_path_length", "argument": null, "type": "float", "label": "Maximum path length", "help": "Exclude paths with lengths greater than this (expressed in Angstrom). If unset, will not restrict based on path length.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "min_amplitude_ratio", "argument": null, "type": "float", "label": "Minimum amplitude ratio (%)", "help": "Exclude paths with a ratio below this ratio (expressed as a percentage). If unset, will not restrict based on amplitude ratio.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "IntegerToolParameter", "name": "max_degeneracy", "argument": null, "type": "integer", "label": "Maximum degeneracy", "help": "Exclude paths with degeneracy above this value. If unset, will not restrict based on degeneracy.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "manual", "inputs": [{"model_class": "Repeat", "name": "paths", "type": "repeat", "title": "Select paths", "help": "Identify paths to use in the fitting by their id, and optionally define their variables. This will overwrite and defaults set above.", "default": 0, "min": 0, "max": null, "inputs": [{"model_class": "IntegerToolParameter", "name": "id", "argument": null, "type": "integer", "label": "Path ID", "help": "Numerical id of a path to select, this appears at the end of the label and filename in the path summary CSV.", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1", "area": false, "datalist": []}, {"model_class": "Section", "name": "degen", "type": "section", "title": "N: path degeneracy", "help": null, "expanded": false, "inputs": [{"model_class": "TextToolParameter", "name": "name", "argument": null, "type": "text", "label": "Name", "help": "The name of the variable should be unique, and can be used in expressions for other paths. If name is set, will overwrite the default bevaviour for this variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "value", "argument": null, "type": "float", "label": "Value", "help": "The initial value for 'degen'. This will depend on the structure and path in question. If unset, then the path default will be used.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "expr", "argument": null, "type": "text", "label": "Expression", "help": "If set, the variable will be 'Defined' by the expression. This can include other variable name, for example in order to set two paths to use the same variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "vary", "argument": null, "type": "boolean", "label": "Vary", "help": "If True, the initial 'Guess' will be optimised in the fitting. If False, the value will be 'Set' instead and not optimised.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}]}, {"model_class": "Section", "name": "s02", "type": "section", "title": "S02: passive electron reduction factor", "help": null, "expanded": false, "inputs": [{"model_class": "TextToolParameter", "name": "name", "argument": null, "type": "text", "label": "Name", "help": "The name of the variable should be unique, and can be used in expressions for other paths. If name is set, will overwrite the default bevaviour for this variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "value", "argument": null, "type": "float", "label": "Value", "help": "The initial value for 's02'. This is typically between 0.7 and 1.0.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 1.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "expr", "argument": null, "type": "text", "label": "Expression", "help": "If set, the variable will be 'Defined' by the expression. This can include other variable name, for example in order to set two paths to use the same variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "vary", "argument": null, "type": "boolean", "label": "Vary", "help": "If True, the initial 'Guess' will be optimised in the fitting. If False, the value will be 'Set' instead and not optimised.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}]}, {"model_class": "Section", "name": "e0", "type": "section", "title": "E0: energy shift", "help": null, "expanded": false, "inputs": [{"model_class": "TextToolParameter", "name": "name", "argument": null, "type": "text", "label": "Name", "help": "The name of the variable should be unique, and can be used in expressions for other paths. If name is set, will overwrite the default bevaviour for this variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "value", "argument": null, "type": "float", "label": "Value", "help": "The initial value for 'e0'. This should be close to zero, as it represents the difference in the absorption edge positions between simulation and experiment.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "expr", "argument": null, "type": "text", "label": "Expression", "help": "If set, the variable will be 'Defined' by the expression. This can include other variable name, for example in order to set two paths to use the same variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "vary", "argument": null, "type": "boolean", "label": "Vary", "help": "If True, the initial 'Guess' will be optimised in the fitting. If False, the value will be 'Set' instead and not optimised.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}]}, {"model_class": "Section", "name": "deltar", "type": "section", "title": "Delta R: change in path length", "help": null, "expanded": false, "inputs": [{"model_class": "TextToolParameter", "name": "name", "argument": null, "type": "text", "label": "Name", "help": "The name of the variable should be unique, and can be used in expressions for other paths. If name is set, will overwrite the default bevaviour for this variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "value", "argument": null, "type": "float", "label": "Value", "help": "The initial value for 'alpha'. This should be close to zero, as it represents the difference in the FEFF path and fitted (experimental) path length.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "expr", "argument": null, "type": "text", "label": "Expression", "help": "If set, the variable will be 'Defined' by the expression. This can include other variable name, for example in order to set two paths to use the same variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "vary", "argument": null, "type": "boolean", "label": "Vary", "help": "If True, the initial 'Guess' will be optimised in the fitting. If False, the value will be 'Set' instead and not optimised.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}]}, {"model_class": "Section", "name": "sigma2", "type": "section", "title": "Sigma2: mean squared displacement", "help": null, "expanded": false, "inputs": [{"model_class": "TextToolParameter", "name": "name", "argument": null, "type": "text", "label": "Name", "help": "The name of the variable should be unique, and can be used in expressions for other paths. If name is set, will overwrite the default bevaviour for this variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "value", "argument": null, "type": "float", "label": "Value", "help": "The initial value for 'sigma2'. This should be small, but non-zero, as atomic vibrations will result in variation in exact positions.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.003", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "expr", "argument": null, "type": "text", "label": "Expression", "help": "If set, the variable will be 'Defined' by the expression. This can include other variable name, for example in order to set two paths to use the same variable.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "vary", "argument": null, "type": "boolean", "label": "Vary", "help": "If True, the initial 'Guess' will be optimised in the fitting. If False, the value will be 'Set' instead and not optimised.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "true", "falsevalue": "false"}]}]}]}], "test_param": {"model_class": "SelectToolParameter", "name": "selection", "argument": null, "type": "select", "label": "Selection method", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "all", "options": [["All paths", "all", true], ["Criteria", "criteria", false], ["Combinations", "combinations", false], ["Manual", "manual", false]], "display": null, "multiple": false, "textable": false}}]}], "outputs": [{"model_class": "ToolOutputCollection", "name": "sp_collection", "format": null, "label": "Selected path combinations for ${on_string}", "hidden": false, "output_type": "collection", "default_format": "sp", "format_source": null, "metadata_source": null, "inherit_format": false, "inherit_metadata": false, "structure": {"collection_type": "list", "collection_type_source": null, "collection_type_from_rules": null, "structured_like": null, "discover_datasets": [{"discover_via": "pattern", "format": "sp", "visible": false, "assign_primary_output": false, "directory": "sp", "recurse": false, "match_relative_path": false, "sort_key": "filename", "sort_comp": "lexical", "sort_reverse": false, "pattern": "(?P<name>.*)\\.(?P<ext>[^\\.]+)?"}]}}, {"model_class": "ToolOutput", "name": "merged_directories", "format": "zip", "label": "Merged directories from ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "merged.zip", "edam_format": "format_2333", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "gds_csv", "format": "gds", "label": "GDS values for ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "gds.csv", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "sp_csv", "format": "sp", "label": "Selected paths for ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "sp.csv", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "xas", "panel_section_name": "XAS (X-ray Absorption Spectroscopy)", "form_style": "regular"}