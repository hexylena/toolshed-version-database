aram": {"model_class": "SelectToolParameter", "name": "format", "argument": null, "type": "select", "label": "Input format", "help": "Whether data is in tabular or NeXus (h5) format, or has already saved as an Athena project", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "plaintext", "options": [["NeXus/tabular", "plaintext", true], ["Athena project", "athena", false]], "display": "radio", "multiple": false, "textable": false}}]}], "test_param": {"model_class": "SelectToolParameter", "name": "merge_inputs", "argument": null, "type": "select", "label": "Merge multiple inputs", "help": "Whether to merge all input data into one Athena project, by default each dataset or file in a zip will result in a separate output.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["No", "", true], ["Yes", "true", false]], "display": "radio", "multiple": false, "textable": false}}, {"model_class": "TextToolParameter", "name": "annotation", "argument": null, "type": "text", "label": "Annotation", "help": "If set, will annotate the output project(s) with this string. This will be used to generate legends when plotting data.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "Section", "name": "processing", "type": "section", "title": "Processing Options", "help": "By default, the following processing steps will be performed either with default values, or those contained in the input Athena project (if used). If specified here, these values will be used instead for process in sequence.", "expanded": true, "inputs": [{"model_class": "Conditional", "name": "calibrate", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "", "inputs": []}, {"model_class": "ConditionalWhen", "value": "true", "inputs": [{"model_class": "FloatToolParameter", "name": "calibration_e0", "argument": null, "type": "float", "label": "Calibration energy (eV)", "help": "If set, data will be calibrated so that the edge occurs at this energy (after merging, if relevant). Note that this is different from specifying E0 in the pre-edge normalization, as this will the x-axis of the data (so that the Nth x point will no longer align with the Nth y point).", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "energy_min", "argument": null, "type": "float", "label": "Minimum energy (eV)", "help": "If set, data will be cropped below this value in electron volts (after re-calibrating).", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "energy_max", "argument": null, "type": "float", "label": "Maximum energy (eV)", "help": "If set, data will be cropped above this value in electron volts (after re-calibrating).", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}], "test_param": {"model_class": "SelectToolParameter", "name": "calibrate", "argument": null, "type": "select", "label": "Calibrate energy", "help": "If set, will shift the spectrum so that its (automatically determined) edge occurs at the specified value, and any values outside the range will be discarded.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "options": [["False", "", true], ["True", "true", false]], "display": "radio", "multiple": false, "textable": false}}, {"model_class": "BooleanToolParameter", "name": "rebin", "argument": null, "type": "boolean", "label": "Re-bin data", "help": "Whether to re-bin along the energy axis to automatically ensure appropriate levels of precision in the pre-edge, near-edge and extended region of the spectrum.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "Conditional", "name": "pre_edge", "type": "conditional", "cases": [{"model_class": "ConditionalWhen", "value": "", "inputs": []}, {"model_class": "ConditionalWhen", "value": "ref", "inputs": [{"model_class": "TextToolParameter", "name": "ref_channel", "argument": null, "type": "text", "label": "Reference channel", "help": "The channel to be used as a refernce to determine the pre-edge settings which are then used for the main signal. This can help when the main signal is affected by signal noise.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "manual", "inputs": [{"model_class": "FloatToolParameter", "name": "e0", "argument": "e0", "type": "float", "label": "Edge energy (eV)", "help": "If set, normalization will use this as the location of the edge rather than automatically determining it.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "pre1", "argument": "pre1", "type": "float", "label": "Pre-edge fit lower energy (eV)", "help": "The lower end of the region used for the pre-edge fitting, relative to the edge energy (and therefore negative).", "help_format": "html", "refresh_on_change": false, "min": null, "max": 0.0, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "