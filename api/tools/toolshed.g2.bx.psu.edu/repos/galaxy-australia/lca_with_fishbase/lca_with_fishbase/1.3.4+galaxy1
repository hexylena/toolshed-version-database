, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "cutoff", "argument": "--cutoff", "type": "float", "label": "Identity window (percentage points)", "help": "At each rank, the hits within this many percentage points of the top hit decide the assignment. Hits that agree give a name; hits that disagree give 'dropped'", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.0", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "use_bitwise", "argument": "--use_bitwise", "type": "boolean", "label": "Rank the hits by bit score", "help": "Yes: the top hit is the hit with the highest bit score. No: the top hit is the hit with the highest percent identity", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": true, "truevalue": "--use_bitwise", "falsevalue": ""}, {"model_class": "BooleanToolParameter", "name": "normalise_identity", "argument": "--normalise_identity", "type": "boolean", "label": "Normalise identity by query coverage", "help": "Multiplies the percent identity of each hit by its query coverage before the comparison", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "--normalise_identity", "falsevalue": ""}, {"model_class": "SelectToolParameter", "name": "log_level", "argument": "--log_level", "type": "select", "label": "Log detail", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "INFO", "options": [["Normal", "INFO", true], ["Detailed", "DEBUG", false], ["Warnings only", "WARNING", false]], "display": null, "multiple": false, "textable": false}], "outputs": [{"model_class": "ToolOutput", "name": "lca_output", "format": "tabular", "label": "${tool.name} on ${on_string}: LCA table", "h