{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/galaxy-australia/lca_with_fishbase/lca_with_fishbase/1.3.4+galaxy1", "name": "LCA with FishBase", "version": "1.3.4+galaxy1", "description": "assign taxonomy to eDNA sequences from BLAST hits", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.3.4+galaxy1"], "hidden_versions": [], "tool_shed_repository": {"name": "lca_with_fishbase", "owner": "galaxy-australia", "changeset_revision": "de38d7381ab8", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "blast_results", "argument": null, "type": "data", "label": "BLAST table", "help": "BLAST tabular output with the 22 columns qseqid sseqid staxids sscinames scomnames sskingdoms pident length qlen slen mismatch gapopen gaps qstart qend sstart send stitle evalue bitscore qcovs qcovhsp, in this order", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "asv_table", "argument": null, "type": "data", "label": "ASV table with sequences", "help": "Read counts per sample. First column: the sequence name as in the BLAST table (ASV); last column: the sequence (ASV_sequence); a header line", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["tabular"], "edam": {"edam_formats": ["format_3475"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "opt