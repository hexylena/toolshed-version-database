[], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile5_corUrbanValues_rds", "argument": null, "type": "data", "label": "Urban CORINE CLC codes (optional)", "help": "Path to an .rds file containing a vector of CORINE CLC class codes classified as urban (codes 100-199). Only required when 'additional_candidate_classes_to_consider' is 'all_artificial_surface_classes'. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "additional_candidate_classes_to_consider", "argument": null, "type": "select", "label": "Additional candidate classes to consider (optional)", "help": "One of 'all_artificial_surface_classes' (use only the other urban CORINE classes, from inputFile5_corUrbanValues_rds) or 'all_other_classes' (use all other CORINE classes from the legend). If not supplied, this additional-classes step is skipped entirely.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "options": [["all_artificial_surface_classes", "all_artificial_surface_classes", false], ["all_other_classes", "all_other_classes", false]], "display": null, "multiple": false, "textable": false}]}, {"model_class": "ConditionalWhen", "value": "check-names", "inputs": [{"model_class": "TextToolParameter", "name": "species_names_list", "argument": null, "type": "text", "label": "Species names (List of species)", "help": "List of species names to check from the standard database (FishBase).", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "DataToolParameter", "name": "species_names_url", "argument": null, "type": "data", "label": "Species names to check", "help": "URL to a table containing the occurrences from any source. This can be the outcome of the match-data process. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "TextToolParameter", "name": "colname_species", "argument": null, "type": "text", "label": "Column name including species names", "help": "Column name that indicate the Species in the provided dataset. Only required you provide tabular occurrence data. Example: 'species'", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "percent_correctness", "argument": null, "type": "float", "label": "Species name correctness in percent", "help": "An number indicating the percentage of species name correctness that should be allowed to be replaced. High values ensure a perfect match from the standard database.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "BooleanToolParameter", "name": "bool_merge", "argument": null, "type": "boolean", "label": "Merge checked species names on the dataset", "help": "If a dataframe with species names is provided and this is YES, then all columns are returned. For only one species, the merge will be set automatically to false.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "True", "falsevalue": "False"}, {"model_class": "BooleanToolParameter", "name": "bool_synonym", "argument": null, "type": "boolean", "label": "Synonym checks", "help": "Return synonym checks from FishBase.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "True", "falsevalue": "False"}, {"model_class": "BooleanToolParameter", "name": "bool_ecosystem_type", "argument": null, "type": "boolean", "label": "Output ecosytem types", "help": "Return ecoystem checks for species from FishBase including marine, freshwater, and brackish.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "True", "falsevalue": "False"}, {"model_class": "BooleanToolParameter", "name": "bool_rm_duplicates", "argument": null, "type": "boolean", "label": "Remove duplicates", "help": "Remove duplicates from the dataset.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "True", "falsevalue": "False"}]}, {"model_class": "ConditionalWhen", "value": "clean-catchment-geometry", "inputs": [{"model_class": "TextToolParameter", "name": "inputFile1_gpkg", "argument": null, "type": "text", "label": "Polygon dataset (e.g. river catchments) to be validated.", "help": "URL to the polygon dataset that you want to validate (e.g. river catchments).", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "combine-eurostat-data", "inputs": [{"model_class": "SelectToolParameter", "name": "country_code", "argument": null, "type": "select", "