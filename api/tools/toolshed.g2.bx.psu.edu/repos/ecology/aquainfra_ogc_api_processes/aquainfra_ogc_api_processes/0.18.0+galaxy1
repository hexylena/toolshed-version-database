": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile5_censusgrid_rds", "argument": null, "type": "data", "label": "Census grid", "help": "Path to an .rds file containing the Eurostat census grid (human population), used to derive population density class breaks. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile6_evaluateWeighted_rds", "argument": null, "type": "data", "label": "Weighted refinement evaluation results", "help": "Path to an .rds file containing the census grid with weighted dasymetric refinement results joined (observed vs. estimated population, absolute and percentage differences). (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile7_catchment_gpkg", "argument": null, "type": "data", "label": "Catchment geometry", "help": "Path to a GeoPackage file containing the ECRINS catchment boundary, overlaid on all maps for context. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile8_popFocusYear_rds", "argument": null, "type": "data", "label": "Population focus year", "help": "Path to an .rds file containing the focus year for population data as a single value. Allowed years are 2011 through 2024. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile9_lauInCatchFocus_rds", "argument": null, "type": "data", "label": "LAU in catchment (focus year)", "help": "Path to an .rds file containing LAU polygons within the catchment, with observed population for the focus year. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile10_lauInCatchReference_rds", "argument": null, "type": "data", "label": "LAU in catchment (reference year 2021)", "help": "Path to an .rds file containing LAU polygons within the catchment, with observed population for reference year 2021. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile11_corineCLCvalid_rds", "argument": null, "type": "data", "label": "Valid CORINE CLC raster", "help": "Path to an .rds file containing the CORINE CLC raster (SpatRaster, packed via terra::wrap) restricted to valid classes used in the refinement. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile12_corineCLConlyPositive_rds", "argument": null, "type": "data", "label": "CORINE CLC overlapping positive census grid", "help": "Path to an .rds file containing the CORINE CLC raster (SpatRaster, packed via terra::wrap) restricted to cells overlapping census grid cells with positive observed population. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile13_refinement_rds", "argument": null, "type": "data", "label": "Estimated population raster (focus year)", "help": "Path to an .rds file containing the dasymetric refinement output raster (band named 'pop_est') with estimated population for the focus year. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "FloatToolParameter", "name": "thresholdval", "argument": null, "type": "float", "label": "Percentage error threshold", "help": "Threshold value (0-100) for percentage errors to be considered acceptable ('green') in the binary percentage error map.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "thresholdvalfortruth", "argument": null, "type": "float", "label": "Observed population truth threshold", "help": "Threshold value (0-100) for the observed census grid population, above which a cell with 100% error is flagged as a special non-estimated case rather than plotted as a normal error.", "help_format": "html", "refresh_on_change": false, "min": 0.0, "max": 100.0, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.0", "area": false, "datalist": []}, {"model_class": "DataToolParameter", "name": "inputFile14_metrics_rds", "argument": null, "type": "data", "label": "Accuracy metrics (weighted)", "help": "Path to an .rds file containing accuracy metrics for the weighted dasymetric refinement. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile15_metricsSimple_rds", "argument": null, "type": "data", "label": "Accuracy metrics (simple/unweighted)", "help": "Path to an .rds file containing accuracy metrics for the simple (unweighted) refinement, for comparison. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}, {"model_class": "ConditionalWhen", "value": "crop-and-mask-raster", "inputs": [{"model_class": "DataToolParameter", "name": "inputFile1_corineCLC_rds", "argument": null, "type": "data", "label": "CORINE CLC raster", "help": "Path to an .rds file containing the CORINE Land Cover raster (SpatRaster) to be cropped and masked. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile2_analysisExtent_gpkg", "argument": null, "type": "data", "label": "Analysis spatial extent", "help": "Path to a GeoPackage file containing the spatial extent geometry (e.g. catchment or country boundary) to crop and mask the raster to. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}]}, {"model_class": "ConditionalWhen", "value": "dasymetric-refinement", "inputs": [{"model_class": "SelectToolParameter", "name": "refinement_type", "argument": null, "type": "select", "label": "Refinement type", "help": "The dasymetric refinement strategy to use. 'weighted' distributes population across urban CORINE classes according to the weight table, and additionally treats raster cells whose building count exceeds the supplied threshold as populated when building footprints are supplied. 'simple' uses a binary distribution restricted to CORINE classes 111 and 112 only, with all weights set equal; building footprints and the building count threshold are ignored entirely in this mode.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "simple", "options": [["simple", "simple", false], ["weighted", "weighted", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "DataToolParameter", "name": "inputFile1_corineCLC_rds", "argument": null, "type": "data", "label": "CORINE CLC raster", "help": "Path to an .rds file containing the CORINE Land Cover raster (SpatRaster) used as ancillary data for the refinement. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile2_corineYear_rds", "argument": null, "type": "data", "label": "CORINE reference year", "help": "Path to an .rds file containing the CORINE CLC reference year as a single value. Only year 2018 is currently supported by this function. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile3_lauInCatchment_rds", "argument": null, "type": "data", "label": "LAU polygons in catchment", "help": "Path to an .rds file containing LAU (Local Administrative Unit) polygons within the catchment, with a 'LAU_ID' column and an observed population column for the focus year. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile4_popFocusYear_rds", "argument": null, "type": "data", "label": "Population focus year", "help": "Path to an .rds file containing the focus year for population data as a single value, used to select the LAU population column (e.g. 'POP_2018'). (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile5_catchment_gpkg", "argument": null, "type": "data", "label": "Catchment geometry", "help": "Path to a GeoPackage file containing the catchment boundary used to crop and mask the refinement output raster. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile6_weightTable_rds", "argument": null, "type": "data", "label": "Weight table", "help": "Path to an .rds file containing the dasymetric weighting table (CORINE class code, label, percent weight). Used as-is for 'weighted' refinement; for 'simple' refinement, only classes 111 and 112 are retained and all weights are set equal. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "DataToolParameter", "name": "inputFile7_buildings_rds", "argument": null, "type": "data", "label": "EUBUCCO building footprints (optional)", "help": "Path to an .rds file containing EUBUCCO building footprints (sf object) for the catchment, with a 'construction_year' column. Only buildings constructed in or before the focus year (or with unknown construction year) are used. Only read and used when refinement_type is 'weighted'; entirely ignored when refinement_type is 'simple'. If not supplied, the building-count step is skipped entirely and cells are determined by CORINE classes 111/112 alone. (URL must be stored in a .txt file)", "help_format": "html", "refresh_on_change": true, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["txt"], "edam": {"edam_formats": ["format_2330"], "edam_data": ["data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "IntegerToolParameter", "name": "inputFile8_buildingCountThreshold", "argument": null, "type": "integer", "label": "Building count threshold (optional)", "help": "Single number: raster cells with a building count exceeding this threshold are treated as populated (in addition to CORINE classes 111/112). Only applied when refinement_type is 'weighted' and inputFile7_buildings_rds is supplied; ignored when refinement_type is 'simple' or no buildings are supplied. Defaults to 1 if not supplied (only relevant when inputFile7_buildings_rds is provided).", "help_format": "html", "refresh_on_change": false, "min": 1, "max": 30, "optional": true, "hidden": false, "is_dynamic": false, "value": null, "area": false, "datalist": []}]}, {"model_class": "ConditionalWhen", "value": "data-intersect", "inputs": [{"model_class": "DataToolParameter", "name": "inputFile1_focus_rds", "argument": null, "type": "data", "label": "Focus dataset", "help": "Path to an .rds file containing the spatial dataset (sf object, e.g. LAU polygons or census grid) to be intersected with the analysis extent. (URL must be stored in a .txt file)", "help_format": "html",