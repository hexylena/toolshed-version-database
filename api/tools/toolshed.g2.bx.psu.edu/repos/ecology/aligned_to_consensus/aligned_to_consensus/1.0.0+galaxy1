{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/ecology/aligned_to_consensus/aligned_to_consensus/1.0.0+galaxy1", "name": "Consensus sequence from aligned FASTA", "version": "1.0.0+galaxy1", "description": "", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["1.0.0", "1.0.0+galaxy1"], "hidden_versions": [], "tool_shed_repository": {"name": "aligned_to_consensus", "owner": "ecology", "changeset_revision": "3d7fff9f7376", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input", "argument": null, "type": "data", "label": "Input fasta file with at least two sequences", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["fasta"], "edam": {"edam_formats": ["format_1929"], "edam_data": ["data_2044"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "seqtype", "argument": null, "type": "select", "label": "Type of sequence", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "DNA", "options": [["DNA", "DNA", true], ["RNA", "RNA", false], ["Amino Acid", "AA", false]], "display": "radio", "multiple": false, "textable": false}, {"model_class": "SelectToolParameter", "name": "method", "argument": null, "type": "select", "label": "Consensus method when differences are found between sequences", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "chr_ambiguity", "options": [["Use an ambiguous nucleotide", "chr_ambiguity", true], ["Use the most frequent nucleotide", "chr_majority", false]], "display": "radio", "multiple": false, "textable": false}, {"model_class": "BooleanToolParameter", "name": "gaps", "argument": null, "type": "boolean", "label": "Take account of gaps?", "help": "/!\\ If gaps are at the same place in all the sequences don't check 'no', you'll face an error", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}, {"model_class": "BooleanToolParameter", "name": "outog", "argument": null, "type": "boolean", "label": "Output consensus sequence AND original sequences in the FASTA file?", "help": "/!\\ If gaps are at the same place in all the sequences don't check 'no', you'll face an error", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "fasta", "label": "Consensus sequence of ${input.display_name}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "output.fasta", "edam_format": "format_1929", "edam_data": "data_2044", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "assembly", "panel_section_name": "Assembly", "form_style": "regular"}