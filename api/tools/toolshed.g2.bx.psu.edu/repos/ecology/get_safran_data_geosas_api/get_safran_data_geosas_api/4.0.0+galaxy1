{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/ecology/get_safran_data_geosas_api/get_safran_data_geosas_api/4.0.0+galaxy1", "name": "SAFRAN Climate Data Extractor", "version": "4.0.0+galaxy1", "description": "Download SAFRAN daily climate reanalysis data from the GEOSAS OGC-EDR API (France, 1958\u2013present)", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["4.0.0+galaxy1"], "hidden_versions": [], "tool_shed_repository": {"name": "get_safran_data_geosas_api", "owner": "ecology", "changeset_revision": "92a40b2a4388", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "SelectToolParameter", "name": "climate_parameters", "argument": null, "type": "select", "label": "Climate variables to download", "help": "Select one or more SAFRAN daily variables. The list is fetched live                      from the G\u00e9oSAS API \u2014 it reflects the variables actually available                      at query time. Hold Ctrl (Windows/Linux) or Cmd (macOS) to select                      multiple items.", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": true, "value": null, "options": [["DLI_Q \u2014 Rayonnement atmosph\u00e9rique (cumul quotidien)", "DLI_Q", false], ["DRAINC_Q \u2014 Drainage (cumul quotidien 06-06 UTC)", "DRAINC_Q", false], ["ETP_Q \u2014 Evapotranspiration potentielle (formule de Penman-Monteith)", "ETP_Q", false], ["FF_Q \u2014 Vent (moyenne quotidienne)", "FF_Q", false], ["HU_Q \u2014 Humidit\u00e9 relative (moyenne quotidienne)", "HU_Q", false], ["PRELIQ_Q \u2014 Pr\u00e9cipitations liquides (cumul quotidien 06-06 UTC)", "PRELIQ_Q", false], ["PRENEI_Q \u2014 Pr\u00e9cipitations solide (cumul quotidien 06-06 UTC)", "PRENEI_Q", false], ["RESR_NEIGE_Q \u2014 Equivalent en eau du manteau neigeux (moyenne quotidienne)", "RESR_NEIGE_Q", false], ["RUNC_Q \u2014 Ruissellement (cumul quotidien)", "RUNC_Q", false], ["SSI_Q \u2014 Rayonnement visible (cumul quotidien)", "SSI_Q", false], ["SWI_Q \u2014 Indice d'humidit\u00e9 des sols (moyenne quotidienne 06-06 UTC)", "SWI_Q", false], ["TINF_H_Q \u2014 Temp\u00e9rature minimale des 24 temp\u00e9ratures horaires", "TINF_H_Q", false], ["TSUP_H_Q \u2014 Temp\u00e9rature maximale des 24 temp\u00e9ratures horaires", "TSUP_H_Q", false], ["T_Q \u2014 Temp\u00e9rature (moyenne quotidienne)", "T_Q", false]], "display": null, "multiple": true, "textable": false}, {"model_class": "Section", "name": "date_range", "type": "section", "title": "Date range", "help": null, "expanded": true, "inputs": [{"model_class": "TextToolParameter", "name": "start_date", "argument": null, "type": "text", "label": "Start date (YYYY-MM-DD)", "help": "First day of the extraction period.                          Cannot be before 1958-08-01 (oldest SAFRAN record).                          Leave blank only if the coordinate file already contains                          a 'begin_date' column; otherwise required.                          Default fallback: 1960-01-01.                          Format is validated by the tool (YYYY-MM-DD required).", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}, {"model_class": "TextToolParameter", "name": "end_date", "argument": null, "type": "text", "label": "End date (YYYY-MM-DD)", "help": "Last day of the extraction period (inclusive).                          SAFRAN is updated monthly; data up to near-present is available.                          Leave blank only if the coordinate file already contains                          an 'end_date' column; otherwise required.                          Default fallback: 2020-12-31.                          Format is validated by the tool (YYYY-MM-DD required).", "help_format": "html", "refresh_on_change": false, "optional": true, "hidden": false, "is_dynamic": false, "value": "", "area": false, "datalist": []}]}, {"model_class": "DataToolParameter", "name": "coord_file", "argument": null, "type": "data", "label": "Coordinate / geometry file", "help": "File describing the location(s) to query (CSV, TSV, Excel, Shapefile, or GeoJSON). Geometry type and required columns are detected automatically \u2014 see the help below for details.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["csv", "tabular", "xlsx", "shp", "geojson"], "edam": {"edam_formats": ["format_3475", "format_3475", "format_2333", "format_2333", "format_3464"], "edam_data": ["data_0006", "data_0006", "data_0006", "data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "IntegerToolParameter", "name": "epsg", "argument": null, "type": "integer", "label": "EPSG code of the coordinates", "help": "Coordinate reference system of the input geometries.                      Check the help section for more information                      If unsure, use 4326 and provide decimal-degree coordinates.", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "4326", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "output_format", "argument": null, "type": "select", "label": "Output file format", "help": "Format of the downloaded climate data.                       CSV          \u2014 Tabular; easy to open in R, Python, or Excel.                      CoverageJSON \u2014 OGC CoverageJSON with spatial metadata.                      netCDF4      \u2014 Gridded format. Recommended for polygon / large queries.                      parquet      \u2014 Columnar binary. Only for POINT / LINESTRING inputs.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "CSV", "options": [["CSV (.csv)", "CSV", true], ["CoverageJSON (.json)", "CoverageJSON", false], ["NetCDF-4 (.nc)", "netCDF4", false], ["Parquet (.parquet) \u2014 /position only", "parquet", false]], "display": null, "multiple": false, "textable": false}], "outputs": [{"model_class": "ToolOutput", "name": "output", "format": "csv", "label": "SAFRAN ${output_format} on ${on_string}", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": null, "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}], "has_parameters": true, "panel_section_id": "get_data", "panel_section_name": "Get Data", "form_style": "regular"}