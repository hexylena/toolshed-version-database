{"model_class": "Tool", "id": "toolshed.g2.bx.psu.edu/repos/ecology/lea_snmf_application/LEA_snmf_application/0.1.0", "name": "Genetic Clustering", "version": "0.1.0", "description": "with LEA (sNMF) for VCF or SSR data", "labels": [], "icon": null, "edam_operations": [], "edam_topics": [], "hidden": "", "is_workflow_compatible": true, "xrefs": [], "versions": ["0.1.0"], "hidden_versions": [], "tool_shed_repository": {"name": "lea_snmf_application", "owner": "ecology", "changeset_revision": "8dadc1127183", "tool_shed": "toolshed.g2.bx.psu.edu"}, "inputs": [{"model_class": "DataToolParameter", "name": "input_data", "argument": null, "type": "data", "label": "Upload your genetic data", "help": "File containing SNP data in VCF format or SSR/microsatellite data in tabular format (see help section).", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": null, "extensions": ["vcf", "tabular"], "edam": {"edam_formats": ["format_3016", "format_3475"], "edam_data": ["data_0006", "data_0006"]}, "multiple": false, "tag": null, "options": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "pinned": {"dce": [], "ldda": [], "hda": [], "hdca": []}, "options_meta": {}}, {"model_class": "SelectToolParameter", "name": "input_format", "argument": null, "type": "select", "label": "Select your data format", "help": "", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": "VCF", "options": [["VCF", "VCF", false], ["SSR", "SSR", false]], "display": null, "multiple": false, "textable": false}, {"model_class": "IntegerToolParameter", "name": "repetitions", "argument": null, "type": "integer", "label": "Number of repetitions for each value of K", "help": "", "help_format": "html", "refresh_on_change": false, "min": 1, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "10", "area": false, "datalist": []}, {"model_class": "FloatToolParameter",