ters is not significant,                              K is decremented by 1 and re-tested. Only pure individuals                              (ancestry proportion >= 80%) are used for this test.                              Warning: this step can be slow on large datasets.", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": false, "truevalue": "true", "falsevalue": "false"}]}], "test_param": {"model_class": "SelectToolParameter", "name": "k_mode_sel", "argument": null, "type": "select", "label": "K (number of clusters) setting", "help": "", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "fixed", "options": [["Fixed K", "fixed", false], ["Automatic detection (Cross-entropy)", "auto", false]], "display": null, "multiple": false, "textable": false}}], "outputs": [{"model_class": "ToolOutput", "name": "output_table", "format": "tabular", "label": "sNMF Population Assignments", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "outputs/results_snmf.txt", "edam_format": "format_3475", "edam_data": "data_0006", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "cross_entropy", "format": "png", "label": "Cross-entropy", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "outputs/cross-entropy.png", "edam_format": "format_3603", "edam_data": "data_2968", "discover_datasets": []}, {"model_class": "ToolOutput", "name": "barplot", "format": "png", "label": "Barplot", "hidden": false, "output_type": "data", "format_source": null, "default_identifier_source": "None", "metadata_source": null, "parent": null, "count": 1, "from_work_dir": "outputs/barplot_t_struc.png", "edam_format": "format_3603", "e