ers can be found in the help section.", "help_format": "html", "refresh_on_change": true, "optional": false, "hidden": false, "is_dynamic": false, "value": "mafft --auto", "options": [["auto", "mafft --auto", true], ["fftns", "mafft-fftns", false], ["fftnsi", "mafft-fftnsi", false], ["nwns", "mafft-nwns", false], ["nwnsi", "mafft-nwnsi", false], ["einsi", "mafft-einsi", false], ["ginsi", "mafft-ginsi", false], ["linsi", "mafft-linsi", false], ["qinsi", "mafft-qinsi", false], ["xinsi", "mafft-xinsi", false], ["Custom Parameters", "custom", false]], "display": null, "multiple": false, "textable": false}}, {"model_class": "FloatToolParameter", "name": "ep", "argument": "--ep", "type": "float", "label": "Gap extend penalty", "help": "Offset value, which works like gap extension penalty,    for group-to-group alignment. For E-INS-i, 0 is recommended    to allow large gaps", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "0.123", "area": false, "datalist": []}, {"model_class": "FloatToolParameter", "name": "op", "argument": "--op", "type": "float", "label": "Gap opening penalty", "help": "1.53 default value", "help_format": "html", "refresh_on_change": false, "min": null, "max": null, "optional": false, "hidden": false, "is_dynamic": false, "value": "1.53", "area": false, "datalist": []}, {"model_class": "SelectToolParameter", "name": "adjustdirection", "argument": "--adjustdirection", "type": "select", "label": "Direction of nucleotide sequences", "help": "Generate reverse complement sequences,    as necessary, and align them together with the remaining sequences", "help_format": "html", "refresh_on_change": false, "optional": false, "hidden": false, "is_dynamic": false, "value": " ", "options": [["adjust direction", "--adjustdirection", false], ["do not adjust direction", " ", true]], "display": "radio", "multiple": false, "textable": false}, {"model_class": "Conditional", "n